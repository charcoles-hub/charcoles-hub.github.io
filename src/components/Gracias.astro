---
import { contenido, rutas, type Lang } from '../config/site';
import { COMUN, whatsapp } from '../config/comun';
import Cabecera from './Cabecera.astro';
import Pie from './Pie.astro';
import Whatsapp from './iconos/Whatsapp.astro';

interface Props {
  lang: Lang;
  /** Por defecto, los textos de «reseña recibida» del idioma. */
  titular?: string;
  texto?: string;
  volver?: string;
}
const { lang } = Astro.props;
const g = contenido[lang].gracias;
const t = COMUN[lang];
const titular = Astro.props.titular ?? g.titular;
const texto = Astro.props.texto ?? g.texto;
const volver = Astro.props.volver ?? g.volver;
---

<Cabecera lang={lang} nav={[]} cta={{ texto: t.whatsapp, href: whatsapp(t.waTexto) }} />

<main id="contenido" class="gracias wrap">
  <span class="gracias__marca entra" aria-hidden="true"><span class="icono icono--check"></span></span>
  <h1 class="titulo-xl entra" style="--orden:1">{titular}</h1>
  <p class="entradilla entra" style="--orden:2">{texto}</p>
  <div class="gracias__acciones entra" style="--orden:3">
    <a class="boton boton--oscuro" href={rutas[lang]}>{volver}<span class="icono" aria-hidden="true"></span></a>
    <a class="boton boton--borde" href={whatsapp(t.waTexto)}><Whatsapp />{t.whatsapp}</a>
  </div>
</main>

<Pie lang={lang} />

<style>
  .gracias { display: grid; justify-items: start; align-content: center; gap: 26px; min-height: 70vh; padding-block: 96px; }
  .gracias h1 { max-width: 12em; font-size: clamp(2.8rem, 1.4rem + 4.4vw, 5.4rem); }
  .gracias__marca { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--lima); color: var(--tinta); }
  .gracias__marca .icono { width: 28px; height: 28px; }
  .gracias__acciones { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
