---
import Layout from '../layouts/Layout.astro';
import Gracias from '../components/Gracias.astro';
---
<Layout lang="es" titulo="Web recibida · Sergio García" descripcion="He recibido tu web para la revisión gratuita." paginas={{ es: '/gracias-revision/' }} noindex>
  <Gracias
    lang="es"
    titular="Recibida. Me pongo con tu web."
    texto="Te escribo en un máximo de 48 horas laborables al email que me has dejado, con lo que funciona, lo que falla y qué cambiaría primero. Si te corre prisa, escríbeme por WhatsApp."
    volver="Volver a la portada"
  />
</Layout>
