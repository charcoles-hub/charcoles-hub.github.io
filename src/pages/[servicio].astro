---
import { SERVICIOS, type Servicio } from '../config/servicios';
import { contenido } from '../config/site';
import Layout from '../layouts/Layout.astro';
import PaginaLarga from '../components/PaginaLarga.astro';
import PaginaDecision from '../components/PaginaDecision.astro';

export function getStaticPaths() {
  return SERVICIOS.map((s) => ({ params: { servicio: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servicio };
const { site } = contenido.es;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const servicioLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.nombre,
  description: s.descripcion,
  serviceType: s.nombre,
  provider: { '@type': 'ProfessionalService', name: site.nombre, telephone: '+34620650597' },
  areaServed: { '@type': 'Country', name: 'España' },
  url: new URL(`/${s.slug}/`, Astro.site).href,
};
---
<Layout
  lang="es"
  titulo={s.titulo}
  descripcion={s.descripcion}
  paginas={{ es: `/${s.slug}/` }}
  datos={[servicioLd, faqLd]}
>
  {s.decision ? <PaginaDecision s={s} /> : <PaginaLarga s={s} />}
</Layout>

