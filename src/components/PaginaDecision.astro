---
import { Image } from 'astro:assets';
import type { Servicio } from '../config/servicios';
import { whatsapp } from '../config/comun';
import { poster } from '../config/posters';
import Cabecera from './Cabecera.astro';
import Migas from './Migas.astro';
import Preguntas from './Preguntas.astro';
import Relacionados from './Relacionados.astro';
import Contacto from './Contacto.astro';
import Pie from './Pie.astro';
import BarraMovil from './BarraMovil.astro';
import Whatsapp from './iconos/Whatsapp.astro';

interface Props {
  s: Servicio;
  migas: { nombre: string; url: string }[];
}
const { s, migas } = Astro.props;
if (!s.decision) throw new Error('PaginaDecision necesita un servicio con decision');
const { decision } = s;
const waTexto = `Hola Sergio, me gustaría hablar contigo sobre ${s.nombre.toLowerCase()}.`;
const wa = whatsapp(waTexto);
// La captura de cada ejemplo sale del slug de su URL (o de Fisioymés, el caso real).
const captura = (href: string) => (href.includes('fisioymes') ? 'fisioymes-full' : href.split('/').filter(Boolean).pop()!);
const nav = [
  { texto: 'Trabajo', href: '/#trabajo' },
  { texto: 'Servicios', href: '/#servicios' },
  { texto: 'Sectores', href: '/#sectores' },
  { texto: 'Revisión gratis', href: '/revision-web-gratis/' },
];
---

<Cabecera lang="es" nav={nav} />

<main id="contenido">
  <section class="intro wrap" aria-labelledby="titulo-pagina">
    <Migas migas={migas} />
    <div class="intro__rejilla">
      <div>
        <p class="etiqueta etiqueta--linea entra">{s.nombre} · Toda España</p>
        <h1 id="titulo-pagina" class="titulo-xl entra" style="--orden:1">{s.h1}</h1>
        <p class="entradilla entra" style="--orden:2">{s.bajada}</p>
        <div class="intro__acciones entra" style="--orden:3">
          <a class="boton boton--oscuro" href={wa}><Whatsapp />Cuéntame tu proyecto</a>
          <a class="boton boton--borde" href="#encaja">Ver si encaja<span class="icono icono--abajo" aria-hidden="true"></span></a>
        </div>
      </div>
      <aside class="nota nota--oscura entra" style="--orden:2" aria-label="Cómo elegir este servicio">
        <span class="nota__etiqueta">Una decisión sencilla</span>
        <p class="nota__texto">{decision.pregunta}</p>
        <div class="nota__pie"><a href="#encaja">Compruébalo en un minuto</a><span class="icono icono--abajo" aria-hidden="true"></span></div>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--tinte" id="encaja" aria-labelledby="titulo-encaja">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">Puede encajarte si…</p>
        <h2 id="titulo-encaja" class="titulo-l">Partes de <em>aquí</em>.</h2>
      </div>
      <ol class="lista-num">{decision.senales.map((senal, i) => <li data-revela><span>0{i + 1}</span><p>{senal}</p></li>)}</ol>
    </div>
  </section>

  <section class="seccion" id="incluye" aria-labelledby="titulo-incluye">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">El alcance</p>
        <h2 id="titulo-incluye" class="titulo-l">Qué <em>incluye</em>.</h2>
        <p>Lo que necesites se concreta antes de empezar y queda reflejado en la propuesta.</p>
      </div>
      <ul class="lista-check incluye">{s.incluye.map((item) => <li data-revela><span class="icono icono--check" aria-hidden="true"></span>{item}</li>)}</ul>
    </div>
  </section>

  <section class="seccion seccion--oscura" aria-labelledby="titulo-proceso">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">Así lo hacemos</p>
        <h2 id="titulo-proceso" class="titulo-l">Tres pasos, <em>sin humo</em>.</h2>
      </div>
      <ol class="pasos">
        {decision.proceso.map((paso, i) => (
          <li data-revela><span class="pasos__num" aria-hidden="true">{i + 1}</span><div><h3 class="subtitulo">{paso.titulo}</h3><p>{paso.texto}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="seccion seccion--tinte" aria-labelledby="titulo-ejemplos">
    <div class="wrap">
      <div class="cabeza" data-revela>
        <div>
          <p class="etiqueta etiqueta--linea">Para que te hagas una idea</p>
          <h2 id="titulo-ejemplos" class="titulo-l">Ejemplos que puedes <em>explorar</em>.</h2>
        </div>
        <p>Un proyecto real y un concepto de diseño. Los conceptos son propuestas propias, no encargos de clientes.</p>
      </div>
      <ul class="ejemplos">
        {decision.ejemplos.map((ejemplo) => (
          <li data-revela>
            <a class="ejemplo" href={ejemplo.href} target={ejemplo.externo ? '_blank' : undefined} rel={ejemplo.externo ? 'noopener' : undefined}>
              <div class="marco">
                <div class="marco__barra" aria-hidden="true"><i></i><i></i><i></i></div>
                <Image src={poster(captura(ejemplo.href))} width={880} height={560} fit="cover" position="top" format="webp" quality={78} widths={[440, 880]} sizes="(min-width: 760px) 44vw, 92vw" alt={`Vista previa de ${ejemplo.nombre}`} loading="lazy" />
              </div>
              <p class="ejemplo__tipo">{ejemplo.tipo}</p>
              <h3 class="ejemplo__nombre">{ejemplo.nombre}<span class="icono" aria-hidden="true"></span></h3>
              <p class="ejemplo__texto">{ejemplo.texto}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion" aria-label="Datos principales">
    <div class="wrap">
      <ul class="cifras">{s.datos.map((d) => <li data-revela><strong>{d.cifra}</strong><span>{d.texto}</span></li>)}</ul>
    </div>
  </section>

  <section class="seccion seccion--tinte" aria-labelledby="titulo-faq">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">Preguntas frecuentes</p>
        <h2 id="titulo-faq" class="titulo-l">Las dudas habituales, <em>respondidas</em>.</h2>
      </div>
      <Preguntas preguntas={s.faq} />
    </div>
  </section>

  <Relacionados actual={s.slug} />

  <Contacto lang="es" titulo="Hablemos de una web *a tu altura*." waTexto={waTexto} />
</main>

<Pie lang="es" />
<BarraMovil lang="es" waTexto={waTexto} />

<style>
  .incluye { font-size: 1.08rem; }
  .incluye li { padding-bottom: 14px; border-bottom: 1px solid var(--linea); }
  .pasos { display: grid; list-style: none; border-top: 1px solid var(--linea-oscura); }
  .pasos li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding-block: 26px; border-bottom: 1px solid var(--linea-oscura); }
  .pasos__num { font-family: var(--serif); font-size: 2.8rem; line-height: 1; color: var(--lima); }
  .pasos p { margin-top: 6px; color: var(--tenue-oscuro); }
  .ejemplos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; list-style: none; }
  .ejemplo { display: block; }
  .ejemplo .marco img { aspect-ratio: 880 / 560; object-fit: cover; object-position: top; transition: transform 0.9s var(--suave); }
  .ejemplo__tipo { margin-top: 20px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: var(--oliva); }
  .ejemplo__nombre { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 6px; font-family: var(--serif); font-size: 2rem; font-weight: 400; line-height: 1.1; }
  .ejemplo__texto { margin-top: 8px; color: var(--tenue); }
  @media (prefers-reduced-motion: no-preference) { .ejemplo:hover .marco img { transform: scale(1.03); } }
  @media (max-width: 760px) { .ejemplos { grid-template-columns: 1fr; } }
</style>
