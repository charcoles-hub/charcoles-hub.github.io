---
// SPIKE — no forma parte de la web real. No enlazado desde ningún sitio.
// Pregunta: ¿aguantan los iframes de las demos reales flotando en 3D vía
// CSS3DRenderer, siguen vivos (cargan, se scrollean por dentro) y se pueden
// mezclar con una capa WebGL?
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>spike galería 3d</title>
  <style>
    html, body { margin: 0; height: 400vh; background: #111; overflow-x: hidden; }
    #css3d-container { position: fixed; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
    #webgl { position: fixed; inset: 0; z-index: 1; }
    #hud {
      position: fixed; top: 0; left: 0; z-index: 10; color: #0f0; background: rgba(0,0,0,.75);
      font: 12px/1.4 monospace; padding: 8px 10px; white-space: pre; pointer-events: none;
    }
    iframe.demo3d { border: 0; background: #fff; }
  </style>
</head>
<body>
  <div id="css3d-container"></div>
  <canvas id="webgl"></canvas>
  <div id="hud">cargando…</div>

  <script type="module">
    import * as THREE from 'three';
    import { CSS3DRenderer, CSS3DObject } from 'three/addons/renderers/CSS3DRenderer.js';

    const hud = document.getElementById('hud');

    // --- Escena CSS3D (los iframes) ---
    const sceneCSS = new THREE.Scene();
    // --- Escena WebGL (partículas, para probar el mezclado) ---
    const sceneGL = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, 1, 10000);
    camera.position.set(0, 0, 1400);

    const cssRenderer = new CSS3DRenderer();
    cssRenderer.setSize(innerWidth, innerHeight);
    document.getElementById('css3d-container').appendChild(cssRenderer.domElement);

    const canvas = document.getElementById('webgl');
    const glRenderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    glRenderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    glRenderer.setSize(innerWidth, innerHeight);

    // --- Las 3 demos reales, en perspectiva ---
    // Mismo tamaño de iframe que PosterVivo (1440x900): las demos ya están
    // pensadas para ese viewport. Se escala hacia abajo con object.scale.
    const RUTAS = ['/demo-barberia-navaja/', '/demo-dental-sereno/', '/demo-psicologia-ancla/'];
    const COLOCACION = [
      { x: -650, y: 0,    z: 400,   ry: 0.5,  s: 0.42 },
      { x: 700,  y: 100,  z: -1400, ry: -0.6, s: 0.55 },
      { x: -400, y: -150, z: -3200, ry: 0.35, s: 0.5 },
    ];

    const iframes = [];
    const objetos = [];

    RUTAS.forEach((ruta, i) => {
      const c = COLOCACION[i];
      const iframe = document.createElement('iframe');
      iframe.className = 'demo3d';
      iframe.style.width = '1440px';
      iframe.style.height = '900px';
      // pointer-events:none — igual que PosterVivo: si no, el iframe se come
      // la rueda del ratón y el scroll de la PÁGINA (que es lo que mueve la
      // cámara) deja de funcionar en cuanto el puntero pasa por encima.
      iframe.style.pointerEvents = 'none';
      iframe.title = `demo ${i}`;
      iframe.addEventListener('load', () => {
        try {
          // Aprendizaje caro (spec, punto 3): las demos llevan
          // scroll-behavior:smooth y sin esto scrollTo() anima en vez de saltar.
          iframe.contentDocument.documentElement.style.scrollBehavior = 'auto';
        } catch { /* cross-origin: no debería pasar, ruta same-origin */ }
        iframe.dataset.cargado = 'si';
      });
      iframe.src = ruta;

      const obj = new CSS3DObject(iframe);
      obj.position.set(c.x, c.y, c.z);
      obj.rotation.y = c.ry;
      obj.scale.set(c.s, c.s, c.s);
      sceneCSS.add(obj);

      iframes.push(iframe);
      objetos.push(obj);
    });

    // --- Capa WebGL: partículas, para probar el mezclado con CSS3D ---
    // Un bloque de partículas colocado ENTRE la cámara y la segunda demo
    // (z=-1400): si el z-index gobierna (como debería), las partículas
    // pintan SIEMPRE por debajo del iframe aunque en 3D estén más cerca de
    // la cámara. Es la limitación conocida que el spike tiene que enseñar.
    const geo = new THREE.BufferGeometry();
    const N = 800;
    const pos = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      pos[i * 3] = (Math.random() - 0.5) * 1600;
      pos[i * 3 + 1] = (Math.random() - 0.5) * 1200;
      pos[i * 3 + 2] = -600 + (Math.random() - 0.5) * 400; // entre cámara (z=1400 bajando) y la demo 2 (z=-1400)
    }
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const mat = new THREE.PointsMaterial({ color: 0x66ffcc, size: 8, sizeAttenuation: true });
    const puntos = new THREE.Points(geo, mat);
    sceneGL.add(puntos);

    // Además una malla giratoria simple, delante de la primera demo (z=400),
    // en z=900 (más cerca de la cámara que la demo 1).
    const cubo = new THREE.Mesh(
      new THREE.TorusKnotGeometry(120, 30, 100, 16),
      new THREE.MeshNormalMaterial()
    );
    cubo.position.set(-650, 0, 900);
    sceneGL.add(cubo);
    sceneGL.add(new THREE.AmbientLight(0xffffff, 1));

    // --- Toggle de apilamiento: probar css3d por encima y por debajo del canvas ---
    let cssEncima = true;
    function aplicaApilamiento() {
      const cont = document.getElementById('css3d-container');
      cont.style.zIndex = cssEncima ? '2' : '0';
      canvas.style.zIndex = cssEncima ? '1' : '3';
    }
    aplicaApilamiento();
    window.__toggleStacking = () => { cssEncima = !cssEncima; aplicaApilamiento(); return cssEncima; };

    // --- Cámara gobernada por el scroll de la página ---
    // Recorrido simple: avanza en -Z a medida que se scrollea. Sin
    // suavizado, sin easing — el spike solo tiene que demostrar que la
    // cámara puede viajar entre pantallas.
    const Z_INICIO = 1400;
    const Z_FIN = -4200;
    function actualizaCamara() {
      const total = document.documentElement.scrollHeight - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, scrollY / total)) : 0;
      camera.position.z = Z_INICIO + (Z_FIN - Z_INICIO) * p;
      camera.lookAt(0, 0, camera.position.z - 1000);
      return p;
    }

    addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      cssRenderer.setSize(innerWidth, innerHeight);
      glRenderer.setSize(innerWidth, innerHeight);
    });

    // --- FPS real + bucle de render ---
    window.__fps = 0;
    let frames = 0;
    let ultimoMarcador = performance.now();
    let ultimoFrame = performance.now();
    window.__frameCount = 0;

    function loop() {
      requestAnimationFrame(loop);
      const ahora = performance.now();
      ultimoFrame = ahora;
      frames++;
      window.__frameCount++;
      if (ahora - ultimoMarcador >= 500) {
        window.__fps = Math.round((frames * 1000) / (ahora - ultimoMarcador));
        frames = 0;
        ultimoMarcador = ahora;
      }

      const p = actualizaCamara();
      puntos.rotation.y += 0.003;
      cubo.rotation.x += 0.01;
      cubo.rotation.y += 0.015;

      glRenderer.render(sceneGL, camera);
      cssRenderer.render(sceneCSS, camera);

      hud.textContent =
        `FPS: ${window.__fps}\n` +
        `scroll progress: ${p.toFixed(2)}\n` +
        `camera.z: ${camera.position.z.toFixed(0)}\n` +
        `css3d encima del webgl: ${cssEncima}\n` +
        `demos cargadas: ${iframes.map((f) => f.dataset.cargado === 'si' ? '1' : '0').join(',')}`;
    }
    loop();

    // API para el script de verificación con puppeteer.
    window.__spike = {
      getScrollY: (i) => { try { return iframes[i].contentWindow.scrollY; } catch { return null; } },
      scrollDemoTo: (i, y) => { try { iframes[i].contentWindow.scrollTo(0, y); return true; } catch { return false; } },
      demosLoaded: () => iframes.every((f) => f.dataset.cargado === 'si'),
      toggleStacking: () => window.__toggleStacking(),
      setScroll: (y) => { scrollTo(0, y); },
    };
  </script>
</body>
</html>
