---
import { Image } from 'astro:assets';
import { contenido, type Lang } from '../config/site';
import captura from '../assets/posters/fisioymes-full.png';

const { lang } = Astro.props as { lang: Lang };
const { destacado: p, trabajo: txt } = contenido[lang];

// EL efecto de la página — y solo hay uno. La web del cliente, capturada a
// página completa, se recorre dentro del marco al ritmo del scroll. Es CSS
// puro (view-timeline en .proyecto): sin JS, sin iframe, sin cross-origin.
// OJO: /fisioymes/ redirige 301 a fisioymes.com, así que un iframe aquí sería
// cross-origin y no se podría scrollear desde fuera — por eso la captura.
// El marco enseña una ventana de 1440×900 de la captura; el resto es recorrido.
const VENTANA = 900;
const fin = -(100 * (1 - VENTANA / p.alto)).toFixed(2);
// Cuánto scroll pide la sección: el recorrido de la captura a razón de ~3px
// de captura por px de scroll, más la pantalla fija.
const altoSeccion = Math.round(100 + ((p.alto - VENTANA) / VENTANA) * 100 / 3);
---
<div class="proyecto" style={`--alto-seccion:${altoSeccion}vh; --fin:${fin}%`} data-proyecto>
  <div class="proyecto__fijo px-6 md:px-12">
    <div class="flex flex-col gap-4">
      <h2 class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-tenue">{txt.titular}</h2>
      {/* El cliente real se distingue a simple vista: chapa rellena. Si se viera
          igual que los conceptos, la única prueba de trabajo pagado se perdería. */}
      <p class="flex items-center gap-2 text-[0.62rem] font-semibold uppercase tracking-[0.16em]">
        <span class="rounded-full bg-acento px-2 py-1 text-fondo">{txt.cliente}</span>
        <span class="numero" aria-hidden="true">01</span>
      </p>
      <h3 class="font-display text-5xl font-extrabold tracking-[-0.04em] md:text-6xl" style="font-stretch:110%">
        {p.nombre}
      </h3>
      <p class="text-sm uppercase tracking-[0.1em] text-tenue">{p.rubro}</p>
      <p class="max-w-[44ch] text-balance text-medio">{p.descripcion}</p>

      <p class="max-w-[44ch] border-t border-linea pt-4 text-xs leading-relaxed text-tenue">
        {txt.clienteNota}
      </p>

      <a href={p.url} target="_blank" rel="noopener"
        class="mt-2 w-fit rounded-full bg-tinta px-4 py-2.5 text-xs font-semibold text-fondo
               transition-transform hover:-translate-y-0.5">
        {txt.abrir}
      </a>

      <div class="barra-pista mt-2 h-0.5 overflow-hidden rounded-full bg-linea">
        <i class="barra block h-full w-full bg-acento"></i>
      </div>
    </div>

    <div class="marco">
      <Image
        class="marco__scroll"
        src={captura}
        alt={`${p.nombre} — ${p.rubro}`}
        widths={[480, 960, 1440]}
        sizes="(min-width: 820px) 55vw, 100vw"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</div>
