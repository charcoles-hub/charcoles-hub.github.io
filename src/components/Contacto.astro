---
import { contenido, TELEFONO, type Lang } from '../config/site';
import { COMUN, enfasis, whatsapp } from '../config/comun';
import Whatsapp from './iconos/Whatsapp.astro';

interface Props {
  lang: Lang;
  /** Titular con el énfasis entre asteriscos. */
  titulo?: string;
  texto?: string;
  waTexto?: string;
  /** Enlace a la revisión gratuita. Por defecto, en castellano y catalán. */
  revision?: boolean;
  id?: string;
}
const { lang, id = 'contacto' } = Astro.props;
const t = COMUN[lang];
const titulo = Astro.props.titulo ?? t.contacto.titulo;
const texto = Astro.props.texto ?? t.contacto.texto;
const wa = whatsapp(Astro.props.waTexto ?? t.waTexto);
const revision = (Astro.props.revision ?? lang !== 'en') && t.contacto.revision !== '';
const email = contenido[lang].site.email;
---

<section class="seccion seccion--oscura contacto" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="wrap">
    <div class="contacto__rejilla">
      <div>
        <p class="etiqueta etiqueta--linea">{t.contacto.etiqueta}</p>
        <h2 class="titulo-xl" id={`${id}-titulo`} set:html={enfasis(titulo)} />
      </div>
      <div class="contacto__acciones">
        <p class="entradilla">{texto}</p>
        <a class="boton boton--lima boton--ancho" href={wa}><Whatsapp />{t.contacto.whatsapp}</a>
        <div class="contacto__otras">
          <a href={`mailto:${email}`}><span>{t.contacto.email}<small>{email}</small></span><span class="icono" aria-hidden="true"></span></a>
          <a href={TELEFONO.tel}><span>{t.contacto.llamar}<small>{TELEFONO.humano}</small></span><span class="icono" aria-hidden="true"></span></a>
          {revision && (
            <a href="/revision-web-gratis/" hreflang={lang === 'es' ? undefined : 'es'}>
              <span>{t.contacto.revision}<small>{t.contacto.revisionTexto}</small></span><span class="icono" aria-hidden="true"></span>
            </a>
          )}
        </div>
        <p class="contacto__nota">{t.contacto.nota}</p>
      </div>
    </div>
  </div>
</section>
