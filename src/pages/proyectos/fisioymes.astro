---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import captura from '../../assets/posters/fisioymes-full.png';

const problemas = [
  'La página era demasiado larga y costaba llegar a la información importante y al siguiente paso para pedir cita.',
  'No estaba adaptada al móvil.',
  'Tardaba en cargar.',
  'El diseño había quedado anticuado.',
];

const decisiones = [
  {
    titulo: 'Ordenar el contenido',
    texto: 'Organicé las lesiones en una rejilla y los tratamientos en fichas para que cada persona pueda explorar lo que necesita.',
  },
  {
    titulo: 'Pensar primero en el móvil',
    texto: 'Replanteé la presentación para que el contenido y el acceso a la cita funcionen también en pantallas pequeñas.',
  },
  {
    titulo: 'Conservar lo que ya funcionaba',
    texto: 'La web está en catalán y castellano y mantiene el sistema de reservas que la clínica ya utilizaba.',
  },
];
---

<Layout
  lang="es"
  titulo="Rediseño web de Fisioymés, clínica de fisioterapia — Sergio García"
  descripcion="Cómo reorganicé la web de Fisioymés para facilitar la consulta en móvil y el acceso a la cita, manteniendo sus reservas y sus dos idiomas."
  paginas={{ es: '/proyectos/fisioymes/' }}
>
  <div class="case-study" id="arriba">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="wrap masthead">
      <a class="identity" href="/" aria-label="Volver a la página principal de Sergio García">Sergio García<span aria-hidden="true">↗</span></a>
      <a class="back" href="/#trabajo">Volver a proyectos <span aria-hidden="true">↗</span></a>
    </header>

    <article id="contenido">
      <section class="hero wrap" aria-labelledby="case-title">
        <p class="eyebrow">Proyecto real · Fisioterapia · Sant Cugat del Vallès</p>
        <h1 id="case-title">Fisioymés: encontrar lo importante sin recorrer toda la web.</h1>
        <p class="lead">Rediseñé la web de la clínica para que sus pacientes puedan consultar lesiones y tratamientos desde el móvil y llegar con claridad a la reserva de cita.</p>
        <div class="hero-actions">
          <a class="button" href="https://fisioymes.com/" target="_blank" rel="noopener">Ver la web publicada <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#punto-de-partida">Leer el caso <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="visual" aria-labelledby="visual-title">
        <div class="wrap visual-inner">
          <div class="visual-copy">
            <p class="eyebrow">La web publicada</p>
            <h2 id="visual-title">Una estructura que se puede explorar.</h2>
            <p>La captura muestra la versión actual. La web anterior ya no está disponible.</p>
          </div>
          <div class="browser-frame">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>fisioymes.com</span></div>
            <Image
              src={captura}
              width={960}
              height={1500}
              fit="cover"
              position="top"
              format="webp"
              alt="Captura de la web actual de Fisioymés con sus secciones de lesiones y tratamientos"
              loading="eager"
            />
          </div>
        </div>
      </section>

      <section class="section wrap two-column" id="punto-de-partida" aria-labelledby="before-title">
        <div><p class="eyebrow">El punto de partida</p><h2 id="before-title">Lo que dificultaba el recorrido.</h2></div>
        <ol class="numbered-list">{problemas.map((problema, i) => <li><span>0{i + 1}</span><p>{problema}</p></li>)}</ol>
      </section>

      <section class="section decisions" aria-labelledby="decisions-title">
        <div class="wrap two-column">
          <div><p class="eyebrow">El rediseño</p><h2 id="decisions-title">Decisiones para hacerlo más claro.</h2></div>
          <ol class="numbered-list">{decisiones.map((decision, i) => <li><span>0{i + 1}</span><div><h3>{decision.titulo}</h3><p>{decision.texto}</p></div></li>)}</ol>
        </div>
      </section>

      <section class="section wrap outcome" aria-labelledby="outcome-title">
        <p class="eyebrow">Lo que puedes comprobar</p>
        <h2 id="outcome-title">Una visita con menos obstáculos.</h2>
        <p>En la web publicada puedes recorrer las lesiones y los tratamientos, cambiar de idioma y acceder al sistema de reservas de la clínica. No presento una cifra de mejora de velocidad o de conversiones porque no hay una medición comparable de la web anterior.</p>
        <a class="text-link" href="https://fisioymes.com/" target="_blank" rel="noopener">Explorar Fisioymés <span aria-hidden="true">↗</span></a>
      </section>

      <section class="contact" aria-labelledby="contact-title">
        <div class="wrap contact-inner">
          <div><p class="eyebrow">Tu próximo paso</p><h2 id="contact-title">¿Tu web también hace buscar demasiado?</h2></div>
          <div><p>Podemos revisar qué dificulta el recorrido y qué conviene conservar de tu web actual.</p><a class="button button-light" href="/rediseno-web/">Ver cómo trabajo un rediseño <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </article>

    <footer class="wrap footer"><a href="/">Sergio García</a><a href="/#trabajo">Más proyectos <span aria-hidden="true">↗</span></a></footer>
  </div>
</Layout>

<style>
  .case-study { --paper:#f7f7f0; --ink:#1c2c2b; --muted:#596361; --line:#d5dbcf; --lime:#d6f16b; background:var(--paper); color:var(--ink); font-family:'Manrope','Inter',ui-sans-serif,system-ui,sans-serif; font-size:16px; line-height:1.6; }
  .case-study * { box-sizing:border-box; }
  .case-study :global(a:focus-visible) { outline:3px solid #698322; outline-offset:5px; }
  .wrap { width:min(1180px,calc(100% - 96px)); margin-inline:auto; }
  .skip { position:absolute; top:-100px; left:20px; padding:14px 20px; background:var(--ink); color:var(--paper); z-index:10; }
  .skip:focus { top:12px; }
  .masthead { display:flex; align-items:center; justify-content:space-between; gap:24px; min-height:92px; border-bottom:1px solid var(--line); }
  .identity { font-size:16px; font-weight:800; letter-spacing:-.04em; }
  .identity span,.back span,.text-link span,.button span { margin-left:8px; font-size:20px; font-weight:400; }
  .back,.text-link { font-size:12px; font-weight:750; }
  .back:hover,.text-link:hover { text-decoration:underline; text-underline-offset:5px; }
  .eyebrow { margin:0 0 22px; color:#536047; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .hero { padding-block:95px 105px; }
  h1,h2,h3,p { margin:0; }
  h1 { max-width:1000px; font-size:clamp(48px,6.6vw,88px); font-weight:750; letter-spacing:-.065em; line-height:1.02; text-wrap:balance; }
  h2 { max-width:620px; font-size:clamp(36px,4.4vw,58px); font-weight:700; letter-spacing:-.055em; line-height:1.08; text-wrap:balance; }
  .lead { max-width:720px; margin-top:32px; color:var(--muted); font-size:clamp(17px,2vw,21px); line-height:1.6; }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:30px; margin-top:34px; }
  .button { display:inline-flex; align-items:center; justify-content:space-between; gap:20px; min-height:52px; padding:14px 20px; border-radius:6px; background:var(--ink); color:var(--paper); font-size:12px; font-weight:750; }
  .button:hover { background:#33433d; }
  .visual { overflow:hidden; background:#dce2d4; }
  .visual-inner { display:grid; grid-template-columns:.7fr 1.3fr; gap:70px; align-items:start; padding-top:70px; }
  .visual-copy { padding-top:24px; }
  .visual-copy p:last-child { max-width:38ch; margin-top:24px; color:var(--muted); font-size:14px; }
  .browser-frame { overflow:hidden; max-height:700px; border:1px solid #aab9a4; border-bottom:0; border-radius:10px 10px 0 0; background:#fff; box-shadow:0 30px 75px -35px #435b4e; }
  .browser-bar { display:flex; align-items:center; gap:6px; height:30px; padding-inline:14px; border-bottom:1px solid #e3e8e2; }
  .browser-bar i { width:7px; height:7px; border-radius:50%; background:#ccd8d0; }
  .browser-bar span { margin-left:auto; color:#65726b; font-size:10px; }
  .browser-frame :global(img) { display:block; width:100%; height:auto; }
  .section { padding-block:110px; }
  .two-column { display:grid; grid-template-columns:.85fr 1.15fr; gap:80px; }
  .numbered-list { margin:0; padding:0; list-style:none; border-top:1px solid var(--line); }
  .numbered-list li { display:grid; grid-template-columns:45px 1fr; gap:18px; padding:25px 0; border-bottom:1px solid var(--line); }
  .numbered-list li > span { padding-top:5px; color:#6f805c; font-size:11px; font-weight:800; }
  .numbered-list p { max-width:62ch; color:var(--muted); line-height:1.7; }
  .numbered-list h3 { margin-bottom:7px; font-size:20px; letter-spacing:-.03em; }
  .decisions { background:#e6e9de; }
  .outcome { max-width:900px; }
  .outcome > p:not(.eyebrow) { max-width:70ch; margin-top:26px; color:var(--muted); line-height:1.8; }
  .outcome .text-link { display:inline-block; margin-top:24px; }
  .contact { padding-block:90px; background:var(--ink); color:var(--paper); }
  .contact-inner { display:grid; grid-template-columns:1fr 1fr; gap:80px; }
  .contact .eyebrow { color:var(--lime); }
  .contact-inner > div:last-child { align-self:end; }
  .contact-inner > div:last-child p { max-width:45ch; color:#c4ccc4; }
  .button-light { margin-top:26px; background:var(--lime); color:var(--ink); }
  .button-light:hover { background:#e3ff89; }
  .footer { display:flex; justify-content:space-between; gap:24px; padding-block:40px; font-size:12px; font-weight:750; }
  @media (max-width:800px) { .wrap { width:min(100% - 40px,1180px); } .hero { padding-block:64px 75px; } .visual-inner,.two-column,.contact-inner { grid-template-columns:1fr; gap:35px; } .visual-inner { padding-top:55px; } .visual-copy { padding-top:0; } .browser-frame { max-height:560px; } .section { padding-block:75px; } .contact { padding-block:70px; } }
  @media (max-width:480px) { .masthead { min-height:72px; } .identity { font-size:14px; } .back { font-size:11px; } .hero-actions { align-items:stretch; gap:15px; } .hero-actions .button { width:100%; } h1 { font-size:47px; } .browser-frame { max-height:450px; } }
</style>
