---
import { contenido, TELEFONO, type Lang } from '../config/site';
const { lang } = Astro.props as { lang: Lang };
const precio = contenido[lang].precio;
const whatsapp = `${TELEFONO.wa}?text=${encodeURIComponent(lang === 'en' ? 'Hi Sergio, I would like a tailored quote for my website.' : lang === 'ca' ? 'Hola Sergio, voldria un pressupost personalitzat per al meu web.' : 'Hola Sergio, me gustaría recibir un presupuesto personalizado para mi web.')}`;
---
<section id="presupuesto" class="lejos border-t border-linea bg-fondo-2 px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto flex max-w-6xl flex-col gap-10">
    <div data-revela class="flex flex-col gap-4">
      <p class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-acento">{precio.eyebrow}</p>
      <h2 class="font-display text-4xl font-extrabold leading-[0.95] tracking-[-0.04em] text-balance md:text-6xl" style="font-stretch:110%">
        {precio.titular}
      </h2>
    </div>

    <dl class="grid gap-px overflow-hidden rounded-xl border border-linea bg-linea md:grid-cols-3">
      {precio.datos.map((d) => (
        <div data-revela class="flex flex-col gap-2 bg-fondo p-6 md:p-8">
          <dt class="sr-only">{d.texto}</dt>
          <dd class="font-display text-4xl font-extrabold tracking-[-0.03em] text-tinta md:text-5xl" style="font-stretch:110%">
            {d.cifra}
          </dd>
          <dd class="max-w-[34ch] text-pretty text-sm leading-relaxed text-medio">{d.texto}</dd>
        </div>
      ))}
    </dl>

    <div data-revela class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-[52ch] text-pretty text-medio md:text-lg">{precio.texto}</p>
      <a href={whatsapp} target="_blank" rel="noopener" class="boton boton--primario shrink-0">
        {precio.cta}
      </a>
    </div>
  </div>
</section>
