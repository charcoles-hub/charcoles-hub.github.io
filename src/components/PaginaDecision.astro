---
import { contenido, TELEFONO } from '../config/site';
import type { Servicio } from '../config/servicios';
import { Image } from 'astro:assets';
import fisio from '../assets/posters/fisioymes-full.png';
import manada from '../assets/posters/demo-veterinaria-manada.png';
import sereno from '../assets/posters/demo-dental-sereno.png';

const { s } = Astro.props as { s: Servicio };
if (!s.decision) throw new Error('PaginaDecision necesita un servicio con decision');
const { site } = contenido.es;
const whatsapp = `${TELEFONO.wa}?text=${encodeURIComponent(`Hola Sergio, me gustaría hablar contigo sobre ${s.nombre.toLowerCase()}.`)}`;
const { decision } = s;
const ejemplosImagen = { Fisioymés: fisio, Manada: manada, Sereno: sereno };
---

<div class="decision-page" id="arriba">
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="masthead wrap">
    <a class="identity" href="/" aria-label="Volver a la página principal de Sergio García"><span class="monogram" aria-hidden="true">sg<span>↗</span></span><span>Sergio García<span class="identity-sub">web design & development</span></span></a>
    <nav aria-label="Navegación principal"><a href="/#trabajo">Trabajos</a><a href="/#servicios">Servicios</a><a href="/#metodo">Cómo trabajo</a></nav>
    <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
  </header>

  <main id="contenido">
    <section class="hero wrap" aria-labelledby="page-title">
      <div>
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{s.nombre} · España</p>
        <h1 id="page-title">{s.h1}</h1>
        <p class="lead">{s.bajada}</p>
        <div class="actions"><a class="button button-dark" href={whatsapp}>Cuéntame tu proyecto <span aria-hidden="true">↗</span></a><a class="text-link" href="#encaja">Ver si encaja <span aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="hero-note" aria-label="Cómo elegir este servicio"><span>UNA DECISIÓN SENCILLA</span><p>{decision.pregunta}</p><a href="#encaja">Compruébalo en un minuto <span aria-hidden="true">↓</span></a></aside>
    </section>

    <section class="section wrap fit" id="encaja" aria-labelledby="fit-title" data-revela>
      <div><p class="eyebrow">Puede encajarte si…</p><h2 id="fit-title">Partes de aquí.</h2></div>
      <ul>{decision.senales.map((senal, i) => <li><span>0{i + 1}</span><p>{senal}</p></li>)}</ul>
    </section>

    <section class="section tint"><div class="wrap includes" id="incluye" data-revela><div><p class="eyebrow">El alcance</p><h2>Qué incluye.</h2><p>Lo que necesites se concreta antes de empezar y queda reflejado en la propuesta.</p></div><ul>{s.incluye.map((item, i) => <li><span aria-hidden="true">0{i + 1}</span>{item}</li>)}</ul></div></section>

    <section class="section wrap process" aria-labelledby="process-title" data-revela><div><p class="eyebrow">Así lo hacemos</p><h2 id="process-title">Tres pasos, sin humo.</h2></div><ol>{decision.proceso.map((paso, i) => <li><span>0{i + 1}</span><h3>{paso.titulo}</h3><p>{paso.texto}</p></li>)}</ol></section>

    <section class="section tint"><div class="wrap examples" aria-labelledby="examples-title" data-revela><div><p class="eyebrow">Para que te hagas una idea</p><h2 id="examples-title">Ejemplos que puedes explorar.</h2></div><div>{decision.ejemplos.map((ejemplo) => <a href={ejemplo.href} target={ejemplo.externo ? '_blank' : undefined} rel={ejemplo.externo ? 'noopener' : undefined}><div class="example-image"><Image src={ejemplosImagen[ejemplo.nombre as keyof typeof ejemplosImagen]} width={640} height={440} fit="cover" position="top" widths={[320, 640]} sizes="(min-width: 760px) 30vw, 90vw" format="webp" alt={`Vista previa de ${ejemplo.nombre}`} loading="lazy" /></div><div class="example-body"><p>{ejemplo.tipo}</p><h3>{ejemplo.nombre} <span aria-hidden="true">↗</span></h3><span>{ejemplo.texto}</span></div></a>)}</div></div></section>

    <section class="contact" id="contacto" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="eyebrow">El siguiente paso</p><h2 id="contact-title">Hablemos de una web<br /><span>a tu altura.</span></h2></div><div><p>Cuéntame a qué te dedicas, qué necesitas y si ya tienes una web. Te responderé con una propuesta y un presupuesto por escrito, sin compromiso.</p><a class="button button-lime" href={whatsapp}>Hablemos por WhatsApp <span aria-hidden="true">↗</span></a><a class="email" href={`mailto:${site.email}`}>Prefiero escribir un email <span aria-hidden="true">↗</span></a><p class="phone">O llámame al <a href={TELEFONO.tel}>{TELEFONO.humano}</a></p></div></div></section>
  </main>
  <footer class="footer wrap"><div><a href="/">Sergio García <span aria-hidden="true">↗</span></a><p>Diseño independiente. Trato directo. Toda España.</p></div><a class="text-link" href="#arriba">Volver arriba <span aria-hidden="true">↑</span></a></footer>
</div>

<style>
  .decision-page { --paper:#f7f7f0; --ink:#1c2c2b; --muted:#596361; --line:#d5dbcf; --lime:#d6f16b; background:var(--paper); color:var(--ink); font-family:'Manrope','Inter',ui-sans-serif,system-ui,sans-serif; font-size:16px; line-height:1.6; } .decision-page * { box-sizing:border-box; } .decision-page :global(a:focus-visible) { outline:3px solid #698322; outline-offset:5px; } .wrap { width:min(1280px,calc(100% - 96px)); margin:auto; } .skip { position:absolute; top:-100px; left:20px; background:var(--ink); color:var(--paper); padding:14px 20px; } .skip:focus { top:12px; } .masthead { min-height:104px; display:flex; align-items:center; justify-content:space-between; gap:32px; border-bottom:1px solid var(--line); } .identity { display:flex; align-items:center; gap:13px; font-size:16px; line-height:1.3; font-weight:750; letter-spacing:-.035em; } .identity-sub { display:block; margin-top:4px; font-size:9px; font-weight:500; letter-spacing:.045em; } .monogram { position:relative; display:grid; place-items:center; width:44px; height:44px; border:1px solid var(--ink); border-radius:50%; padding-right:3px; font-size:29px; line-height:1; letter-spacing:-.095em; } .monogram span { position:absolute; top:-5px; right:-3px; background:var(--paper); font-size:15px; } nav { display:flex; gap:25px; font-size:12px; font-weight:650; } .nav-contact { padding:11px 16px; border:1px solid var(--ink); border-radius:6px; font-size:12px; font-weight:700; } .nav-contact:hover { background:var(--ink); color:var(--paper); } .hero { display:grid; grid-template-columns:1.08fr .92fr; gap:72px; align-items:center; padding:92px 0; } .eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 24px; font-size:11px; font-weight:750; letter-spacing:.12em; text-transform:uppercase; } .status-dot { width:7px; height:7px; border-radius:50%; background:#658233; } h1,h2,h3,p { margin:0; } h1 { max-width:780px; font-size:clamp(52px,6.2vw,88px); font-weight:650; letter-spacing:-.07em; line-height:.99; text-wrap:balance; } h2 { font-size:clamp(36px,4.1vw,58px); font-weight:650; letter-spacing:-.055em; line-height:1.08; text-wrap:balance; } .lead { max-width:570px; margin-top:30px; color:var(--muted); line-height:1.75; } .actions { display:flex; align-items:center; gap:24px; margin-top:34px; } .button { display:inline-flex; align-items:center; justify-content:space-between; gap:24px; min-height:52px; padding:16px 21px; border-radius:6px; font-size:12px; font-weight:750; } .button:hover { transform:translateY(-3px); } .button span,.text-link span { font-size:19px; font-weight:400; } .button-dark { background:var(--ink); color:var(--paper); } .button-lime { background:var(--lime); } .text-link { display:inline-flex; align-items:center; gap:18px; padding-block:12px; font-size:12px; font-weight:700; } .hero-note { display:flex; min-height:330px; flex-direction:column; justify-content:space-between; padding:27px; border-radius:8px; background:#dce2d4; } .hero-note > span { font-size:9px; font-weight:750; letter-spacing:.1em; } .hero-note p { font-size:clamp(29px,3vw,43px); font-weight:650; letter-spacing:-.045em; line-height:1.1; } .hero-note a { border-top:1px solid #b1bbae; padding-top:16px; font-size:12px; font-weight:700; } .section { padding:100px 0; } .tint { background:#e6e9de; } .fit,.includes { display:grid; grid-template-columns:.78fr 1.22fr; gap:92px; } .fit ul,.includes ul { margin:0; padding:0; list-style:none; border-top:1px solid var(--line); } .fit li,.includes li { display:grid; grid-template-columns:48px 1fr; gap:20px; padding:22px 0; border-bottom:1px solid var(--line); } .fit li span,.includes li span,.process li > span { color:#718064; font-size:10px; font-weight:750; } .fit p,.includes li { font-size:16px; line-height:1.65; } .includes > div > p:last-child { max-width:390px; margin-top:26px; color:var(--muted); font-size:14px; line-height:1.8; } .process { display:grid; grid-template-columns:.78fr 1.22fr; gap:92px; } .process ol { margin:0; padding:0; list-style:none; border-top:1px solid var(--line); } .process li { display:grid; grid-template-columns:48px 1fr; column-gap:20px; padding:25px 0; border-bottom:1px solid var(--line); } .process h3 { font-size:21px; font-weight:650; letter-spacing:-.035em; } .process p { grid-column:2; margin-top:7px; color:var(--muted); font-size:14px; } .examples { display:grid; grid-template-columns:.78fr 1.22fr; gap:92px; } .examples > div:last-child { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; } .examples a { min-height:220px; padding:25px; border:1px solid #c5cec0; border-radius:8px; background:var(--paper); transition:transform .2s,box-shadow .2s; } .examples a:hover { transform:translateY(-4px); box-shadow:0 18px 35px -27px #1c2c2b; } .examples a p { color:#718064; font-size:10px; font-weight:750; letter-spacing:.1em; text-transform:uppercase; } .examples h3 { margin-top:42px; font-size:29px; letter-spacing:-.05em; } .examples a > span { display:block; margin-top:12px; color:var(--muted); font-size:13px; line-height:1.6; } .contact { background:var(--ink); color:var(--paper); padding:100px 0; } .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:92px; } .contact .eyebrow { color:var(--lime); } .contact h2 span { color:var(--lime); } .contact-grid > div:last-child > p:first-child { max-width:455px; color:#c6cdca; line-height:1.75; } .contact .button { margin-top:28px; } .email { display:block; margin-top:20px; color:var(--paper); font-size:13px; font-weight:700; } .phone { margin-top:18px; color:#c6cdca; font-size:13px; } .phone a { color:var(--paper); } .footer { display:flex; justify-content:space-between; align-items:end; gap:24px; padding:45px 0; color:var(--muted); font-size:12px; } .footer p { margin-top:8px; }
  @media (max-width:760px) { .wrap { width:min(100% - 40px,1280px); } .masthead { min-height:82px; } .masthead nav { display:none; } .identity-sub { display:none; } .nav-contact { padding:9px 11px; } .hero,.fit,.includes,.process,.examples,.contact-grid { grid-template-columns:1fr; gap:45px; } .hero { padding:64px 0; } .hero-note { min-height:250px; } .section,.contact { padding:70px 0; } .examples > div:last-child { grid-template-columns:1fr; } .examples h3 { margin-top:30px; } .footer { align-items:start; flex-direction:column; } }
  .examples a { display:block; min-height:0; padding:0; overflow:hidden; }
  .example-image { aspect-ratio: 1.45; overflow:hidden; border-bottom:1px solid #c5cec0; background:#dce2d4; }
  .example-image :global(img) { display:block; width:100%; height:100%; object-fit:cover; object-position:top; transition:transform .8s var(--suave); }
  .example-body { padding:24px; }
  .examples h3 { margin-top:24px; }
  .example-body > span { display:block; margin-top:12px; color:var(--muted); font-size:13px; line-height:1.6; }
  .hero-note { position:relative; overflow:hidden; isolation:isolate; }
  .hero-note::after { content:'↗'; position:absolute; right:-.11em; bottom:-.4em; z-index:-1; color:rgb(28 44 43 / .065); font-size:clamp(210px,26vw,370px); line-height:1; transform:rotate(-10deg); }
  @media (prefers-reduced-motion:no-preference) {
    .hero > div { animation:decision-enter .9s var(--suave) both; }
    .hero-note { animation:decision-enter 1s .12s var(--suave) both; }
    .hero-note::after { animation:decision-mark 12s ease-in-out infinite alternate; }
    .examples a:hover .example-image :global(img) { transform:scale(1.055); }
  }
  @keyframes decision-enter { from { opacity:0; transform:translateY(25px); } }
  @keyframes decision-mark { to { transform:rotate(4deg) translate(-12px,-12px); } }
</style>
