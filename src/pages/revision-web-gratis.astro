---
import Layout from '../layouts/Layout.astro';
import Cabecera from '../components/Cabecera.astro';
import Migas from '../components/Migas.astro';
import Preguntas from '../components/Preguntas.astro';
import Contacto from '../components/Contacto.astro';
import Pie from '../components/Pie.astro';
import BarraMovil from '../components/BarraMovil.astro';
import Whatsapp from '../components/iconos/Whatsapp.astro';
import { contenido, REVISION_FORM } from '../config/site';
import { whatsapp } from '../config/comun';

// La revisión es el gancho de los correos y de la portada: alguien que ya
// tiene web la manda, Sergio la revisa A MANO y contesta por email.
// Si cambia el plazo de respuesta, cambiarlo aquí y en /gracias-revision/.
const PLAZO = '48 horas laborables';

const titulo = 'Revisión gratuita de tu web · Sergio García';
const descripcion =
  'Te reviso la web gratis: cómo se ve en el móvil, qué tal carga, si se entiende lo que haces y cómo está en Google. Te respondo con qué cambiaría primero.';
const siguiente = new URL(REVISION_FORM.gracias, Astro.site).href;
const email = contenido.es.site.email;
const waTexto = 'Hola Sergio, me gustaría que revisaras mi web. La dirección es: ';
const wa = whatsapp(waTexto);
const migas = [{ nombre: 'Revisión gratuita', url: '/revision-web-gratis/' }];
const nav = [
  { texto: 'Trabajo', href: '/#trabajo' },
  { texto: 'Servicios', href: '/#servicios' },
  { texto: 'Sectores', href: '/#sectores' },
];

const revisa = [
  { titulo: 'El móvil', texto: 'Cómo se ve y se usa en una pantalla pequeña, que es donde hoy empiezan muchas búsquedas de negocios locales.' },
  { titulo: 'La velocidad', texto: 'Cuánto tarda en cargar y qué la está frenando, medido con las herramientas públicas de Google.' },
  { titulo: 'El mensaje', texto: 'Si en cinco segundos se entiende qué haces, para quién y dónde, o si hay que buscarlo.' },
  { titulo: 'El contacto', texto: 'Si llamar, escribir o pedir cita es fácil, o si el botón está escondido o no funciona.' },
  { titulo: 'Google', texto: 'Títulos, descripciones, ficha de Google y lo básico para que te encuentren en tu zona.' },
  { titulo: 'Seguridad básica', texto: 'Certificado, formularios y señales de software desactualizado, mirando la web como cualquier visitante.' },
];
const pasos = [
  { titulo: 'Me mandas tu web', texto: 'Con el formulario de esta página o por WhatsApp. Solo necesito la dirección y un email para responderte.' },
  { titulo: 'La reviso yo, a mano', texto: 'No es un informe automático: miro tu web como la vería un cliente y con las herramientas de Google.' },
  { titulo: 'Te escribo con lo importante', texto: `En un máximo de ${PLAZO}: lo que funciona, lo que falla y qué cambiaría primero. Tú decides si quieres seguir.` },
];
const faq = [
  { pregunta: '¿De verdad es gratis?', respuesta: 'Sí. Es la mejor forma que conozco de enseñarte cómo trabajo. Si te sirve y quieres que lo arreglemos, lo hablamos; si no, te quedas con la revisión.' },
  { pregunta: '¿Qué necesitas de mí?', respuesta: 'Solo la dirección de tu web y un email para responderte. Si hay algo que te preocupe en especial, cuéntamelo y lo miro con más detalle.' },
  { pregunta: '¿Vas a tocar algo de mi web?', respuesta: 'No. La miro como la ve cualquier visitante y con herramientas públicas, sin acceder a nada privado ni hacer pruebas que puedan afectarla.' },
  { pregunta: '¿Y si no tengo web todavía?', respuesta: 'Entonces no hay nada que revisar, pero sí podemos hablar de la tuya: escríbeme por WhatsApp y te cuento cómo sería.' },
];

const servicioLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Revisión gratuita de páginas web',
  description: descripcion,
  serviceType: 'Auditoría web',
  provider: { '@id': new URL('/#negocio', Astro.site).href },
  areaServed: { '@type': 'Country', name: 'España' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  url: new URL('/revision-web-gratis/', Astro.site).href,
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })),
};
---

<Layout lang="es" titulo={titulo} descripcion={descripcion} paginas={{ es: '/revision-web-gratis/' }} datos={[servicioLd, faqLd]} migas={migas}>
  <Cabecera lang="es" nav={nav} cta={{ texto: 'Pedir revisión', href: '#formulario' }} />

  <main id="contenido">
    <section class="intro wrap" aria-labelledby="titulo-pagina">
      <Migas migas={migas} />
      <div class="intro__rejilla revision">
        <div>
          <p class="etiqueta etiqueta--linea entra">Revisión gratuita</p>
          <h1 id="titulo-pagina" class="titulo-xl entra" style="--orden:1">Te reviso la web <em>gratis</em>.</h1>
          <p class="entradilla entra" style="--orden:2">
            Me pasas la dirección y te respondo por email, en un máximo de {PLAZO}, con lo que funciona, lo que está frenando a tus clientes y qué cambiaría primero. Sin compromiso.
          </p>
          <ul class="intro__datos entra" style="--orden:3">
            <li><span class="icono icono--check" aria-hidden="true"></span>Revisada a mano, no un informe automático</li>
            <li><span class="icono icono--check" aria-hidden="true"></span>Sin compromiso</li>
            <li><span class="icono icono--check" aria-hidden="true"></span>La hago yo, Sergio</li>
          </ul>
        </div>

        <form class="formulario entra" style="--orden:2" id="formulario" action={REVISION_FORM.destino} method="POST" aria-labelledby="titulo-formulario">
          <input type="hidden" name="access_key" value={REVISION_FORM.clave} />
          <input type="hidden" name="subject" value="Revisión gratuita: nueva web para revisar" />
          <input type="hidden" name="from_name" value="Web · Revisión gratuita" />
          <input type="hidden" name="redirect" value={siguiente} />
          <p class="cebo" aria-hidden="true"><label>No rellenar<input type="checkbox" name="botcheck" tabindex="-1" /></label></p>

          <h2 id="titulo-formulario" class="titulo-m">Pide tu revisión</h2>
          <p class="campo">
            <label for="web">La dirección de tu web</label>
            <input id="web" name="Web" type="text" inputmode="url" autocomplete="url" placeholder="www.tunegocio.com" maxlength="200" required />
          </p>
          <div class="formulario__par">
            <p class="campo">
              <label for="nombre">Tu nombre</label>
              <input id="nombre" name="Nombre" type="text" autocomplete="name" maxlength="80" required />
            </p>
            <p class="campo">
              <label for="email">Tu email</label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="120" required />
            </p>
          </div>
          <p class="campo">
            <label for="telefono">Teléfono <span class="opcional">(opcional)</span></label>
            <input id="telefono" name="Telefono" type="tel" autocomplete="tel" maxlength="30" />
          </p>
          <p class="campo">
            <label for="mensaje">¿Algo que te preocupe en especial? <span class="opcional">(opcional)</span></label>
            <textarea id="mensaje" name="Mensaje" rows="3" maxlength="800"></textarea>
          </p>
          <button class="boton boton--oscuro boton--ancho" type="submit">Enviar mi web para revisar<span class="icono" aria-hidden="true"></span></button>
          <p class="formulario__legal">
            Responsable: Sergio García Ortiz. Uso tus datos solo para enviarte la revisión y responder a tu solicitud; no los cedo a nadie. El formulario se envía a través de Web3Forms. Puedes pedirme que los borre cuando quieras en <a href={`mailto:${email}`}>{email}</a>.
          </p>
          <p class="formulario__alternativa">¿Prefieres WhatsApp? <a href={wa}><Whatsapp />Mándame la dirección por WhatsApp</a></p>
        </form>
      </div>
    </section>

    <section class="seccion seccion--tinte" aria-labelledby="titulo-reviso">
      <div class="wrap">
        <div class="cabeza" data-revela>
          <div>
            <p class="etiqueta etiqueta--linea">Qué miro</p>
            <h2 id="titulo-reviso" class="titulo-l">Lo que más pesa cuando alguien <em>te busca</em>.</h2>
          </div>
          <p>No es una lista de fallos técnicos incomprensible: es lo que está haciendo que un cliente te escriba o se vaya a la competencia.</p>
        </div>
        <ul class="rejilla-3">
          {revisa.map((r, i) => <li class="tarjeta" data-revela><span>0{i + 1}</span><h3 class="subtitulo">{r.titulo}</h3><p>{r.texto}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="seccion" aria-labelledby="titulo-como">
      <div class="wrap dos">
        <div data-revela>
          <p class="etiqueta etiqueta--linea">Cómo funciona</p>
          <h2 id="titulo-como" class="titulo-l">Tres pasos y <em>ninguna letra pequeña</em>.</h2>
        </div>
        <ol class="lista-num">
          {pasos.map((p, i) => <li data-revela><span>0{i + 1}</span><div><h3 class="subtitulo">{p.titulo}</h3><p>{p.texto}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="seccion seccion--tinte" aria-labelledby="titulo-faq">
      <div class="wrap dos">
        <div data-revela>
          <p class="etiqueta etiqueta--linea">Preguntas frecuentes</p>
          <h2 id="titulo-faq" class="titulo-l">Antes de <em>mandármela</em>.</h2>
        </div>
        <Preguntas preguntas={faq} />
      </div>
    </section>

    <Contacto lang="es" revision={false} titulo="¿Prefieres hablarlo *directamente*?" texto="Si ya tienes claro que quieres renovar tu web, o todavía no tienes una, escríbeme y hablamos de tu proyecto. Te respondo con una propuesta y un presupuesto por escrito." waTexto="Hola Sergio, me gustaría hablar contigo sobre la web de mi negocio." />
  </main>

  <Pie lang="es" />
  <BarraMovil lang="es" waTexto={waTexto} />
</Layout>

<style>
  .revision { align-items: start; }
  .formulario {
    display: grid; gap: 20px; padding: clamp(24px, 3.5vw, 40px); border: 1px solid var(--linea);
    border-radius: 28px; background: var(--blanco); box-shadow: var(--sombra);
  }
  .formulario__par { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .opcional { font-weight: 400; color: var(--tenue); }
  .formulario__legal { font-size: 0.8rem; line-height: 1.55; color: var(--tenue); }
  .formulario__legal a { text-decoration: underline; text-underline-offset: 3px; }
  .formulario__alternativa { padding-top: 16px; border-top: 1px solid var(--linea); font-size: 0.92rem; color: var(--tenue); }
  .formulario__alternativa a { display: inline-flex; align-items: center; gap: 6px; margin-left: 4px; color: var(--tinta); font-weight: 600; }
  .formulario__alternativa a:hover { color: var(--oliva); }
  .formulario__alternativa svg { width: 16px; height: 16px; }
  @media (max-width: 520px) { .formulario__par { grid-template-columns: 1fr; } }
</style>
