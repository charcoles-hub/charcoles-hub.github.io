---
import { contenido, rutas, RESENA_FORM, RESENAS, type Lang } from '../config/site';
import Cabecera from './Cabecera.astro';
import Pie from './Pie.astro';

const { lang } = Astro.props as { lang: Lang };
const f = contenido[lang].formulario;
const siguiente = new URL(RESENA_FORM.gracias[lang], Astro.site).href;
const estrellas = [5, 4, 3, 2, 1];
const locale = lang === 'en' ? 'en-US' : lang === 'ca' ? 'ca-ES' : 'es-ES';
const fecha = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });

const textos = {
  es: {
    back: 'Volver al portfolio',
    control: 'Tú decides',
    controlTitle: 'Solo se publica con tu permiso.',
    controlText: 'La reseña llega primero a mi correo. Compruebo que todo esté correcto y únicamente entonces aparece en la web.',
    after: 'Después de enviar',
    afterTitle: 'Nada aparece sin revisar.',
    steps: [
      ['01', 'La recibo', 'Me llega por correo con los datos que has decidido compartir.'],
      ['02', 'La compruebo', 'Reviso el permiso, el enlace y que no haya ningún error evidente.'],
      ['03', 'La publico', 'Aparece aquí y en el portfolio. Si algún día quieres retirarla, basta con pedirlo.'],
    ],
    published: 'Reseñas publicadas',
    publishedTitle: 'Aquí aparecen las voces reales.',
    publishedIntro: 'Esta página y la portada comparten la misma lista de reseñas aprobadas. No hay ejemplos inventados ni publicaciones automáticas sin control.',
    empty: 'Todavía no hay ninguna publicada. La primera reseña aprobada aparecerá en este espacio y también en la portada.',
  },
  en: {
    back: 'Back to the portfolio',
    control: 'You decide',
    controlTitle: 'It is only published with your permission.',
    controlText: 'The review reaches my inbox first. I check that everything is correct, and only then can it appear on the website.',
    after: 'After you send it',
    afterTitle: 'Nothing goes live without a check.',
    steps: [
      ['01', 'I receive it', 'It reaches me by email with the details you chose to share.'],
      ['02', 'I check it', 'I confirm the permission, the link and that there is no obvious mistake.'],
      ['03', 'I publish it', 'It appears here and on the portfolio. If you ever want it removed, just ask.'],
    ],
    published: 'Published reviews',
    publishedTitle: 'Real voices appear here.',
    publishedIntro: 'This page and the homepage share the same list of approved reviews. There are no invented examples or unmoderated automatic posts.',
    empty: 'There are no published reviews yet. The first approved review will appear here and on the homepage.',
  },
  ca: {
    back: 'Tornar al portfoli',
    control: 'Tu decideixes',
    controlTitle: 'Només es publica amb el teu permís.',
    controlText: 'La ressenya arriba primer al meu correu. Comprovo que tot estigui correcte i només llavors pot aparèixer al web.',
    after: 'Després d’enviar-la',
    afterTitle: 'No apareix res sense revisar.',
    steps: [
      ['01', 'La rebo', 'M’arriba per correu amb les dades que has decidit compartir.'],
      ['02', 'La comprovo', 'Reviso el permís, l’enllaç i que no hi hagi cap error evident.'],
      ['03', 'La publico', 'Apareix aquí i al portfoli. Si algun dia vols retirar-la, només cal demanar-ho.'],
    ],
    published: 'Ressenyes publicades',
    publishedTitle: 'Aquí apareixen les veus reals.',
    publishedIntro: 'Aquesta pàgina i la portada comparteixen la mateixa llista de ressenyes aprovades. No hi ha exemples inventats ni publicacions automàtiques sense control.',
    empty: 'Encara no n’hi ha cap de publicada. La primera ressenya aprovada apareixerà aquí i també a la portada.',
  },
} as const;

const t = textos[lang];
---

<Cabecera lang={lang} nav={[]} cta={{ texto: t.back, href: rutas[lang] }} idiomas={{ es: '/resena/', ca: '/ca/ressenya/', en: '/en/review/' }} />

<main id="contenido">
  <section class="intro wrap" aria-labelledby="review-title">
    <div class="intro__rejilla">
      <div>
        <p class="etiqueta etiqueta--linea entra">{f.eyebrow}</p>
        <h1 id="review-title" class="titulo-xl entra" style="--orden:1">{f.titular}</h1>
        <p class="entradilla entra" style="--orden:2">{f.texto}</p>
      </div>
      <aside class="nota nota--oscura entra" style="--orden:2" aria-label={t.control}>
        <span class="nota__etiqueta">{t.control}</span>
        <p class="nota__texto">{t.controlTitle}</p>
        <p class="nota__detalle">{t.controlText}</p>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--tinte" aria-label={f.enviar}>
    <div class="wrap form-layout">
      <form action={RESENA_FORM.destino} method="POST" class="review-form">
        <input type="hidden" name="access_key" value={RESENA_FORM.clave} />
        <input type="hidden" name="subject" value="Nueva reseña desde el portfolio" />
        <input type="hidden" name="from_name" value="Portfolio · Reseñas" />
        <input type="hidden" name="redirect" value={siguiente} />
        <input type="hidden" name="Idioma" value={lang} />
        <p class="cebo" aria-hidden="true">
          <label>No rellenar<input type="checkbox" name="botcheck" tabindex="-1" /></label>
        </p>

        <fieldset class="rating">
          <legend class="label">{f.puntuacion}</legend>
          <div class="stars">
            {estrellas.map((n) => (
              <>
                <input type="radio" id={`estrella-${n}`} name="Puntuacion" value={`${n}/5`} checked={n === 5} required />
                <label for={`estrella-${n}`} title={`${n}/5`}>
                  <span class="sr-only">{`${n}/5`}</span><span aria-hidden="true">★</span>
                </label>
              </>
            ))}
          </div>
          <span class="pista">{f.puntuacionPista}</span>
        </fieldset>

        <p class="campo">
          <label for="resena">{f.resena}</label>
          <textarea id="resena" name="Resena" rows="6" maxlength="700" required></textarea>
          <span class="pista">{f.resenaPista}</span>
        </p>

        <div class="field-grid">
          <p class="campo">
            <label for="nombre">{f.nombre}</label>
            <input id="nombre" name="Nombre" type="text" autocomplete="name" maxlength="80" required />
            <span class="pista">{f.nombrePista}</span>
          </p>
          <p class="campo">
            <label for="negocio">{f.negocio}</label>
            <input id="negocio" name="Negocio" type="text" maxlength="120" required />
            <span class="pista">{f.negocioPista}</span>
          </p>
          <p class="campo">
            <label for="enlace">{f.enlace}</label>
            <input id="enlace" name="Enlace" type="url" inputmode="url" placeholder="https://" maxlength="200" />
            <span class="pista">{f.enlacePista}</span>
          </p>
          <p class="campo">
            <label for="email">{f.email}</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="120" />
            <span class="pista">{f.emailPista}</span>
          </p>
        </div>

        <label class="permission">
          <input type="checkbox" name="Permiso" value="Si, autoriza a publicarla" required />
          <span>{f.permiso}</span>
        </label>

        <div class="submit-row">
          <p>{f.legal}</p>
          <button class="boton boton--oscuro" type="submit">{f.enviar}<span class="icono" aria-hidden="true"></span></button>
        </div>
      </form>

      <aside class="after-card">
        <p class="etiqueta etiqueta--linea">{t.after}</p>
        <h2 class="titulo-m">{t.afterTitle}</h2>
        <ol class="lista-num">
          {t.steps.map(([number, title, text]) => (
            <li><span>{number}</span><div><h3 class="subtitulo">{title}</h3><p>{text}</p></div></li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <section class="seccion wrap" aria-labelledby="published-title">
    <div class="cabeza">
      <div><p class="etiqueta etiqueta--linea">{t.published}</p><h2 id="published-title" class="titulo-l">{t.publishedTitle}</h2></div>
      <p>{t.publishedIntro}</p>
    </div>
    {RESENAS.length ? (
      <ul class:list={['review-grid', { 'review-grid--single': RESENAS.length === 1 }]} role="list">
        {RESENAS.map((review) => {
          const text = lang === 'en' && review.textoEn ? review.textoEn : review.texto;
          return (
            <li class="tarjeta">
              <p class="review-stars" aria-label={contenido[lang].resenas.deCinco(review.estrellas)}>{'★'.repeat(review.estrellas)}<span aria-hidden="true">{'★'.repeat(5 - review.estrellas)}</span></p>
              <blockquote lang={lang === 'en' && review.textoEn ? 'en' : 'es'}>“{text}”</blockquote>
              <footer><strong>{review.autor}</strong><span>{review.cargo} · {fecha.format(new Date(review.fecha))}</span></footer>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="empty-reviews"><span aria-hidden="true">★★★★★</span><p>{t.empty}</p></div>
    )}
  </section>
</main>

<Pie lang={lang} />

<style>
  .nota__detalle { color: var(--tenue-oscuro); font-size: 0.95rem; }
  .form-layout { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr); gap: 48px clamp(40px, 6vw, 88px); align-items: start; }
  .review-form { display: grid; gap: 26px; padding: clamp(24px, 3.5vw, 40px); border: 1px solid var(--linea); border-radius: 28px; background: var(--blanco); box-shadow: var(--sombra); }
  .review-form fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .label { display: block; margin-bottom: 10px; font-size: 0.85rem; font-weight: 600; }
  .stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; width: max-content; }
  .stars input { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; opacity: 0; }
  .stars label { cursor: pointer; padding-inline: 2px; color: var(--linea-fuerte); font-size: 34px; line-height: 1; transition: color 0.15s, transform 0.15s; }
  .stars label:hover { transform: translateY(-2px); }
  .stars label:hover, .stars label:hover ~ label, .stars input:checked ~ label { color: var(--oliva); }
  .stars input:focus-visible + label { outline: 3px solid var(--oliva); outline-offset: 2px; border-radius: 4px; }
  .rating .pista { display: block; margin-top: 8px; font-size: 0.82rem; color: var(--tenue); }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .permission { display: flex; align-items: flex-start; gap: 13px; padding-block: 20px; border-block: 1px solid var(--linea); color: var(--tenue); font-size: 0.92rem; cursor: pointer; }
  .permission input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--oliva); flex: none; }
  .submit-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .submit-row p { max-width: 26em; font-size: 0.85rem; color: var(--tenue); }
  .after-card { position: sticky; top: 110px; display: grid; gap: 8px; }
  .after-card .lista-num { margin-top: 20px; }
  .review-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; list-style: none; }
  .review-grid--single { grid-template-columns: minmax(0, 1fr); max-width: 780px; }
  .review-grid blockquote { margin: 0; font-family: var(--serif); font-size: 1.45rem; line-height: 1.25; }
  .review-grid footer { display: grid; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--linea); font-size: 0.9rem; }
  .review-grid footer span { color: var(--tenue); }
  .review-stars { color: var(--oliva); letter-spacing: 0.12em; }
  .review-stars span { color: var(--linea-fuerte); }
  .empty-reviews { display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: center; max-width: 820px; padding-block: 30px; border-block: 1px solid var(--linea); }
  .empty-reviews span { color: var(--oliva); font-size: 1.6rem; letter-spacing: 0.12em; }
  .empty-reviews p { color: var(--tenue); }
  @media (max-width: 900px) { .form-layout { grid-template-columns: 1fr; } .after-card { position: static; } .review-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .field-grid, .empty-reviews { grid-template-columns: 1fr; } .submit-row { flex-direction: column; align-items: stretch; } .submit-row .boton { width: 100%; } }
</style>
