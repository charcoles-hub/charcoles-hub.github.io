---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Cabecera from '../../components/Cabecera.astro';
import Migas from '../../components/Migas.astro';
import Contacto from '../../components/Contacto.astro';
import Pie from '../../components/Pie.astro';
import BarraMovil from '../../components/BarraMovil.astro';
import { poster } from '../../config/posters';

const captura = poster('fisioymes-full');

const problemas = [
  'La página era demasiado larga y costaba llegar a la información importante y al siguiente paso para pedir cita.',
  'No estaba adaptada al móvil.',
  'Tardaba en cargar.',
  'El diseño había quedado anticuado.',
];

const decisiones = [
  {
    titulo: 'Ordenar el contenido',
    texto: 'Organicé las lesiones en una rejilla y los tratamientos en fichas para que cada persona pueda explorar lo que necesita.',
  },
  {
    titulo: 'Pensar primero en el móvil',
    texto: 'Replanteé la presentación para que el contenido y el acceso a la cita funcionen también en pantallas pequeñas.',
  },
  {
    titulo: 'Conservar lo que ya funcionaba',
    texto: 'La web está en catalán y castellano y mantiene el sistema de reservas que la clínica ya utilizaba.',
  },
];

const migas = [
  { nombre: 'Trabajo', url: '/#trabajo' },
  { nombre: 'Fisioymés', url: '/proyectos/fisioymes/' },
];
const nav = [
  { texto: 'Trabajo', href: '/#trabajo' },
  { texto: 'Servicios', href: '/#servicios' },
  { texto: 'Sectores', href: '/#sectores' },
  { texto: 'Revisión gratis', href: '/revision-web-gratis/' },
];
const waTexto = 'Hola Sergio, he visto el proyecto de Fisioymés y me gustaría hablar sobre mi web.';
const casoLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Rediseño web de Fisioymés',
  about: 'Rediseño de la web de una clínica de fisioterapia en Sant Cugat del Vallès',
  creator: { '@id': new URL('/#sergio', Astro.site).href },
  inLanguage: ['es', 'ca'],
  url: new URL('/proyectos/fisioymes/', Astro.site).href,
};
---

<Layout
  lang="es"
  titulo="Rediseño web de Fisioymés (fisioterapia) · Sergio García"
  descripcion="Cómo reorganicé la web de Fisioymés para facilitar la consulta en móvil y el acceso a la cita, manteniendo sus reservas y sus dos idiomas."
  paginas={{ es: '/proyectos/fisioymes/' }}
  datos={[casoLd]}
  migas={migas}
>
  <Cabecera lang="es" nav={nav} />

  <main id="contenido">
    <article>
      <section class="intro wrap" aria-labelledby="titulo-caso">
        <Migas migas={migas} />
        <p class="etiqueta etiqueta--linea entra">Proyecto real · Fisioterapia · Sant Cugat del Vallès</p>
        <h1 id="titulo-caso" class="titulo-xl caso-titulo entra" style="--orden:1">Fisioymés: encontrar lo importante <em>sin recorrer toda la web</em>.</h1>
        <p class="entradilla entra" style="--orden:2">Rediseñé la web de la clínica para que sus pacientes puedan consultar lesiones y tratamientos desde el móvil y llegar con claridad a la reserva de cita.</p>
        <div class="intro__acciones entra" style="--orden:3">
          <a class="boton boton--oscuro" href="https://fisioymes.com/" target="_blank" rel="noopener">Ver la web publicada<span class="icono" aria-hidden="true"></span></a>
          <a class="boton boton--borde" href="#punto-de-partida">Leer el caso<span class="icono icono--abajo" aria-hidden="true"></span></a>
        </div>
        <ul class="ficha entra" style="--orden:4">
          <li><span>Cliente</span>Fisioymés</li>
          <li><span>Sector</span>Fisioterapia</li>
          <li><span>Idiomas</span>Castellano y catalán</li>
          <li><span>Trabajo</span>Rediseño, diseño y desarrollo</li>
        </ul>
      </section>

      <section class="visual" aria-labelledby="titulo-visual">
        <div class="wrap visual__dentro">
          <div class="visual__texto" data-revela>
            <p class="etiqueta etiqueta--linea">La web publicada</p>
            <h2 id="titulo-visual" class="titulo-l">Una estructura que se puede <em>explorar</em>.</h2>
            <p>La captura muestra la versión actual. La web anterior ya no está disponible.</p>
            <p class="visual__pista">Pasa el ratón por la captura para recorrerla entera.</p>
          </div>
          <div class="marco visual__marco" tabindex="0" aria-label="Captura completa de la web de Fisioymés">
            <div class="marco__barra" aria-hidden="true"><i></i><i></i><i></i><span>fisioymes.com</span></div>
            <div class="visual__pantalla">
              <Image src={captura} width={1100} format="webp" quality={72} widths={[560, 820, 1100]} sizes="(min-width: 900px) 58vw, 92vw" alt="Captura de la web actual de Fisioymés con sus secciones de lesiones y tratamientos" loading="eager" />
            </div>
          </div>
        </div>
      </section>

      <section class="seccion" id="punto-de-partida" aria-labelledby="titulo-partida">
        <div class="wrap dos">
          <div data-revela>
            <p class="etiqueta etiqueta--linea">El punto de partida</p>
            <h2 id="titulo-partida" class="titulo-l">Lo que dificultaba <em>el recorrido</em>.</h2>
          </div>
          <ul class="fallos">{problemas.map((problema) => <li data-revela>{problema}</li>)}</ul>
        </div>
      </section>

      <section class="seccion seccion--tinte" aria-labelledby="titulo-decisiones">
        <div class="wrap dos">
          <div data-revela>
            <p class="etiqueta etiqueta--linea">El rediseño</p>
            <h2 id="titulo-decisiones" class="titulo-l">Decisiones para hacerlo <em>más claro</em>.</h2>
          </div>
          <ol class="lista-num">
            {decisiones.map((d, i) => <li data-revela><span>0{i + 1}</span><div><h3 class="subtitulo">{d.titulo}</h3><p>{d.texto}</p></div></li>)}
          </ol>
        </div>
      </section>

      <section class="seccion" aria-labelledby="titulo-resultado">
        <div class="wrap resultado" data-revela>
          <p class="etiqueta etiqueta--linea">Lo que puedes comprobar</p>
          <h2 id="titulo-resultado" class="titulo-l">Una visita con <em>menos obstáculos</em>.</h2>
          <p class="entradilla">En la web publicada puedes recorrer las lesiones y los tratamientos, cambiar de idioma y acceder al sistema de reservas de la clínica. No presento una cifra de mejora de velocidad o de conversiones porque no hay una medición comparable de la web anterior.</p>
          <div class="intro__acciones">
            <a class="boton boton--oscuro" href="https://fisioymes.com/" target="_blank" rel="noopener">Explorar Fisioymés<span class="icono" aria-hidden="true"></span></a>
            <a class="boton boton--borde" href="/rediseno-web/">Cómo trabajo un rediseño<span class="icono" aria-hidden="true"></span></a>
          </div>
        </div>
      </section>
    </article>

    <Contacto
      lang="es"
      titulo="¿Tu web también hace *buscar demasiado*?"
      texto="Podemos revisar qué dificulta el recorrido y qué conviene conservar de tu web actual. Te respondo con una propuesta y un presupuesto por escrito, sin compromiso."
      waTexto={waTexto}
    />
  </main>

  <Pie lang="es" />
  <BarraMovil lang="es" waTexto={waTexto} />
</Layout>

<style>
  .caso-titulo { max-width: 13em; }
  .ficha { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 56px; padding-top: 26px; border-top: 1px solid var(--linea); list-style: none; }
  .ficha li { display: grid; gap: 4px; font-weight: 500; }
  .ficha span { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: var(--oliva); }
  @media (max-width: 760px) { .ficha { grid-template-columns: 1fr 1fr; } }

  .visual { overflow: hidden; background: var(--papel-3); }
  .visual__dentro { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 40px clamp(40px, 6vw, 88px); align-items: start; padding-top: clamp(56px, 7vw, 96px); }
  .visual__texto { padding-top: 12px; }
  .visual__texto > p:not(.etiqueta) { margin-top: 20px; color: var(--tenue); max-width: 26em; }
  .visual__pista { font-size: 0.9rem; }
  @media (hover: none) { .visual__pista { display: none; } }
  .visual__marco { border-bottom: 0; border-radius: var(--radio-s) var(--radio-s) 0 0; }
  .visual__pantalla { height: min(720px, 80vh); overflow: hidden; }
  .visual__pantalla img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .visual__pantalla img { transition: object-position 10s cubic-bezier(0.45, 0, 0.35, 1); }
    .visual__marco:hover .visual__pantalla img, .visual__marco:focus-visible .visual__pantalla img { object-position: 50% 100%; transition-duration: 14s; }
  }
  @media (max-width: 900px) { .visual__dentro { grid-template-columns: 1fr; } .visual__pantalla { height: 520px; } }

  .resultado { max-width: 900px; }
  .resultado .entradilla { margin-top: 26px; max-width: 42em; }
</style>
