---
import { ZONAS } from '../config/zonas';
import type { Servicio } from '../config/servicios';
import Layout from '../layouts/Layout.astro';
import PaginaLarga from '../components/PaginaLarga.astro';

export function getStaticPaths() {
  return ZONAS.map((s) => ({ params: { zona: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servicio };
const url = new URL(`/${s.slug}/`, Astro.site).href;
const migas = [{ nombre: `Diseño web en ${s.nombre}`, url: `/${s.slug}/` }];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const zonaLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#servicio`,
  name: `Diseño web en ${s.nombre}`,
  description: s.descripcion,
  serviceType: 'Diseño de páginas web',
  provider: { '@id': new URL('/#negocio', Astro.site).href },
  areaServed: { '@type': 'Place', name: s.nombre },
  url,
};
---
<Layout lang="es" titulo={s.titulo} descripcion={s.descripcion} paginas={{ es: `/${s.slug}/` }} datos={[zonaLd, faqLd]} migas={migas}>
  <PaginaLarga s={s} migas={migas} tipo="zona" />
</Layout>
