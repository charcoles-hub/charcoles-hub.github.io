---
import { Image } from 'astro:assets';
import { contenido, rutas, TELEFONO, RESENAS, type Lang } from '../config/site';
import { studio } from '../config/studio';
import { SERVICIOS } from '../config/servicios';
import { ZONAS } from '../config/zonas';
import fisio from '../assets/posters/fisioymes-full.png';
import navaja from '../assets/posters/demo-barberia-navaja.png';
import sereno from '../assets/posters/demo-dental-sereno.png';
import traza from '../assets/posters/demo-arquitectos-traza.png';
import dental from '../assets/posters/demo-dental-us.png';
import law from '../assets/posters/demo-lawfirm-us.png';

const { lang } = Astro.props as { lang: Lang };
const t = studio[lang];
const c = contenido[lang];
const selected = lang === 'en'
  ? c.proyectos
  : ['demo-barberia-navaja', 'demo-dental-sereno', 'demo-arquitectos-traza'].map(slug => c.proyectos.find(p => p.slug === slug)!);
const posters = { 'demo-barberia-navaja': navaja, 'demo-dental-sereno': sereno, 'demo-arquitectos-traza': traza, 'demo-dental-us': dental, 'demo-lawfirm-us': law };
const more = c.proyectos.filter(p => !selected.some(s => s.slug === p.slug));
const wa = `${TELEFONO.wa}?text=${encodeURIComponent(t.waText)}`;
const anchors = ['trabajo', 'servicios', 'metodo', 'presupuesto'];
const hayResenas = RESENAS.length > 0;
const formatoResena = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : lang === 'ca' ? 'ca-ES' : 'es-ES', { month: 'long', year: 'numeric' });
---

<div class="studio" id="arriba">
  <a class="skip" href="#contenido">{t.skip}</a>
  <header class="masthead wrap">
    <a class="identity" href={rutas[lang]} aria-label="Sergio García"><span class="monogram" aria-hidden="true">sg<span>↗</span></span><span>Sergio García<span class="identity-sub">web design & development</span></span></a>
    <nav class="desktop-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}</nav>
    <div class="nav-end">
      <nav class="languages" aria-label={t.language}>{(['es', 'ca', 'en'] as Lang[]).map(l => <a href={rutas[l]} lang={l} aria-current={lang === l ? 'page' : undefined} aria-label={{es:'Español',ca:'Català',en:'English'}[l]}>{l.toUpperCase()}</a>)}</nav>
      <a class="nav-contact" href="#contacto">{t.talk}<span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <nav class="mobile-nav wrap" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>{t.nav.map((label, i) => <a href={`#${anchors[i]}`}>{label}</a>)}<a href="#contacto">{t.talk} ↗</a></nav>

  <section class="hero wrap" id="contenido" aria-labelledby="hero-title">
    <div class="hero-copy hero-enter">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{t.role}</p>
      <h1 id="hero-title"><span class="hero-lead">{t.hero[0]}</span><span>{t.hero[1]}</span><span class="hero-em">{t.hero[2]}</span></h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="hero-actions"><a class="button button-dark" href={wa}>{t.start}<span aria-hidden="true">↗</span></a><a class="text-link" href="#trabajo">{t.work}<span aria-hidden="true">↓</span></a></div>
      <p class="hero-facts"><strong>{t.from}</strong><span>{t.time}</span><span>{t.quote}</span></p>
    </div>
    <a class="hero-showcase hero-enter" href="#caso-fisioymes" aria-label={`${t.visit}: Fisioymés`}>
      <div class="showcase-top"><span>{t.client.toUpperCase()} / 01</span><span aria-hidden="true">↗</span></div>
      <div class="desktop-screen">
        <div class="screen-bar" aria-hidden="true"><i></i><i></i><i></i><span>fisioymés</span></div>
        <Image src={fisio} width={1100} height={780} fit="cover" position="top" format="webp" quality={85} widths={[550, 850, 1100]} sizes="(min-width: 900px) 42vw, 90vw" alt={`Fisioymés · ${t.caseTag}`} loading="eager" fetchpriority="high" />
      </div>
      <div class="showcase-bottom"><span><strong>{t.heroCaption}</strong><small>{t.heroNote}</small></span><span class="round-arrow" aria-hidden="true">↗</span></div>
    </a>
  </section>

  <div class="promise-bar"><div class="wrap promises">{t.pillars.map(x => <span><i aria-hidden="true">✳</i>{x}</span>)}</div></div>

  <section class="section wrap" id="trabajo" aria-labelledby="work-title">
    <div class="section-head"><div><p class="eyebrow">{t.workKicker}</p><h2 id="work-title">{t.workTitle}</h2></div><p>{t.workIntro}</p></div>
    <article class="case" id="caso-fisioymes">
      <a class="case-visual" href={c.destacado.url} aria-label={`${t.visit}: Fisioymés`}>
        <div class="case-visual-label"><span>{t.client}</span><span aria-hidden="true">↗</span></div>
        <div class="case-browser"><div class="screen-bar" aria-hidden="true"><i></i><i></i><i></i><span>fisioymés</span></div><Image src={fisio} width={1000} height={1100} fit="cover" position="top" widths={[500, 1000]} sizes="(min-width: 900px) 48vw, 90vw" format="webp" alt={`Fisioymés · ${t.caseTag}`} loading="lazy" /></div>
        <p>{t.caseTag}</p>
      </a>
      <div class="case-copy"><p class="eyebrow">FISIOYMÉS</p><h3>{t.caseLead}</h3><p class="case-intro">{t.caseIntro}</p><dl>{t.caseSteps.map(([title, detail], i) => <div><dt><span aria-hidden="true">0{i + 1}</span>{title}</dt><dd>{detail}</dd></div>)}</dl><a class="text-link" href={c.destacado.url}>{t.visit}<span aria-hidden="true">↗</span></a></div>
    </article>
    <div class="concept-heading"><div><p class="eyebrow">{t.ideasKicker}</p><h3>{t.ideasTitle}</h3></div><p>{t.ideasIntro}</p></div>
    <div class="concept-grid" class:list={{ 'concept-grid-two': selected.length === 2 }}>{selected.map(p => <a class="concept-card" href={p.url} target="_blank" rel="noopener"><div class="concept-image"><Image src={posters[p.slug as keyof typeof posters]} width={800} height={620} fit="cover" position="top" widths={[400, 800]} sizes="(min-width: 900px) 30vw, (min-width: 600px) 45vw, 90vw" format="webp" alt={`${p.nombre}: ${p.rubro}`} loading="lazy" /><span>{t.concept}</span></div><div class="concept-name"><h4>{p.nombre}</h4><span aria-hidden="true">↗</span></div><p>{p.rubro.split(' · ')[0]}</p></a>)}</div>
    {more.length > 0 && <details class="more-concepts"><summary>{t.all}<span aria-hidden="true">+</span></summary><div>{more.map(p => <a href={p.url} target="_blank" rel="noopener"><span>{p.nombre} <small>{p.rubro.split(' · ')[0]} · {t.concept}</small></span><span aria-hidden="true">↗</span></a>)}</div></details>}
  </section>

  <section class="reviews section" id="resenas" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{c.resenas.eyebrow}</p>
          <h2 id="reviews-title">{hayResenas ? c.resenas.titular : c.resenas.titularVacio}</h2>
        </div>
        <p>{hayResenas ? c.resenas.texto : c.resenas.textoVacio}</p>
      </div>

      {hayResenas ? (
        <ul class="review-grid" role="list">
          {RESENAS.map((review) => (
            <li class="review-card">
              <p class="review-stars" aria-label={c.resenas.deCinco(review.estrellas)}>{'★'.repeat(review.estrellas)}<span aria-hidden="true">{'★'.repeat(5 - review.estrellas)}</span></p>
              <blockquote>“{lang === 'en' && review.textoEn ? review.textoEn : review.texto}”</blockquote>
              <footer>
                <strong>{review.url ? <a href={review.url} target="_blank" rel="noopener">{review.autor} <span aria-hidden="true">↗</span></a> : review.autor}</strong>
                <span>{review.cargo} · {formatoResena.format(new Date(review.fecha))}</span>
              </footer>
            </li>
          ))}
        </ul>
      ) : (
        <div class="review-invite">
          <p class="review-stars" aria-hidden="true">★★★★★</p>
          <p>{c.resenas.nota}</p>
        </div>
      )}

      <a class="button button-dark review-cta" href={c.resenas.href}>{c.resenas.cta}<span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="services section" id="servicios" aria-labelledby="services-title"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{t.servicesKicker}</p><h2 id="services-title">{t.servicesTitle}</h2></div></div>{lang === 'es' && <div class="decision-chooser" aria-label="Elige el punto de partida de tu web"><div><p>¿Tu negocio está empezando o tu web actual se ha quedado atrás?</p><span>Elige tu punto de partida</span></div><div class="decision-links"><a href="/diseno-web/"><strong>Necesito una web nueva</strong><span>Empiezo desde cero <b aria-hidden="true">↗</b></span></a><a href="/rediseno-web/"><strong>Quiero rediseñar mi web</strong><span>Parto de una web actual <b aria-hidden="true">↗</b></span></a></div></div>}<div class="service-grid">{t.services.map(([title, desc, label, url], i) => <article><span class="service-number" aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{desc}</p><a class="text-link" href={url} hreflang="es" aria-label={`${label} · ${t.details}`}>{label}<span aria-hidden="true">↗</span></a></article>)}</div></div></section>

  <section class="section wrap process" id="metodo" aria-labelledby="process-title"><div class="section-head"><div><p class="eyebrow">{t.processKicker}</p><h2 id="process-title">{t.processTitle}</h2></div></div><ol class="process-grid">{t.process.map(([title, desc], i) => <li><span class="step" aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{desc}</p></li>)}</ol></section>

  <section class="quote section" id="presupuesto" aria-labelledby="quote-title"><div class="wrap"><div class="section-head"><div><p class="eyebrow">{t.priceKicker}</p><h2 id="quote-title">{t.priceTitle}</h2></div><p>{t.priceIntro}</p></div><div class="quote-grid"><article class="quote-card"><div class="quote-card-top"><h3>{t.base}</h3><span aria-hidden="true">↗</span></div><p class="quote-note">{t.priceNote}</p><ul>{t.includes.map(x => <li><span aria-hidden="true">✓</span>{x}</li>)}</ul><a class="button button-lime" href={wa}>{t.estimate}<span aria-hidden="true">↗</span></a></article><div class="quote-explained">{[[t.timeTitle, t.timeText], [t.extraTitle, t.extraText], [t.upkeepTitle, t.upkeepText]].map(([title, desc], i) => <div><span aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{desc}</p></div>)}</div></div></div></section>

  <section class="section wrap about" aria-labelledby="about-title"><div class="about-copy"><p class="eyebrow">{t.aboutKicker}</p><h2 id="about-title">{t.aboutTitle}</h2><p>{t.aboutText}</p><a class="text-link" href={`mailto:${c.site.email}`}>{c.site.email}<span aria-hidden="true">↗</span></a></div><div class="experience">{t.credentials.map(([title, desc]) => <div><h3>{title}</h3><p>{desc}</p></div>)}</div><aside class="technical"><span aria-hidden="true">↳</span><div><h3>{t.buildTitle}</h3><p>{t.buildText}</p></div></aside></section>

  <section class="faq section wrap" aria-labelledby="faq-title"><div><p class="eyebrow">{t.faqKicker}</p><h2 id="faq-title">{t.faqTitle}</h2></div><div class="questions">{t.faqs.map(([q, a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>

  <section class="contact section" id="contacto" aria-labelledby="contact-title"><div class="wrap"><p class="eyebrow">{t.contactKicker}</p><div class="contact-grid"><h2 id="contact-title">{t.contactTitle[0]}<span>{t.contactTitle[1]}</span></h2><div><p>{t.contactText}</p><a class="button button-lime" href={wa}>{t.whatsapp}<span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${c.site.email}`}>{t.email}<span aria-hidden="true">↗</span></a><p class="phone">{t.call} <a href={TELEFONO.tel}>{TELEFONO.humano}</a></p></div></div></div></section>

  <footer class="footer wrap"><div><a class="footer-name" href={rutas[lang]}>Sergio García<span aria-hidden="true">↗</span></a><p>{t.footer}</p></div><a class="text-link" href="#arriba">{t.top}<span aria-hidden="true">↑</span></a>{lang === 'es' && <nav class="footer-nav" aria-label="Servicios y zonas"><div><strong>Servicios</strong>{SERVICIOS.map(s => <a href={`/${s.slug}/`}>{s.nombre}</a>)}</div><div><strong>Zonas</strong>{ZONAS.map(z => <a href={`/${z.slug}/`}>Diseño web en {z.nombre}</a>)}</div></nav>}<div class="footer-bottom"><span>© {new Date().getFullYear()} Sergio García Ortiz</span><a href={`mailto:${c.site.email}`}>{c.site.email}</a><a href={TELEFONO.tel}>{TELEFONO.humano}</a></div></footer>
</div>

<style>
  .studio { --paper: #f7f7f0; --ink: #1c2c2b; --muted: #596361; --line: #d5dbcf; --lime: #d6f16b; font-family: 'Manrope', 'Inter', ui-sans-serif, system-ui, sans-serif; background: var(--paper); color: var(--ink); font-size: 16px; line-height: 1.6; }
  .studio * { box-sizing: border-box; }
  @keyframes studio-enter { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes studio-reveal { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > .eyebrow, .hero-copy > h1, .hero-copy > .hero-intro, .hero-copy > .hero-actions, .hero-copy > .hero-facts, .hero-showcase {
      animation: studio-enter .72s cubic-bezier(.16, 1, .3, 1) both;
    }
    .hero-copy > h1 { animation-delay: .08s; }
    .hero-copy > .hero-intro { animation-delay: .16s; }
    .hero-copy > .hero-actions { animation-delay: .24s; }
    .hero-copy > .hero-facts { animation-delay: .32s; }
    .hero-showcase { animation-delay: .18s; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .studio .section {
        animation: studio-reveal linear both;
        animation-timeline: view();
        animation-range: entry 8% entry 42%;
      }
    }
  }
  .studio :global(a:focus-visible), .studio :global(summary:focus-visible) { outline: 3px solid #698322; outline-offset: 5px; border-radius: 3px; }
  .studio :global(::selection) { background: var(--lime); color: var(--ink); }
  .studio :global([id]) { scroll-margin-top: 28px; }
  .wrap { width: min(1280px, calc(100% - 96px)); margin-inline: auto; }
  .section { padding-block: 112px; }
  .eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: .12em; font-weight: 750; display: flex; align-items: center; gap: 10px; margin: 0 0 24px; }
  h1, h2, h3, h4, p { margin: 0; }
  h2 { font-size: clamp(36px, 4.1vw, 58px); line-height: 1.08; letter-spacing: -.055em; font-weight: 650; max-width: 760px; text-wrap: balance; }
  h3 { font-weight: 650; letter-spacing: -.035em; line-height: 1.18; }
  .skip { position: absolute; top: -100px; left: 20px; z-index: 100; padding: 14px 20px; background: var(--ink); color: white; }
  .skip:focus { top: 12px; }
  .masthead { min-height: 104px; display: flex; align-items: center; justify-content: space-between; gap: 32px; border-bottom: 1px solid var(--line); }
  .identity { display: flex; align-items: center; gap: 13px; font-size: 16px; font-weight: 750; letter-spacing: -.035em; line-height: 1.3; flex-shrink: 0; }
  .identity-sub { display: block; font-size: 9px; font-weight: 500; letter-spacing: .045em; margin-top: 4px; }
  .monogram { display: flex; position: relative; align-items: center; justify-content: center; font-size: 29px; line-height: 1; letter-spacing: -.095em; width: 44px; height: 44px; border: 1px solid var(--ink); border-radius: 50%; padding-right: 3px; }
  .monogram span { position: absolute; font-size: 15px; right: -3px; top: -5px; background: var(--paper); }
  .desktop-nav { display: flex; gap: 25px; font-size: 12px; font-weight: 600; }
  .mobile-nav { display: none; }
  @media (max-width: 900px) { .mobile-nav { display: flex; justify-content: space-between; gap: 10px; padding-block: 12px; border-bottom: 1px solid var(--line); font-size: 10px; font-weight: 650; } .mobile-nav a { padding-block: 5px; } }
  .desktop-nav a, .languages a { transition: opacity .2s; }
  .desktop-nav a:hover, .languages a:hover { opacity: .6; }
  .nav-end { display: flex; align-items: center; gap: 27px; }
  .languages { display: flex; gap: 12px; font-size: 10px; font-weight: 700; }
  .languages a { padding-block: 12px; color: var(--muted); }
  .languages a[aria-current] { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
  .nav-contact { display: flex; gap: 25px; align-items: center; font-weight: 650; font-size: 12px; border: 1px solid var(--ink); border-radius: 6px; padding: 11px 16px; }
  .nav-contact:hover { background: var(--ink); color: var(--paper); }
  .hero { display: grid; grid-template-columns: 1.04fr 1fr; gap: 56px; align-items: center; padding-block: 76px 80px; }
  .status-dot { width: 7px; height: 7px; background: #658233; border-radius: 50%; display: inline-block; }
  .hero h1 { font-size: clamp(56px, 6.45vw, 92px); line-height: .99; letter-spacing: -.068em; font-weight: 650; margin: 32px 0; }
  .hero h1 span { display: block; }
  .hero h1 .hero-lead { font-size: .49em; line-height: 1.17; letter-spacing: -.045em; margin-bottom: 8px; }
  .hero-em { color: #6a8038; }
  .hero-intro { max-width: 480px; font-size: 15px; line-height: 1.75; color: var(--muted); }
  .hero-actions { display: flex; align-items: center; gap: 24px; margin-top: 32px; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 24px; padding: 16px 21px; font-size: 12px; font-weight: 750; border-radius: 6px; transition: background .2s, transform .2s; min-height: 52px; }
  .button:hover { transform: translateY(-3px); }
  .button span { font-size: 21px; font-weight: 400; line-height: 1; }
  .button-dark { background: var(--ink); color: var(--paper); }
  .button-dark:hover { background: #33433d; }
  .button-lime { background: var(--lime); color: var(--ink); }
  .button-lime:hover { background: #e3ff89; }
  .text-link { display: inline-flex; align-items: center; gap: 18px; font-size: 12px; font-weight: 700; padding-block: 12px; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .text-link span { font-size: 19px; font-weight: 400; }
  .hero-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 25px; font-size: 10px; color: var(--muted); }
  .hero-facts strong { font-weight: 750; color: var(--ink); }
  .hero-facts span { border-left: 1px solid #b8c0b3; padding-left: 14px; }
  .hero-showcase { background: #dce2d4; padding: 24px 25px; border-radius: 8px; display: flex; flex-direction: column; justify-content: space-between; min-height: 450px; overflow: hidden; }
  .showcase-top { display: flex; align-items: center; justify-content: space-between; font-size: 9px; letter-spacing: .1em; font-weight: 700; }
  .showcase-top > span:last-child { font-size: 25px; line-height: 1; }
  .desktop-screen { margin: 30px -5px 28px 7px; border: 1px solid #b1bbae; border-radius: 6px; overflow: hidden; background: white; box-shadow: 0 18px 30px -15px #20302645; transform: rotate(-3deg); transition: transform .5s; }
  .hero-showcase:hover .desktop-screen { transform: rotate(0deg); }
  .screen-bar { height: 23px; background: #f9faf7; border-bottom: 1px solid #e2e6db; display: flex; align-items: center; gap: 4px; padding-inline: 10px; position: relative; }
  .screen-bar i { width: 4px; height: 4px; border-radius: 50%; background: #cbd1c7; }
  .screen-bar span { position: absolute; width: 100%; left: 0; text-align: center; font-size: 7px; color: #65725c; }
  .desktop-screen img, .case-browser img { display: block; width: 100%; height: auto; }
  .showcase-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .showcase-bottom strong { display: block; font-size: 14px; font-weight: 650; letter-spacing: -.03em; }
  .showcase-bottom small { display: block; font-size: 9px; margin-top: 6px; color: #536047; }
  .round-arrow { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #adb7a3; border-radius: 50%; font-size: 20px; }
  .promise-bar { background: var(--ink); color: var(--paper); }
  .promises { display: flex; align-items: center; justify-content: space-between; padding-block: 23px; gap: 20px; font-size: 11px; }
  .promises span { display: flex; align-items: center; gap: 13px; }
  .promises i { font-style: normal; color: var(--lime); font-size: 19px; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 65px; margin-bottom: 52px; }
  .section-head > p { max-width: 340px; color: var(--muted); font-size: 14px; line-height: 1.8; }
  .case { display: grid; grid-template-columns: 1.05fr 1fr; gap: 68px; align-items: center; }
  .case-visual { background: #e6e9de; border-radius: 8px; padding: 25px 30px 20px; overflow: hidden; }
  .case-visual-label { display: flex; align-items: center; justify-content: space-between; font-size: 10px; font-weight: 700; }
  .case-visual-label > span:first-child { border: 1px solid #a7b69b; border-radius: 100px; padding: 5px 11px; }
  .case-visual-label > span:last-child { font-size: 22px; }
  .case-browser { margin-top: 27px; border-radius: 5px; overflow: hidden; border: 1px solid #c2ccba; box-shadow: 0 14px 22px -14px #26372d50; }
  .case-visual > p { margin-top: 17px; font-size: 10px; color: var(--muted); }
  .case-copy h3 { font-size: clamp(30px, 3vw, 43px); max-width: 430px; }
  .case-intro { font-size: 14px; color: var(--muted); margin-top: 22px; }
  .case-copy dl { margin: 27px 0 14px; }
  .case-copy dl > div { border-top: 1px solid var(--line); padding: 15px 0; }
  .case-copy dt { font-size: 12px; font-weight: 750; display: flex; gap: 14px; }
  .case-copy dt span { color: #6e7b63; font-size: 10px; padding-top: 2px; }
