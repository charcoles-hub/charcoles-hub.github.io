---
import Layout from '../../layouts/Layout.astro';
import FormResena from '../../components/FormResena.astro';
import { contenido } from '../../config/site';
const f = contenido.en.formulario;
const paginas = { es: '/resena/', en: '/en/review/', ca: '/ca/ressenya/' };
---
<Layout lang="en" titulo={f.titulo} descripcion={f.descripcion} paginas={paginas} noindex>
  <FormResena lang="en" />
</Layout>
