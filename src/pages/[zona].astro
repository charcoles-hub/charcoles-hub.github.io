---
import { ZONAS } from '../config/zonas';
import type { Servicio } from '../config/servicios';
import { contenido } from '../config/site';
import Layout from '../layouts/Layout.astro';
import PaginaLarga from '../components/PaginaLarga.astro';

export function getStaticPaths() {
  return ZONAS.map((s) => ({ params: { zona: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servicio };
const { site } = contenido.es;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const zonaLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Diseño web en ${s.nombre}`,
  description: s.descripcion,
  serviceType: 'Diseño de páginas web',
  provider: { '@type': 'ProfessionalService', name: site.nombre, telephone: '+34620650597' },
  areaServed: { '@type': 'Place', name: s.nombre },
  url: new URL(`/${s.slug}/`, Astro.site).href,
};
---
<Layout
  lang="es"
  titulo={s.titulo}
  descripcion={s.descripcion}
  paginas={{ es: `/${s.slug}/`, en: '/en/' }}
  datos={[zonaLd, faqLd]}
>
  <PaginaLarga s={s} />
</Layout>
