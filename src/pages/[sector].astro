---
import { SECTORES, type Sector } from '../config/sectores';
import Layout from '../layouts/Layout.astro';
import PaginaSector from '../components/PaginaSector.astro';

export function getStaticPaths() {
  return SECTORES.map((s) => ({ params: { sector: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Sector };
const url = new URL(`/${s.slug}/`, Astro.site).href;
const migas = [
  { nombre: 'Sectores', url: '/#sectores' },
  { nombre: s.nombre, url: `/${s.slug}/` },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
  })),
};

const servicioLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#servicio`,
  name: s.h1,
  description: s.descripcion,
  serviceType: 'Diseño de páginas web',
  audience: { '@type': 'BusinessAudience', name: s.publico },
  provider: { '@id': new URL('/#negocio', Astro.site).href },
  areaServed: { '@type': 'Country', name: 'España' },
  url,
};
---
<Layout lang="es" titulo={s.titulo} descripcion={s.descripcion} paginas={{ es: `/${s.slug}/` }} datos={[servicioLd, faqLd]} migas={migas}>
  <PaginaSector s={s} migas={migas} />
</Layout>
