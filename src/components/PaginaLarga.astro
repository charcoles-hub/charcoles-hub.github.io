---
import type { Servicio } from '../config/servicios';
import { whatsapp } from '../config/comun';
import Cabecera from './Cabecera.astro';
import Migas from './Migas.astro';
import CasoReal from './CasoReal.astro';
import Preguntas from './Preguntas.astro';
import Relacionados from './Relacionados.astro';
import Contacto from './Contacto.astro';
import Pie from './Pie.astro';
import BarraMovil from './BarraMovil.astro';
import Whatsapp from './iconos/Whatsapp.astro';

interface Props {
  s: Servicio;
  /** Migas de la página, sin la portada. */
  migas: { nombre: string; url: string }[];
  /** «Servicio» o «Zona»: cambia la etiqueta de la primera pantalla. */
  tipo: 'servicio' | 'zona';
}
const { s, migas, tipo } = Astro.props;
const waTexto = tipo === 'zona'
  ? `Hola Sergio, tengo un negocio en ${s.nombre} y me gustaría hablar contigo sobre una web.`
  : `Hola Sergio, me gustaría hablar contigo sobre ${s.nombre.toLowerCase()}.`;
const wa = whatsapp(waTexto);
const nav = [
  { texto: 'Trabajo', href: '/#trabajo' },
  { texto: 'Servicios', href: '/#servicios' },
  { texto: 'Sectores', href: '/#sectores' },
  { texto: 'Revisión gratis', href: '/revision-web-gratis/' },
];
---

<Cabecera lang="es" nav={nav} />

<main id="contenido">
  <section class="intro wrap" aria-labelledby="titulo-pagina">
    <Migas migas={migas} />
    <div class="intro__rejilla">
      <div>
        <p class="etiqueta etiqueta--linea entra">{tipo === 'zona' ? `Diseño web · ${s.nombre}` : `${s.nombre} · Toda España`}</p>
        <h1 id="titulo-pagina" class="titulo-xl entra" style="--orden:1">{s.h1}</h1>
        <p class="entradilla entra" style="--orden:2">{s.bajada}</p>
        <div class="intro__acciones entra" style="--orden:3">
          <a class="boton boton--oscuro" href={wa}><Whatsapp />Cuéntame tu proyecto</a>
          <a class="boton boton--borde" href="#incluye">Ver qué incluye<span class="icono icono--abajo" aria-hidden="true"></span></a>
        </div>
      </div>
      <aside class="nota entra" style="--orden:2" aria-label="Resumen">
        <span class="nota__etiqueta">En resumen</span>
        <p class="nota__texto">{s.resumen}</p>
        <div class="nota__pie"><span>Trato directo</span><span>Presupuesto por escrito</span></div>
      </aside>
    </div>
  </section>

  <section class="seccion seccion--tinte" id="incluye" aria-labelledby="titulo-incluye">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">El alcance</p>
        <h2 id="titulo-incluye" class="titulo-l">{s.incluyeTitular}</h2>
        <p>Definimos lo necesario antes de empezar. Si el proyecto necesita algo adicional, lo hablamos y queda reflejado en el presupuesto.</p>
      </div>
      <ol class="lista-num">
        {s.incluye.map((linea, i) => <li data-revela><span>0{i + 1}</span><p>{linea}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion" aria-label="Datos principales">
    <div class="wrap">
      <ul class="cifras">
        {s.datos.map((d) => <li data-revela><strong>{d.cifra}</strong><span>{d.texto}</span></li>)}
      </ul>
    </div>
  </section>

  <CasoReal />

  <section class="seccion" aria-labelledby="titulo-proceso">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">Sin sorpresas</p>
        <h2 id="titulo-proceso" class="titulo-l">Claro antes, durante y <em>después</em>.</h2>
      </div>
      <div class="proceso-texto" data-revela>
        <p class="entradilla">Primero hablamos de lo que debe conseguir la web. Como cada negocio necesita algo distinto, preparo el alcance, el calendario y el presupuesto a medida. Lo recibes todo por escrito antes de decidir.</p>
        <a class="enlace" href={wa}>Pide una propuesta a medida<span class="icono" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <section class="seccion seccion--tinte" aria-labelledby="titulo-faq">
    <div class="wrap dos">
      <div data-revela>
        <p class="etiqueta etiqueta--linea">Preguntas frecuentes</p>
        <h2 id="titulo-faq" class="titulo-l">Las dudas habituales, <em>respondidas</em>.</h2>
      </div>
      <Preguntas preguntas={s.faq} />
    </div>
  </section>

  <Relacionados actual={s.slug} />

  <Contacto lang="es" titulo="Hablemos de una web *a tu altura*." waTexto={waTexto} />
</main>

<Pie lang="es" />
<BarraMovil lang="es" waTexto={waTexto} />

<style>
  .proceso-texto { display: grid; gap: 22px; justify-items: start; }
</style>
