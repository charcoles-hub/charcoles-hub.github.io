---
import { contenido, rutas, type Lang } from '../config/site';
const { lang } = Astro.props as { lang: Lang };
const g = contenido[lang].gracias;
---
<section class="grid min-h-[80svh] place-items-center px-6 py-24 md:px-12">
  <div class="flex max-w-[46ch] flex-col items-start gap-6">
    <span class="grid size-12 place-items-center rounded-full bg-acento font-display text-2xl font-extrabold text-fondo" aria-hidden="true">✓</span>
    <h1 class="font-display text-4xl font-extrabold leading-[0.95] tracking-[-0.04em] text-balance md:text-6xl" style="font-stretch:110%">
      {g.titular}
    </h1>
    <p class="text-pretty text-medio md:text-lg">{g.texto}</p>
    <a href={rutas[lang]} class="boton boton--borde">← {g.volver}</a>
  </div>
</section>
