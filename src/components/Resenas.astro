---
import { contenido, RESENAS, type Lang } from '../config/site';
const { lang } = Astro.props as { lang: Lang };
const txt = contenido[lang].resenas;
const hay = RESENAS.length > 0;
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-US', { month: 'long', year: 'numeric' });
---
<section id="resenas" class="lejos resenas border-t border-linea px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto flex max-w-6xl flex-col gap-10">
    <div class="flex flex-col gap-4">
      <p data-revela class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-acento">{txt.eyebrow}</p>
      <h2
        data-revela
        class="font-display text-4xl font-extrabold leading-[0.95] tracking-[-0.04em] text-balance md:text-6xl"
        style="font-stretch:110%"
      >
        {hay ? txt.titular : txt.titularVacio}
      </h2>
      <p data-revela class="max-w-[52ch] text-pretty text-medio md:text-lg">{hay ? txt.texto : txt.textoVacio}</p>
    </div>

    {hay ? (
      <ul class="cartas grid gap-4 md:grid-cols-2 lg:grid-cols-3" role="list">
        {RESENAS.map((r, n) => {
          const cita = lang === 'en' && r.textoEn ? r.textoEn : r.texto;
          const traducida = lang === 'en' && !!r.textoEn;
          return (
            <li class="carta" style={`--i:${n % 3}`}>
              <span class="carta__comilla" aria-hidden="true">&ldquo;</span>
              <p class="estrellas-fijas" style={`--n:${r.estrellas}`} aria-label={txt.deCinco(r.estrellas)}>
                <span class="estrellas-fijas__base" aria-hidden="true">★★★★★</span>
                <span class="estrellas-fijas__relleno" aria-hidden="true">★★★★★</span>
              </p>
              <blockquote
                class="text-pretty font-display text-lg leading-[1.35] tracking-[-0.02em] text-tinta md:text-xl"
                style="font-stretch:105%"
                lang={traducida ? 'en' : 'es'}
              >
                {cita}
              </blockquote>
              <footer class="mt-auto flex flex-col gap-0.5 border-t border-linea pt-4">
                <span class="text-sm font-semibold text-tinta">
                  {r.url ? (
                    <a href={r.url} target="_blank" rel="noopener" class="underline decoration-linea decoration-2 underline-offset-4 transition-colors hover:decoration-acento">
                      {r.autor} <span class="text-acento">↗</span>
                    </a>
                  ) : (
                    r.autor
                  )}
                </span>
                <span class="text-[0.68rem] uppercase tracking-[0.1em] text-tenue">{r.cargo}</span>
                <span class="text-[0.68rem] text-tenue">
                  {fmt.format(new Date(r.fecha))}{traducida ? ` · ${txt.traducida}` : ''}
                </span>
              </footer>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="estrellas-grandes" style="--n:5" aria-hidden="true">
        <span class="estrellas-fijas__base">★★★★★</span>
        <span class="estrellas-fijas__relleno">★★★★★</span>
      </p>
    )}

    <div data-revela class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="max-w-[52ch] text-pretty text-sm text-tenue">{txt.nota}</p>
      <a href={txt.href} class="boton boton--primario boton--brillo shrink-0">{txt.cta}</a>
    </div>
  </div>
</section>
