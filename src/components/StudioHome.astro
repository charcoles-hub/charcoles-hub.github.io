---
import { Image } from 'astro:assets';
import { contenido, rutas, RESENAS, type Lang } from '../config/site';
import { studio } from '../config/studio';
import { SECTORES } from '../config/sectores';
import { COMUN, enfasis, whatsapp } from '../config/comun';
import { poster, fotoSergio } from '../config/posters';
import Cabecera from './Cabecera.astro';
import Contacto from './Contacto.astro';
import Pie from './Pie.astro';
import BarraMovil from './BarraMovil.astro';
import Whatsapp from './iconos/Whatsapp.astro';

const { lang } = Astro.props as { lang: Lang };
const t = studio[lang];
const c = contenido[lang];
const fisio = poster('fisioymes-full');
const wa = whatsapp(COMUN[lang].waTexto);
const conSectores = lang !== 'en';
const hreflangEs = lang === 'es' ? undefined : 'es';
const hayResenas = RESENAS.length > 0;
const formatoFecha = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : lang === 'ca' ? 'ca-ES' : 'es-ES', { month: 'long', year: 'numeric' });
const nav = t.nav.map(([texto, href]) => ({ texto, href }));
---

<Cabecera lang={lang} nav={nav} idiomas={rutas} />

<main id="contenido">
  <section class="portada wrap" aria-labelledby="titulo-portada">
    <div class="portada__texto">
      <p class="disponible entra"><span class="punto" aria-hidden="true"></span>{t.disponible}</p>
      <h1 id="titulo-portada" class="titulo-xl entra" style="--orden:1" set:html={enfasis(t.h1)} />
      <p class="entradilla entra" style="--orden:2">{t.intro}</p>
      <div class="portada__acciones entra" style="--orden:3">
        <a class="boton boton--oscuro" href={wa}><Whatsapp />{t.ctaPrincipal}</a>
        <a class="boton boton--borde" href={t.ctaSecundario.href} hreflang={t.ctaSecundario.href.startsWith('/') ? hreflangEs : undefined}>
          {t.ctaSecundario.texto}<span class:list={['icono', { 'icono--abajo': t.ctaSecundario.href.startsWith('#') }]} aria-hidden="true"></span>
        </a>
      </div>
      <ul class="portada__datos entra" style="--orden:4">
        {t.datos.map((d) => <li><span class="icono icono--check" aria-hidden="true"></span>{d}</li>)}
      </ul>
    </div>

    <a class="portada__visual entra" style="--orden:2" href="#caso-fisioymes">
      <div class="marco">
        <div class="marco__barra" aria-hidden="true"><i></i><i></i><i></i><span>fisioymes.com</span></div>
        <Image src={fisio} width={1120} height={760} fit="cover" position="top" format="webp" quality={82} widths={[560, 840, 1120]} sizes="(min-width: 1000px) 46vw, 92vw" alt="" loading="eager" fetchpriority="high" />
      </div>
      <span class="chip portada__chip portada__chip--arriba" aria-hidden="true"><span class="punto"></span>{t.heroChip}</span>
      <span class="chip portada__chip portada__chip--abajo" aria-hidden="true">{t.heroIdiomas}</span>
      <span class="portada__pie"><span><strong>{t.heroPie[0]}</strong>{t.heroPie[1]}</span><span class="icono icono--abajo" aria-hidden="true"></span></span>
    </a>
  </section>

  <section class="seccion" id="trabajo" aria-labelledby="titulo-trabajo">
    <div class="wrap">
      <div class="cabeza" data-revela>
        <div>
          <p class="etiqueta etiqueta--linea">{t.trabajoEtiqueta}</p>
          <h2 id="titulo-trabajo" class="titulo-l" set:html={enfasis(t.trabajoTitulo)} />
        </div>
        <p>{t.trabajoIntro}</p>
      </div>

      <article class="caso" id="caso-fisioymes" aria-labelledby="titulo-caso">
        <div class="caso__visual" data-revela>
          <a class="marco caso__marco" href={c.destacado.url} hreflang={hreflangEs} aria-label={`${t.caso.verCaso}: Fisioymés`}>
            <div class="marco__barra" aria-hidden="true"><i></i><i></i><i></i><span>fisioymes.com</span></div>
            <div class="caso__pantalla">
              <Image src={fisio} width={1100} format="webp" quality={72} widths={[560, 820, 1100]} sizes="(min-width: 1000px) 50vw, 92vw" alt={t.caso.alt} loading="lazy" />
            </div>
          </a>
          <p class="caso__pista">{t.caso.pista}</p>
        </div>
        <div class="caso__texto">
          <p class="etiqueta">{t.caso.etiqueta}</p>
          <h3 id="titulo-caso" class="titulo-m">{t.caso.titulo}</h3>
          <p class="caso__intro">{t.caso.intro}</p>
          <div class="caso__enlaces">
            <a class="boton boton--oscuro" href={c.destacado.url} hreflang={hreflangEs}>{t.caso.verCaso}<span class="icono" aria-hidden="true"></span></a>
            <a class="enlace" href="https://fisioymes.com/" target="_blank" rel="noopener">{t.caso.verWeb}<span class="icono" aria-hidden="true"></span></a>
          </div>
        </div>
      </article>

      {hayResenas && (
        <section class="testimonio seccion--oscura" id="resenas" aria-labelledby="titulo-resenas">
          <div class="testimonio__cabeza">
            <div>
              <p class="etiqueta etiqueta--linea">{c.resenas.eyebrow}</p>
              <h3 id="titulo-resenas" class="titulo-m">{c.resenas.titular}</h3>
            </div>
            <p>{c.resenas.texto}</p>
          </div>
          <ul class:list={['resenas', { 'resenas--unica': RESENAS.length === 1 }]}>
            {RESENAS.map((r) => (
              <li class="resena">
                <p class="resena__estrellas" aria-label={c.resenas.deCinco(r.estrellas)}>{'★'.repeat(r.estrellas)}<span aria-hidden="true">{'★'.repeat(5 - r.estrellas)}</span></p>
                <blockquote lang={lang === 'en' && r.textoEn ? 'en' : 'es'}>“{lang === 'en' && r.textoEn ? r.textoEn : r.texto}”</blockquote>
                <footer>
                  <strong>{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.autor}</a> : r.autor}</strong>
                  <span>{r.cargo} · {formatoFecha.format(new Date(r.fecha))}</span>
                </footer>
              </li>
            ))}
          </ul>
        </section>
      )}

      <details class="conceptos-resumen">
        <summary>{t.conceptos.etiqueta}: {t.conceptos.titulo}<span class="icono icono--mas" aria-hidden="true"></span></summary>
        <p>{t.conceptos.intro}</p>
        <ul>
          {c.proyectos.map((p) => (
            <li><a href={p.url} target="_blank" rel="noopener">{p.nombre}<small>{p.rubro.split(' · ')[0]} · {t.conceptos.marca}</small><span class="icono" aria-hidden="true"></span></a></li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  {conSectores && (
    <section class="seccion seccion--tinte" id="sectores" aria-labelledby="titulo-sectores">
      <div class="wrap">
        <div class="cabeza" data-revela>
          <div>
            <p class="etiqueta etiqueta--linea">{t.sectoresEtiqueta}</p>
            <h2 id="titulo-sectores" class="titulo-l" set:html={enfasis(t.sectoresTitulo)} />
          </div>
          <p>{t.sectoresIntro}</p>
        </div>
        <ul class="sectores-resumen">
          {SECTORES.map((s) => (
            <li><a href={`/${s.slug}/`} hreflang={hreflangEs}>{s.nombre}<span class="icono" aria-hidden="true"></span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="seccion" id="servicios" aria-labelledby="titulo-servicios">
    <div class="wrap">
      <div class="cabeza" data-revela>
        <div>
          <p class="etiqueta etiqueta--linea">{t.serviciosEtiqueta}</p>
          <h2 id="titulo-servicios" class="titulo-l" set:html={enfasis(t.serviciosTitulo)} />
        </div>
      </div>
      <ul class="servicios">
        {t.servicios.map(([titulo, texto, href], i) => (
          <li data-revela>
            <a class="tarjeta servicio" href={href} hreflang={hreflangEs}>
              <span class="servicio__num">0{i + 1}</span>
              <h3 class="titulo-m">{titulo}</h3>
              <p>{texto}</p>
              <span class="servicio__mas">{t.serviciosVer}<span class="icono" aria-hidden="true"></span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="seccion" id="sobre-mi" aria-labelledby="titulo-sobre">
    <div class="wrap sobre">
      <div class="sobre__texto" data-revela>
        <p class="etiqueta etiqueta--linea">{t.sobreEtiqueta}</p>
        <h2 id="titulo-sobre" class="titulo-l" set:html={enfasis(t.sobreTitulo)} />
        <p class="entradilla">{t.sobreTexto}</p>
        <a class="enlace" href={`mailto:${c.site.email}`}>{c.site.email}<span class="icono" aria-hidden="true"></span></a>
      </div>
      <div class="sobre__lado">
        {fotoSergio && (
          <Image class="sobre__foto" src={fotoSergio} width={640} height={760} fit="cover" format="webp" widths={[320, 640]} sizes="(min-width: 900px) 30vw, 80vw" alt={t.sobreFoto} loading="lazy" />
        )}
        <dl class="credenciales">
          {t.credenciales.map(([titulo, texto]) => <div data-revela><dt>{titulo}</dt><dd>{texto}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <Contacto lang={lang} />
</main>

<Pie lang={lang} />
<BarraMovil lang={lang} />

<style>
  /* ---- Portada ---- */
  .portada {
    display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: 40px clamp(40px, 5vw, 80px);
    align-items: center; padding-block: clamp(48px, 7vw, 104px) clamp(64px, 8vw, 120px);
  }
  .disponible {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: 28px;
    padding: 7px 14px 7px 12px; border: 1px solid var(--linea); border-radius: 999px; background: var(--blanco);
    font-size: 0.85rem; font-weight: 500; color: var(--tinta-2);
  }
  .portada h1 { font-size: clamp(3.2rem, 1.2rem + 5.6vw, 6.4rem); max-width: 10.5em; }
  .portada .entradilla { margin-top: 28px; max-width: 33em; }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .portada__datos { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 30px; list-style: none; font-size: 0.92rem; color: var(--tenue); }
  .portada__datos li { display: flex; align-items: center; gap: 8px; }
  .portada__datos .icono { color: var(--oliva); }

  .portada__visual { position: relative; display: block; padding: 28px 0 44px 24px; }
  .portada__visual::before {
    content: ''; position: absolute; inset: 0 -4% 12% 10%; z-index: -1; border-radius: 32px;
    background: radial-gradient(120% 90% at 80% 10%, #e3ead2 0%, var(--papel-3) 45%, transparent 75%);
  }
  .portada__visual .marco { transform: rotate(-1.6deg); transition: transform 0.8s var(--suave), box-shadow 0.8s var(--suave); }
  .portada__visual:hover .marco { transform: rotate(0deg) translateY(-6px); }
  .portada__visual img { aspect-ratio: 1120 / 760; object-fit: cover; object-position: top; }
  .portada__chip { position: absolute; z-index: 2; }
  .portada__chip--arriba { top: 6px; left: 0; }
  .portada__chip--abajo { right: -8px; bottom: 76px; }
  .portada__pie {
    position: absolute; left: 24px; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    font-size: 0.88rem; color: var(--tenue);
  }
  .portada__pie strong { margin-right: 8px; color: var(--tinta); font-weight: 600; }

  @media (max-width: 999px) {
    .portada { grid-template-columns: minmax(0, 1fr); }
    .portada__visual { max-width: 680px; }
  }
  @media (max-width: 600px) {
    .disponible { margin-bottom: 22px; font-size: 0.8rem; }
    .portada__acciones .boton { width: 100%; }
    .portada__visual { padding: 22px 0 40px 8px; }
    .portada__chip--abajo { right: -4px; bottom: 64px; }
    .portada__pie { left: 8px; font-size: 0.8rem; }
  }

  /* ---- Caso real ---- */
  .caso { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 48px clamp(40px, 6vw, 96px); align-items: center; }
  .caso__marco { display: block; }
  .caso__pantalla { aspect-ratio: 1100 / 820; overflow: hidden; }
  .caso__pantalla img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .caso__pantalla img { transition: object-position 9s cubic-bezier(0.45, 0, 0.35, 1); }
    .caso__marco:hover .caso__pantalla img, .caso__marco:focus-visible .caso__pantalla img { object-position: 50% 100%; transition-duration: 11s; }
  }
  .caso__pista { margin-top: 14px; font-size: 0.85rem; color: var(--tenue); }
  @media (hover: none) { .caso__pista { display: none; } }
  .caso__intro { margin-top: 20px; color: var(--tenue); font-size: 1.08rem; }
  .caso__enlaces { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 30px; }
  @media (max-width: 900px) { .caso { grid-template-columns: 1fr; } }

  /* ---- Reseña ligada al caso real ---- */
  .testimonio { margin-top: clamp(48px, 6vw, 80px); padding: clamp(28px, 5vw, 64px); border-radius: 28px; }
  .testimonio__cabeza { display: flex; align-items: end; justify-content: space-between; gap: 24px 48px; margin-bottom: 28px; }
  .testimonio__cabeza .etiqueta { margin-bottom: 12px; }
  .testimonio__cabeza > p { max-width: 22em; color: var(--tenue-oscuro); font-size: 0.92rem; }
  .resenas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; list-style: none; }
  .resenas--unica { grid-template-columns: minmax(0, 1fr); }
  .resena { display: flex; flex-direction: column; gap: 18px; padding-top: 24px; border-top: 1px solid var(--linea-oscura); }
  .resena blockquote { max-width: 37em; margin: 0; font-family: var(--serif); font-size: clamp(1.55rem, 1.1rem + 1.5vw, 2.25rem); line-height: 1.2; }
  .resena__estrellas { color: var(--lima); letter-spacing: 0.12em; }
  .resena__estrellas span { color: var(--linea-oscura); }
  .resena footer { display: grid; gap: 2px; margin-top: auto; font-size: 0.9rem; }
  .resena footer span { color: var(--tenue-oscuro); }
  .resena footer a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .testimonio__cabeza { display: block; } .testimonio__cabeza > p { margin-top: 12px; } .resenas { grid-template-columns: 1fr; } }

  /* ---- Conceptos opcionales ---- */
  .conceptos-resumen { margin-top: 30px; border-block: 1px solid var(--linea); }
  .conceptos-resumen summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 18px; font-weight: 600; }
  .conceptos-resumen summary .icono { transition: transform 0.3s var(--suave); }
  .conceptos-resumen[open] summary .icono { transform: rotate(45deg); }
  .conceptos-resumen > p { max-width: 48em; padding-bottom: 18px; color: var(--tenue); font-size: 0.95rem; }
  .conceptos-resumen ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; list-style: none; padding-bottom: 16px; }
  .conceptos-resumen a { display: flex; align-items: center; gap: 8px; padding-block: 12px; border-top: 1px solid var(--linea); font-weight: 600; }
  .conceptos-resumen a:hover { color: var(--oliva); }
  .conceptos-resumen a .icono { margin-left: auto; }
  .conceptos-resumen small { color: var(--tenue); font-size: 0.82rem; font-weight: 400; }
  @media (max-width: 700px) { .conceptos-resumen ul { grid-template-columns: 1fr; } .conceptos-resumen a { flex-wrap: wrap; } }

  /* ---- Sectores ---- */
  #sectores { padding-block: clamp(56px, 6vw, 88px); }
  #sectores .cabeza { margin-bottom: 28px; }
  .sectores-resumen { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; list-style: none; }
  .sectores-resumen a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 72px; padding: 14px 20px; border: 1px solid var(--linea); border-radius: var(--radio-s); background: var(--blanco); font-weight: 600; }
  .sectores-resumen a:hover { border-color: var(--linea-fuerte); color: var(--oliva); }
  @media (max-width: 900px) { .sectores-resumen { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sectores-resumen { grid-template-columns: 1fr; } .sectores-resumen a { min-height: 0; } }

  /* ---- Servicios ---- */
  .servicios { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; list-style: none; }
  .servicios li { display: flex; }
  .servicio { width: 100%; min-height: 240px; background: transparent; }
  .servicio:hover { background: var(--blanco); }
  .servicio__num { font-size: 0.85rem; font-weight: 600; color: var(--oliva); }
  .servicio h3 { margin-top: 20px; }
  .servicio p { max-width: 34em; color: var(--tenue); }
  .servicio__mas { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 6px; font-size: 0.92rem; font-weight: 600; }
  .servicio__mas .icono { transition: transform 0.35s var(--suave); }
  .servicio:hover .servicio__mas .icono { transform: translate(3px, -3px); }
  @media (max-width: 760px) { .servicios { grid-template-columns: 1fr; } .servicio { min-height: 0; } }

  /* ---- Sobre mí ---- */
  #sobre-mi { padding-top: clamp(24px, 3vw, 48px); }
  .sobre { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px clamp(40px, 7vw, 110px); align-items: start; }
  .sobre .entradilla { margin-block: 26px 18px; }
  .sobre__lado { display: grid; gap: 28px; }
  .sobre__foto { width: 100%; max-width: 420px; height: auto; border-radius: var(--radio); }
  .credenciales div { padding-block: 22px; border-bottom: 1px solid var(--linea); }
  .credenciales div:first-child { border-top: 1px solid var(--linea); }
  .credenciales dt { font-family: var(--serif); font-size: 1.6rem; line-height: 1.15; }
  .credenciales dd { margin-top: 6px; color: var(--tenue); }
  @media (max-width: 900px) { .sobre { grid-template-columns: 1fr; } }
</style>
