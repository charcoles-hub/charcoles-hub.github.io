---
import { Image } from 'astro:assets';
import { contenido, rutas, RESENAS, type Lang } from '../config/site';
import { studio } from '../config/studio';
import { SECTORES } from '../config/sectores';
import { COMUN, plano, whatsapp } from '../config/comun';
import { poster } from '../config/posters';
import Cabecera from './Cabecera.astro';
import Contacto from './Contacto.astro';
import Pie from './Pie.astro';
import BarraMovil from './BarraMovil.astro';
import Whatsapp from './iconos/Whatsapp.astro';

const { lang } = Astro.props as { lang: Lang };
const t = studio[lang];
const c = contenido[lang];
const fisio = poster('fisioymes-full');
const fisioMovil = poster('fisioymes-movil');
const wa = whatsapp(COMUN[lang].waTexto);
const conSectores = lang !== 'en';
const hreflangEs = lang === 'es' ? undefined : 'es';
const hayResenas = RESENAS.length > 0;
const formatoFecha = new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : lang === 'ca' ? 'ca-ES' : 'es-ES', { month: 'long', year: 'numeric' });
const nav = t.nav.map(([texto, href]) => ({ texto, href }));
const [abre, cierra] = lang === 'en' ? ['“', '”'] : ['«', '»'];

// Conceptos con captura. En castellano y catalán, uno por sector (enlazan a la
// página del sector); en inglés, los conceptos en inglés (enlazan a la demo).
// Todos se declaran conceptos: el único cliente real es Fisioymés.
const tarjetas = conSectores
  ? SECTORES.map((s) => ({ href: `/${s.slug}/`, titulo: s.nombre, demo: s.demo.nombre, imagen: poster(s.demo.slug), externo: false }))
  : c.proyectos.map((p) => ({ href: p.url, titulo: p.rubro.split(' · ')[0], demo: p.nombre, imagen: poster(p.slug), externo: true }));
const enTarjetas = new Set(conSectores ? SECTORES.map((s) => s.demo.slug) : c.proyectos.map((p) => p.slug));
const otrosConceptos = c.proyectos.filter((p) => !enTarjetas.has(p.slug));
---

<Cabecera lang={lang} nav={nav} idiomas={rutas} sobre />

<main id="contenido">
  {/* 1 · Portada: la ciudad en tiempo real y el titular enorme */}
  <section class="portada" data-portada aria-labelledby="titulo-portada">
    <canvas class="portada__ciudad" data-noche aria-hidden="true"></canvas>
    <div class="portada__velo" aria-hidden="true"></div>
    <div class="wrap portada__contenido" data-portada-contenido>
      <h1 id="titulo-portada" class="titulo-xl portada__titulo" data-titulo-portada>{plano(t.h1)}</h1>
      <div class="portada__pie">
        <p class="portada__intro" data-sube>{t.intro}</p>
        <div class="portada__acciones" data-sube>
          <a class="boton boton--oscuro" href={wa} data-iman><Whatsapp />{t.ctaPrincipal}</a>
          <a class="boton boton--borde" href={t.ctaSecundario.href} hreflang={t.ctaSecundario.href.startsWith('/') ? hreflangEs : undefined}>
            {t.ctaSecundario.texto}{t.ctaSecundario.href.startsWith('#') && <span class="icono icono--abajo" aria-hidden="true"></span>}
          </a>
        </div>
        <ul class="portada__datos" data-sube aria-label={t.datosTitulo}>
          {t.datos.map((d) => <li><span class="icono icono--check" aria-hidden="true"></span>{d}</li>)}
        </ul>
      </div>
    </div>
    <button class="portada__pausa" type="button" data-pausa-fondo hidden aria-pressed="false" data-pausar={t.fondoPausar} data-reanudar={t.fondoReanudar}>
      <span class="portada__pausa-icono" aria-hidden="true"></span><span class="sr-only" data-texto>{t.fondoPausar}</span>
    </button>
  </section>

  {/* 2 · Manifiesto y caso real anclado */}
  <section class="trabajo" id="trabajo" aria-labelledby="titulo-trabajo">
    <div class="wrap manifiesto">
      <h2 id="titulo-trabajo" class="titulo-l manifiesto__titulo" data-enciende>{plano(t.trabajoTitulo)}</h2>
      <p class="manifiesto__texto">{t.trabajoIntro}</p>
    </div>

    <div class="caso-anclado" data-caso>
      <article class="wrap caso" id="caso-fisioymes" aria-labelledby="titulo-caso">
        <a class="dispositivos" href={c.destacado.url} hreflang={hreflangEs} aria-label={`${t.caso.verCaso}: Fisioymés`} data-cursor={t.cursorVer}>
          <div class="portatil">
            <div class="portatil__tapa">
              <div class="portatil__pantalla" data-pantalla>
                <Image src={fisio} width={1100} format="webp" quality={74} widths={[700, 1100]} sizes="(min-width: 1000px) 46vw, 88vw" alt={t.caso.alt} loading="lazy" />
              </div>
            </div>
            <div class="portatil__base" aria-hidden="true"></div>
          </div>
          <div class="telefono">
            <div class="telefono__pantalla" data-pantalla>
              <Image src={fisioMovil} width={390} format="webp" quality={74} widths={[390]} sizes="220px" alt="" loading="lazy" />
            </div>
          </div>
        </a>
        <div class="caso__texto">
          <p class="etiqueta">{t.caso.etiqueta.split(' · ')[0]}: Fisioymés</p>
          <h3 id="titulo-caso" class="titulo-m">{t.caso.titulo}</h3>
          <div class="caso__recorrido">
            <span class="caso__progreso" data-caso-progreso aria-hidden="true"></span>
            <ol class="caso__pasos">
              {t.caso.pasos.map(([titulo, texto]) => <li data-paso><h4>{titulo}</h4><p>{texto}</p></li>)}
            </ol>
          </div>
          <div class="caso__enlaces">
            <a class="boton boton--oscuro" href={c.destacado.url} hreflang={hreflangEs} data-iman>{t.caso.verCaso}</a>
            <a class="enlace" href="https://fisioymes.com/" target="_blank" rel="noopener">{t.caso.verWeb}<span class="icono" aria-hidden="true"></span></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* 3 · La reseña, que se enciende palabra a palabra */}
  {hayResenas && (
    <section class="resena-grande" id="resenas" aria-labelledby="titulo-resenas">
      <div class="wrap">
        <h2 id="titulo-resenas" class="etiqueta">{c.resenas.titular}</h2>
        {RESENAS.map((r) => (
          <figure class="resena">
            <blockquote lang={lang === 'en' && r.textoEn ? 'en' : 'es'}>
              <p class="cita resena__texto" data-enciende>{abre}{lang === 'en' && r.textoEn ? r.textoEn : r.texto}{cierra}</p>
            </blockquote>
            <figcaption>
              <span class="resena__estrellas" role="img" aria-label={c.resenas.deCinco(r.estrellas)}>{'★'.repeat(r.estrellas)}</span>
              <strong>{r.url ? <a href={r.url} target="_blank" rel="noopener">{r.autor}</a> : r.autor}</strong>
              <span>{r.cargo}</span>
              <span>{formatoFecha.format(new Date(r.fecha))}</span>
            </figcaption>
          </figure>
        ))}
        <p class="resena__nota">{c.resenas.texto}</p>
      </div>
    </section>
  )}

  {/* 4 · Conceptos por sector: galería horizontal */}
  <section class="galeria" id={conSectores ? 'sectores' : 'conceptos'} data-galeria aria-labelledby="titulo-galeria">
    <div class="galeria__marco">
      <div class="wrap galeria__cabeza">
        <h2 id="titulo-galeria" class="titulo-l">{plano(conSectores ? t.sectoresTitulo : t.conceptos.titulo)}</h2>
        <div class="galeria__textos">
          <p>{conSectores ? t.sectoresIntro : t.conceptos.intro}</p>
          {conSectores && <p class="galeria__aviso">{t.conceptos.intro}</p>}
        </div>
      </div>
      <ul class="galeria__pista" data-pista>
        {tarjetas.map((s) => (
          <li class="pieza">
            <a class="pieza__enlace" href={s.href} hreflang={s.externo ? undefined : hreflangEs} target={s.externo ? '_blank' : undefined} rel={s.externo ? 'noopener' : undefined} data-cursor={t.cursorVer}>
              <span class="marco pieza__marco">
                <Image src={s.imagen} width={960} height={600} fit="cover" position="top" format="webp" quality={72} widths={[480, 720, 960]} sizes="(min-width: 1000px) 42vw, 82vw" alt="" loading="lazy" />
              </span>
              <span class="pieza__pie">
                <span class="pieza__titulo">{s.titulo}</span>
                <span class="pieza__demo">{t.conceptos.marca}: {s.demo}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  {otrosConceptos.length > 0 && (
    <div class="wrap conceptos__mas">
      <p>
        <strong>{t.conceptos.mas}:</strong>{' '}
        {otrosConceptos.map((p, i) => (
          <>
            <a href={p.url} target="_blank" rel="noopener">{p.nombre}</a> <span class="conceptos__rubro">({p.rubro.split(' · ')[0].toLowerCase()})</span>{i < otrosConceptos.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  )}

  {/* 5 · Servicios: índice tipográfico */}
  <section class="seccion servicios" id="servicios" aria-labelledby="titulo-servicios">
    <div class="wrap">
      <div class="cabeza">
        <h2 id="titulo-servicios" class="titulo-l">{plano(t.serviciosTitulo)}</h2>
      </div>
      <ul class="servicios__lista">
        {t.servicios.map(([titulo, texto, href]) => (
          <li class="servicio">
            <h3 class="servicio__titulo"><a href={href} hreflang={hreflangEs}>{titulo}</a></h3>
            <p class="servicio__texto">{texto}{t.serviciosIdioma && <span class="servicio__idioma"> ({t.serviciosIdioma})</span>}</p>
            <span class="icono icono--derecha servicio__flecha" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 6 · Proceso: tarjetas que se apilan (secuencia real, va numerada) */}
  <section class="seccion proceso" id="proceso" aria-labelledby="titulo-proceso">
    <div class="wrap">
      <div class="cabeza">
        <h2 id="titulo-proceso" class="titulo-l">{plano(t.procesoTitulo)}</h2>
      </div>
      <ol class="proceso__lista">
        {t.proceso.map(([titulo, texto], i) => (
          <li class="paso" data-apila style={`--i:${i}`}>
            <span class="paso__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="titulo-m">{titulo}</h3>
            <p>{texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 7 · Sobre mí */}
  <section class="seccion sobre" id="sobre-mi" aria-labelledby="titulo-sobre">
    <div class="wrap sobre__rejilla">
      <h2 id="titulo-sobre" class="titulo-l">{plano(t.sobreTitulo)}</h2>
      <div>
        <p class="cita sobre__manifiesto" data-enciende>{t.sobreTexto}</p>
        <ol class="trayectoria">
          {t.credenciales.map(([titulo, texto]) => <li><h3>{titulo}</h3><p>{texto}</p></li>)}
        </ol>
        <a class="enlace sobre__email" href={`mailto:${c.site.email}`}>{c.site.email}</a>
      </div>
    </div>
  </section>

  <Contacto lang={lang} />
</main>

<Pie lang={lang} />
<BarraMovil lang={lang} />

<style>
  /* ---- 1 · Portada ---- */
  .portada {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; align-items: end;
    min-height: max(100svh, 700px);
    padding-block: 150px clamp(36px, 6vh, 72px);
    background: radial-gradient(120% 80% at 50% 0%, #11141f, var(--noche) 70%);
  }
  .portada__ciudad { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s ease; }
  :global(.noche-viva) .portada__ciudad { opacity: 1; }
  .portada__velo {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgb(8 9 13 / 0.6) 0%, transparent 26%, transparent 42%, rgb(8 9 13 / 0.84) 76%, var(--noche) 100%);
  }
  .portada__titulo { max-width: 11em; }
  .portada__pie {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4.2fr) minmax(0, 2.8fr); gap: 28px 48px; align-items: end;
    margin-top: clamp(28px, 4.5vh, 56px); padding-top: 28px; border-top: 1px solid rgb(237 233 225 / 0.16);
  }
  .portada__intro { max-width: 31em; color: var(--luz-2); font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.15rem); }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: 12px; }
  .portada__datos { list-style: none; display: grid; gap: 8px; font-size: 0.95rem; color: var(--luz-2); }
  .portada__datos li { display: flex; align-items: center; gap: 10px; }
  .portada__datos .icono { color: var(--farola); }
  .portada__pausa {
    position: absolute; z-index: 3; top: 104px; right: var(--margen);
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1px solid rgb(237 233 225 / 0.22); border-radius: 50%; background: rgb(8 9 13 / 0.35); color: var(--luz-2);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .portada__pausa[hidden] { display: none; }
  .portada__pausa:hover { border-color: var(--luz); color: var(--luz); }
  .portada__pausa-icono { width: 12px; height: 12px; background: linear-gradient(to right, currentColor 0 35%, transparent 35% 65%, currentColor 65%); }
  .portada__pausa[aria-pressed='true'] .portada__pausa-icono { background: currentColor; clip-path: polygon(15% 0, 100% 50%, 15% 100%); }
  @media (max-width: 1100px) {
    .portada__pie { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .portada__intro { grid-column: 1 / -1; }
  }
  @media (max-width: 899px) { .portada__pausa { top: 128px; } }
  @media (max-width: 640px) {
    .portada { padding-top: 140px; }
    .portada__pie { grid-template-columns: minmax(0, 1fr); }
    .portada__acciones .boton { width: 100%; }
  }

  /* ---- 2 · Manifiesto y caso ---- */
  .trabajo { position: relative; padding-top: clamp(96px, 12vw, 190px); }
  .manifiesto { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 28px 64px; margin-bottom: clamp(40px, 6vw, 96px); }
  .manifiesto__titulo { grid-column: 1 / -1; font-size: clamp(3rem, 1rem + 8vw, 9.4rem); line-height: 0.88; letter-spacing: -0.055em; }
  .manifiesto__texto { grid-column: 2; max-width: 27em; color: var(--luz-2); font-size: 1.12rem; }
  @media (max-width: 900px) { .manifiesto { grid-template-columns: 1fr; } .manifiesto__texto { grid-column: 1; } }

  .caso-anclado { display: grid; align-items: center; min-height: 100svh; padding-block: 72px; }
  .caso { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px clamp(40px, 5vw, 100px); align-items: center; }
  .dispositivos { position: relative; display: block; padding: 0 9% 9% 0; }
  .portatil__tapa {
    position: relative; padding: 2.2% 2.2% 3%;
    border-radius: 22px 22px 8px 8px;
    background: linear-gradient(180deg, #2b2e37, #15171d);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.09), 0 60px 140px -50px rgb(0 0 0 / 0.95), 0 0 140px -40px rgb(255 178 74 / 0.22);
  }
  .portatil__tapa::before { content: ''; position: absolute; top: 0.9%; left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: #07080b; }
  .portatil__pantalla, .telefono__pantalla { position: relative; overflow: hidden; background: #fff; }
  .portatil__pantalla { aspect-ratio: 16 / 10; border-radius: 6px; }
  .portatil__pantalla :global(img), .telefono__pantalla :global(img) { width: 100%; height: auto; will-change: transform; }
  .portatil__pantalla::after, .telefono__pantalla::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(118deg, rgb(255 255 255 / 0.1) 0%, transparent 36%);
  }
  .portatil__base {
    position: relative; left: -7%; width: 114%; height: 15px; margin-top: -1px;
    border-radius: 0 0 26px 26px / 0 0 14px 14px;
    background: linear-gradient(180deg, #454852, #1d1f25 60%, #0d0e12);
    box-shadow: 0 34px 40px -22px rgb(0 0 0 / 0.95);
  }
  .portatil__base::before { content: ''; position: absolute; top: 0; left: 50%; width: 15%; height: 5px; margin-left: -7.5%; border-radius: 0 0 8px 8px; background: #17181d; }
  .telefono {
    position: absolute; right: 0; bottom: 0; width: 25%; padding: 6px;
    border-radius: 30px; background: linear-gradient(160deg, #353843, #111217);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), 0 44px 90px -30px rgb(0 0 0 / 0.95);
  }
  .telefono__pantalla { aspect-ratio: 9 / 19.5; border-radius: 24px; }
  .telefono__pantalla::before { content: ''; position: absolute; z-index: 2; top: 7px; left: 50%; width: 34%; height: 15px; margin-left: -17%; border-radius: 10px; background: #000; }
  .dispositivos:focus-visible { outline-offset: 8px; }

  .caso__texto .titulo-m { margin-bottom: 30px; }
  .caso__recorrido { position: relative; padding-left: 28px; border-left: 1px solid var(--linea-fuerte); }
  .caso__progreso { position: absolute; top: 0; left: -1px; width: 2px; height: 100%; background: var(--farola); transform-origin: top; }
  .caso__pasos { list-style: none; display: grid; gap: 26px; }
  .caso__pasos h4 { font-size: 1.12rem; font-weight: 580; letter-spacing: -0.01em; }
  .caso__pasos p { margin-top: 6px; color: var(--luz-2); }
  .caso__enlaces { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; margin-top: 36px; }
  @media (max-width: 999px) {
    .caso-anclado { min-height: 0; padding-block: 24px 0; }
    .caso { grid-template-columns: minmax(0, 1fr); }
  }

  /* ---- 3 · Reseña ---- */
  .resena-grande { position: relative; padding-block: clamp(110px, 13vw, 200px); }
  .resena-grande::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(50% 60% at 12% 30%, rgb(255 178 74 / 0.08), transparent 70%);
  }
  .resena-grande .etiqueta { margin-bottom: 36px; }
  .resena { margin: 0; }
  .resena blockquote { margin: 0; }
  .resena__texto { max-width: 23em; font-size: clamp(1.7rem, 1.05rem + 2.3vw, 3.4rem); line-height: 1.16; hanging-punctuation: first; }
  .resena figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; margin-top: 40px; color: var(--luz-2); }
  .resena__estrellas { color: var(--farola); letter-spacing: 0.14em; }
  .resena figcaption strong { color: var(--luz); font-weight: 600; }
  .resena figcaption a { display: inline-block; padding: 12px 4px; margin: -12px -4px; text-decoration: underline; text-decoration-color: var(--farola); text-underline-offset: 5px; }
  .resena__nota { margin-top: 18px; color: var(--tenue); font-size: 0.95rem; }

  /* ---- 4 · Galería de conceptos ---- */
  .galeria { position: relative; overflow: hidden; background: var(--noche-2); }
  .galeria__marco { display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: clamp(36px, 5vh, 64px); min-height: 100svh; padding-block: clamp(100px, 11vh, 140px) clamp(64px, 8vh, 110px); }
  .galeria__cabeza { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 64px; align-items: end; }
  .galeria__textos { display: grid; gap: 12px; max-width: 32em; color: var(--luz-2); }
  .galeria__aviso { color: var(--tenue); font-size: 0.95rem; }
  /* Sin movimiento (o sin JS) la pista se desliza en horizontal; con movimiento,
     el script la ancla y la mueve con el scroll (.galeria--anclada). */
  .galeria__pista {
    display: flex; gap: clamp(20px, 2.4vw, 36px); list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: var(--linea-fuerte) transparent;
    padding: 0 max(var(--margen), (100vw - var(--ancho)) / 2) 14px; scroll-padding-inline: max(var(--margen), (100vw - var(--ancho)) / 2);
  }
  :global(.galeria--anclada) .galeria__pista { width: max-content; overflow: visible; scroll-snap-type: none; padding-bottom: 0; }
  .pieza { flex: none; width: clamp(300px, 40vw, 640px); scroll-snap-align: start; }
  .pieza__enlace { display: block; }
  .pieza__marco { --c: var(--corte-l); }
  .pieza__marco :global(img) { aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 1.2s var(--ease-expo); }
  .pieza__enlace:hover .pieza__marco :global(img) { transform: scale(1.05); }
  .pieza__enlace:focus-visible { outline-offset: 6px; }
  .pieza__pie { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; margin-top: 18px; }
  .pieza__titulo { font-size: clamp(1.2rem, 1rem + 0.6vw, 1.6rem); font-weight: 520; letter-spacing: -0.02em; transition: color 0.3s ease; }
  .pieza__enlace:hover .pieza__titulo { color: var(--farola); }
  .pieza__demo { color: var(--tenue); font-size: 0.92rem; }
  .conceptos__mas { padding-block: 32px clamp(24px, 4vw, 48px); color: var(--luz-2); }
  .conceptos__mas a { display: inline-block; padding: 11px 4px; margin: -11px -4px; color: var(--luz); text-decoration: underline; text-decoration-color: var(--farola); text-underline-offset: 5px; }
  .conceptos__mas a:hover { color: var(--farola); }
  .conceptos__rubro { color: var(--tenue); }
  @media (max-width: 999px) {
    .galeria__marco { min-height: 0; }
    .galeria__cabeza { grid-template-columns: minmax(0, 1fr); }
    .galeria__pista { scrollbar-width: none; padding-inline: var(--margen); scroll-padding-inline: var(--margen); padding-bottom: 6px; }
    .galeria__pista::-webkit-scrollbar { display: none; }
    .pieza { width: 82vw; }
