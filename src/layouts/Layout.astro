---
import '../styles/global.css';
import { contenido, rutas, ogLocale, RESENAS, TELEFONO, type Lang } from '../config/site';

interface Props {
  lang: Lang;
  titulo?: string;
  descripcion?: string;
  /** Rutas equivalentes en cada idioma, para los hreflang. Por defecto, la portada. */
  paginas?: Partial<Record<Lang, string>>;
  noindex?: boolean;
  /** Datos estructurados propios de la página, además de los del negocio. */
  datos?: unknown[];
}
const { lang } = Astro.props;
const C = contenido[lang];
const {
  titulo = C.site.titulo,
  descripcion = C.site.descripcion,
  paginas = rutas,
  noindex = false,
  datos = [],
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site).href;

// Solo las páginas con versiones equivalentes en varios idiomas declaran hreflang.
// Las portadas y los formularios de reseña tienen esas versiones; servicios y
// zonas, de momento, solo existen en español.
const alternas = (Object.keys(paginas) as Lang[]).map((l) => ({
  codigo: l,
  href: new URL(paginas[l]!, Astro.site).href,
}));
const tieneAlternas = !noindex && alternas.length > 1;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: C.site.nombre,
  description: C.site.descripcion,
  url: canonica,
  image: new URL('/og.png', Astro.site).href,
  email: `mailto:${C.site.email}`,
  telephone: '+34620650597',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cornellà de Llobregat',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  areaServed: { '@type': 'Country', name: 'España' },
  founder: {
    '@type': 'Person',
    name: C.site.nombre,
    jobTitle: C.site.rol,
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Universitat Politècnica de Catalunya — EEBE',
    },
  },
  // Solo si hay reseñas reales: marcar valoraciones inventadas es penalizable
  // por Google, además de mentira. Con el array vacío no sale ni el campo.
  ...(RESENAS.length > 0 && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: (RESENAS.reduce((s, r) => s + r.estrellas, 0) / RESENAS.length).toFixed(1),
      reviewCount: RESENAS.length,
      bestRating: 5,
    },
    review: RESENAS.map((r) => ({
      '@type': 'Review',
      reviewBody: r.texto,
      datePublished: r.fecha,
      author: { '@type': 'Person', name: r.autor },
      reviewRating: { '@type': 'Rating', ratingValue: r.estrellas, bestRating: 5 },
    })),
  }),
};

// Favicon: la S sobre el acento, inline. Sin peticiones extra ni binarios.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#1b3fa0"/><text x="32" y="45" font-family="Inter,system-ui,sans-serif" font-size="38" font-weight="800" text-anchor="middle" fill="#ffffff">S</text></svg>`
  );
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f7f7f0" />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href={favicon} />
    <title>{titulo}</title>
    {noindex && <meta name="robots" content="noindex" />}

    {tieneAlternas && alternas.map((a) => <link rel="alternate" hreflang={a.codigo} href={a.href} />)}
    {tieneAlternas && paginas.es && <link rel="alternate" hreflang="x-default" href={new URL(paginas.es, Astro.site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;650;700;750;800&family=Inter:opsz,wght@14..32,400..800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {datos.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    {/* Hilo de lectura: CSS puro con scroll(). Donde no se soporte, no existe. */}
    <div class="progreso" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
  </body>
</html>
