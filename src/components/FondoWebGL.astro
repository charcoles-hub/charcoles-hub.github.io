---
// Fondo vivo de la portada: un shader a pantalla completa, escrito a mano en
// WebGL. Sin librería (three.js pesa ~600 kB y ya se retiró una vez por eso).
// Si no hay WebGL, o el visitante pide menos movimiento, el canvas ni se monta
// y la portada se queda como está: el fondo es decoración, nunca contenido.
---
<canvas id="fondo" aria-hidden="true"></canvas>

<script>
  const lienzo = document.getElementById('fondo') as HTMLCanvasElement | null;
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = lienzo?.getContext('webgl', {
    alpha: true,
    antialias: false,
    depth: false,
    stencil: false,
    powerPreference: 'low-power',
  });

  if (lienzo && gl) {
    const VERTICE = `
      attribute vec2 pos;
      void main() { gl_Position = vec4(pos, 0.0, 1.0); }
    `;

    const FRAGMENTO = `
      precision mediump float;
      uniform vec2 u_res;
      uniform float u_t;
      uniform vec2 u_raton;
      uniform float u_fuerza;

      float hash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
      }

      float ruido(vec2 p) {
        vec2 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
      }

      float fbm(vec2 p) {
        float v = 0.0, a = 0.5;
        mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
        for (int i = 0; i < 4; i++) {
          v += a * ruido(p);
          p = m * p;
          a *= 0.5;
        }
        return v;
      }

      void main() {
        vec2 uv = gl_FragCoord.xy / u_res;
        // Normalizado por el lado CORTO: si se normaliza por la altura, en un
        // móvil en vertical el mismo humo sale ampliado cuatro veces y tapa el
        // titular. Así el grano se mantiene del mismo tamaño en cualquier caja.
        vec2 p = (gl_FragCoord.xy - 0.5 * u_res) / min(u_res.x, u_res.y);

        // Humo: el dominio del ruido se deforma con más ruido, que es lo que
        // le da el hilado de las corrientes en vez de manchas redondas.
        vec2 q = vec2(fbm(p * 1.6 + u_t * 0.03), fbm(p * 1.6 + vec2(5.2, 1.3)));
        vec2 r = vec2(
          fbm(p * 1.6 + 3.0 * q + vec2(1.7, 9.2) + u_t * 0.05),
          fbm(p * 1.6 + 3.0 * q + vec2(8.3, 2.8) + u_t * 0.042)
        );
        float f = fbm(p * 1.6 + 3.5 * r);

        // La brasa vive donde apunta el puntero, con un rescoldo fijo abajo a
        // la izquierda para que el fondo nunca quede plano del todo.
        vec2 foco = mix(vec2(0.22, 0.18), u_raton, 0.55);
        float cerca = 1.0 - smoothstep(0.0, 0.95, distance(uv, foco));
        float brasa = pow(f, 2.6) * (0.35 + 0.9 * cerca) * u_fuerza;

        vec3 fondo = vec3(0.055, 0.059, 0.070);
        vec3 acento = vec3(0.93, 0.35, 0.18);
        vec3 frio = vec3(0.16, 0.19, 0.30);

        vec3 col = fondo;
        col += frio * brasa * 0.5;
        col += acento * pow(brasa, 1.7) * 0.85;

        // Viñeta en espacio de pantalla, no del ruido: medida sobre el plano
        // del ruido se comía la mitad de un móvil en vertical, porque ahí el
        // lado largo se sale del radio. Medida sobre uv se apaga la misma
        // proporción en apaisado y en vertical.
        col *= 1.0 - 0.55 * smoothstep(0.34, 0.8, length(uv - 0.5));

        // El titular manda: la banda central se apaga para que el blanco sobre
        // negro conserve el contraste, que es lo único que no se negocia.
        col *= 1.0 - 0.35 * smoothstep(0.55, 0.0, abs(uv.y - 0.5));

        // Ruido de un bit: sin esto los negros se escalonan en bandas.
        col += (hash(gl_FragCoord.xy + fract(u_t)) - 0.5) / 255.0;

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const compila = (tipo: number, fuente: string) => {
      const s = gl.createShader(tipo)!;
      gl.shaderSource(s, fuente);
      gl.compileShader(s);
      return s;
    };

    const programa = gl.createProgram()!;
    gl.attachShader(programa, compila(gl.VERTEX_SHADER, VERTICE));
    gl.attachShader(programa, compila(gl.FRAGMENT_SHADER, FRAGMENTO));
    gl.linkProgram(programa);

    if (!gl.getProgramParameter(programa, gl.LINK_STATUS)) {
      lienzo.remove();
    } else {
      gl.useProgram(programa);

      const buffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const pos = gl.getAttribLocation(programa, 'pos');
      gl.enableVertexAttribArray(pos);
      gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

      const uRes = gl.getUniformLocation(programa, 'u_res');
      const uT = gl.getUniformLocation(programa, 'u_t');
      const uRaton = gl.getUniformLocation(programa, 'u_raton');
      const uFuerza = gl.getUniformLocation(programa, 'u_fuerza');

      // Se pinta a media resolución y se estira por CSS: el humo es difuso, no
      // se nota, y el coste por píxel cae a la cuarta parte.
      const ESCALA = 0.5;
      const medir = () => {
        const w = Math.round(lienzo.clientWidth * ESCALA);
        const h = Math.round(lienzo.clientHeight * ESCALA);
        if (lienzo.width !== w || lienzo.height !== h) {
          lienzo.width = w;
          lienzo.height = h;
          gl.viewport(0, 0, w, h);
          gl.uniform2f(uRes, w, h);
          // El humo apenas baja en móvil: lo que lo agrandaba era normalizar por
          // la altura, y eso ya se corrige en el shader. A 0.5 no se veía nada.
          gl.uniform1f(uFuerza, lienzo.clientWidth < 820 ? 0.95 : 1.0);
        }
      };

      let objetivo = { x: 0.22, y: 0.55 };
      const raton = { x: 0.22, y: 0.55 };
      if (!quieto && matchMedia('(pointer: fine)').matches) {
        addEventListener(
          'pointermove',
          (e) => {
            objetivo = { x: e.clientX / innerWidth, y: 1 - e.clientY / innerHeight };
          },
          { passive: true }
        );
      }

      const pinta = (t: number) => {
        medir();
        raton.x += (objetivo.x - raton.x) * 0.04;
        raton.y += (objetivo.y - raton.y) * 0.04;
        gl.uniform2f(uRaton, raton.x, raton.y);
        gl.uniform1f(uT, t / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      let lazo = 0;
      const anima = (t: number) => {
        pinta(t);
        lazo = requestAnimationFrame(anima);
      };
      const arranca = () => {
        if (!lazo) lazo = requestAnimationFrame(anima);
      };
      const para = () => {
        cancelAnimationFrame(lazo);
        lazo = 0;
      };

      lienzo.classList.add('visible');

      if (quieto) {
        // Un solo fotograma: el fondo existe, pero no se mueve.
        requestAnimationFrame(pinta);
        addEventListener('resize', () => requestAnimationFrame(pinta), { passive: true });
      } else {
        // Solo se anima mientras la portada está en pantalla y la pestaña
        // delante: fuera de ahí no se gasta ni un fotograma.
        new IntersectionObserver(
          ([e]) => (e.isIntersecting && !document.hidden ? arranca() : para())
        ).observe(lienzo);
        document.addEventListener('visibilitychange', () => (document.hidden ? para() : arranca()));
      }
    }
  }
</script>
