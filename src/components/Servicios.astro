---
import { SERVICIOS } from '../config/servicios';
import type { Lang } from '../config/site';
const { lang } = Astro.props as { lang: Lang };
---
{lang === 'es' && (
  <section id="servicios" class="lejos border-t border-linea px-6 py-24 md:px-12 md:py-32">
    <div class="mx-auto max-w-6xl">
      <p data-revela class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-acento">
        Servicios
      </p>
      <h2
        data-revela
        class="mt-6 font-display text-[clamp(2rem,4.6vw,3.4rem)] font-extrabold leading-[1] tracking-[-0.04em] text-balance"
      >
        En qué te puedo ayudar.
      </h2>

      <div class="mt-14 grid border-t border-linea md:grid-cols-2">
        {SERVICIOS.map((s, n) => (
          <a
            data-revela
            href={`/${s.slug}/`}
            class="group flex flex-col gap-3 border-b border-linea p-7 transition-colors hover:bg-fondo-2
                   md:p-9"
            class:list={[n % 2 === 0 && 'md:border-r md:border-linea']}
          >
            <span class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-tenue">
              0{n + 1}
            </span>
            <span class="flex items-baseline gap-2 font-display text-2xl font-bold tracking-[-0.03em] md:text-3xl">
              {s.nombre}
              <span
                aria-hidden="true"
                class="text-acento transition-transform group-hover:translate-x-1"
              >→</span>
            </span>
            <span class="max-w-[42ch] text-pretty text-medio">{s.resumen}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
