---
import Layout from '../../layouts/Layout.astro';
import FormResena from '../../components/FormResena.astro';
import { contenido } from '../../config/site';
const f = contenido.ca.formulario;
const paginas = { es: '/resena/', en: '/en/review/', ca: '/ca/ressenya/' };
---
<Layout lang="ca" titulo={f.titulo} descripcion={f.descripcion} paginas={paginas}>
  <FormResena lang="ca" />
</Layout>
