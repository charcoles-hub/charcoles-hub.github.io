---
// Fase 1 del recorrido dirigido — evolución de /spike (ver spike.astro).
// Mismo mecanismo (CSS3DRenderer + iframes reales + WebGL detrás), pero con
// composición en curva, paradas encuadradas geométricamente y ritmo
// viaje/lectura gobernado por el scroll. Sin texto ni contenido todavía.
import { contenido } from '../config/site';

// Mismas 4 demos que la web real, en el orden del recorrido (no el orden de
// site.ts). El alto de cada una sale de site.ts — SSOT medida, no a ojo.
const RUTAS = [
  '/demo-barberia-navaja/',
  '/demo-dental-sereno/',
  '/demo-psicologia-ancla/',
  '/fisioymes/',
];
const ALTOS = RUTAS.map((ruta) => contenido.es.proyectos.find((p) => p.ruta === ruta)?.alto ?? 900);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>galería 3d — recorrido dirigido</title>
  <style is:global>
    /* is:global — las pantallas e iframes se crean con document.createElement
       en runtime, así que nunca llevan el data-astro-cid-* con el que Astro
       scopea estas reglas; con scope normal, .pantalla-rim e iframe.demo3d
       nunca llegaban a aplicarse (comprobado: borderWidth computado 0px). */
    html, body { margin: 0; background: #0a0b0d; overflow-x: hidden; }
    #css3d-container { position: fixed; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
    #webgl { position: fixed; inset: 0; z-index: 1; }
    #hud {
      position: fixed; top: 0; left: 0; z-index: 10; color: #0f0; background: rgba(0,0,0,.75);
      font: 12px/1.4 monospace; padding: 8px 10px; white-space: pre; pointer-events: none;
    }
    iframe.demo3d { border: 0; display: block; background: #fff; }
    /* Rim naranja de acento — lo que ata la galería a la identidad del sitio.
       GOTCHA: box-shadow no pinta su color a través del pipeline de
       transformación 3D de CSS3DRenderer (comprobado a pixel: sale gris, no
       naranja). border sí, por eso el rim es un border, no un box-shadow. */
    .pantalla-rim {
      box-sizing: content-box;
      border-radius: 6px;
      overflow: hidden;
      background: #0a0b0d;
      border: 4px solid rgba(255, 92, 55, .75);
    }
  </style>
</head>
<body>
  <div id="css3d-container"></div>
  <canvas id="webgl"></canvas>
  <div id="hud" style="display:none">cargando…</div>

  <script define:vars={{ RUTAS, ALTOS }}>
    window.__GALERIA_CONFIG = { RUTAS, ALTOS };
  </script>
  <script type="module">
    import * as THREE from 'three';
    import { CSS3DRenderer, CSS3DObject } from 'three/addons/renderers/CSS3DRenderer.js';

    const { RUTAS, ALTOS } = window.__GALERIA_CONFIG;

    const debug = new URLSearchParams(location.search).has('debug');
    const hud = document.getElementById('hud');
    if (debug) hud.style.display = 'block';

    // --- Constantes de dirección (nada de números mágicos sueltos) ---------
    const IFRAME_W = 1440, IFRAME_H = 900; // mismo viewport de diseño que las demos
    const SCALE = 0.45;                    // escala de las 4 pantallas en la escena
    const FOV = 50;                        // vertical, en grados — menos distorsión que los 70 del spike
    const FOV_RAD = FOV * Math.PI / 180;
    const LLENADO_PARADA = 0.75;           // fracción del alto de encuadre que ocupa la pantalla en su parada
    // D: distancia cámara↔pantalla para que la pantalla llene LLENADO_PARADA
    // del alto de encuadre. D = (alto_iframe*escala / llenado) / (2*tan(fov/2)).
    const D_PARADA = (IFRAME_H * SCALE / LLENADO_PARADA) / (2 * Math.tan(FOV_RAD / 2));

    const SPACING_Z = 1450; // separación entre paradas consecutivas en -Z
    // Composición en curva: alterna el lado en X, variación suave en Y,
    // rotación propia en Y por pantalla (oblicua al pasar de largo, frontal
    // solo en su parada).
    const CURVA = [
      { x: -420, y: 30, ry: 0.42 },
      { x: 480, y: -25, ry: -0.50 },
      { x: -380, y: 55, ry: 0.34 },
      { x: 440, y: -40, ry: -0.46 },
    ];
    const STOPS = RUTAS.map((ruta, i) => ({
      ruta,
      alto: ALTOS[i],
      x: CURVA[i].x,
      y: CURVA[i].y,
      z: -i * SPACING_Z,
      ry: CURVA[i].ry,
    }));

    const ESTABLISHING_MULT = 2.2;   // cuánto más lejos que la parada arranca la cámara (plano general de apertura)
    const ESTABLISHING_Y = 220;      // altura extra en el arranque

    const VH_VIAJE = 130;            // alto de página (vh) por segmento de viaje
    const VELOCIDAD_LECTURA = 3;     // mismo concepto que VELOCIDAD en site.ts: más alto = lectura más rápida
    const LERP_SCROLL = 0.12;        // suavizado del seguimiento de scroll por frame

    function normal(ry) {
      return { x: Math.sin(ry), z: Math.cos(ry) };
    }

    const paradas = STOPS.map((s) => {
      const n = normal(s.ry);
      return {
        camPos: new THREE.Vector3(s.x + n.x * D_PARADA, s.y, s.z + n.z * D_PARADA),
        target: new THREE.Vector3(s.x, s.y, s.z),
      };
    });

    const n0 = normal(STOPS[0].ry);
    const camStart = {
      camPos: new THREE.Vector3(
        STOPS[0].x + n0.x * D_PARADA * ESTABLISHING_MULT,
        STOPS[0].y + ESTABLISHING_Y,
        STOPS[0].z + n0.z * D_PARADA * ESTABLISHING_MULT
      ),
      target: paradas[0].target.clone(),
    };

    // --- Ritmo: alterna viaje (cámara se mueve) y lectura (cámara quieta,
    // se scrollea la demo por dentro) ----------------------------------------
    function vhLectura(alto) {
      return Math.max(50, ((alto - IFRAME_H) / IFRAME_H) * 100 / VELOCIDAD_LECTURA);
    }

    const segmentos = [];
    segmentos.push({ tipo: 'viaje', from: camStart, to: paradas[0], vh: VH_VIAJE });
    STOPS.forEach((s, i) => {
      segmentos.push({ tipo: 'lectura', stopIndex: i, vh: vhLectura(s.alto) });
      if (i < STOPS.length - 1) {
        segmentos.push({ tipo: 'viaje', from: paradas[i], to: paradas[i + 1], vh: VH_VIAJE });
      }
    });

    let limites = [];
    let totalPx = 0;
    function recalculaAlturas() {
      let acc = 0;
      limites = segmentos.map((seg) => {
        const alturaPx = (seg.vh / 100) * innerHeight;
        const item = { ...seg, start: acc, end: acc + alturaPx };
        acc += alturaPx;
        return item;
      });
      totalPx = acc;
      document.body.style.height = `${totalPx + innerHeight}px`;
    }

    function segmentoActivo(y) {
      for (let i = 0; i < limites.length; i++) {
        const seg = limites[i];
        if (y <= seg.end || i === limites.length - 1) {
          const t = seg.end > seg.start ? Math.min(1, Math.max(0, (y - seg.start) / (seg.end - seg.start))) : 1;
          return { seg, t };
        }
      }
    }

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    // --- Escena CSS3D (las 4 pantallas) -------------------------------------
    const sceneCSS = new THREE.Scene();
    const sceneGL = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(FOV, innerWidth / innerHeight, 1, 10000);
    const currentTarget = new THREE.Vector3();
    camera.position.copy(camStart.camPos);
    currentTarget.copy(camStart.target);
    camera.lookAt(currentTarget);

    const cssRenderer = new CSS3DRenderer();
    cssRenderer.setSize(innerWidth, innerHeight);
    document.getElementById('css3d-container').appendChild(cssRenderer.domElement);

    const canvas = document.getElementById('webgl');
    const glRenderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    glRenderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    glRenderer.setSize(innerWidth, innerHeight);

    function creaPantalla(stop, indice) {
      const wrap = document.createElement('div');
      wrap.className = 'pantalla-rim';
      wrap.style.width = `${IFRAME_W}px`;
      wrap.style.height = `${IFRAME_H}px`;

      const iframe = document.createElement('iframe');
      iframe.className = 'demo3d';
      iframe.style.width = `${IFRAME_W}px`;
      iframe.style.height = `${IFRAME_H}px`;
      // pointer-events:none — aprendizaje caro de PosterVivo: si no, el iframe
      // se come la rueda del ratón y el scroll de la PÁGINA (que mueve la
      // cámara) muere en cuanto el puntero pasa por encima.
      iframe.style.pointerEvents = 'none';
      iframe.title = `parada ${indice}`;
      iframe.addEventListener('load', () => {
        try {
          // Aprendizaje caro: sin esto, contentWindow.scrollTo() anima en vez
          // de saltar (las demos llevan scroll-behavior:smooth).
          iframe.contentDocument.documentElement.style.scrollBehavior = 'auto';
        } catch { /* cross-origin: no debería pasar, ruta same-origin */ }
        iframe.dataset.cargado = 'si';
      });
      iframe.src = stop.ruta;
      wrap.appendChild(iframe);

      const obj = new CSS3DObject(wrap);
      obj.position.set(stop.x, stop.y, stop.z);
      obj.rotation.y = stop.ry;
      obj.scale.set(SCALE, SCALE, SCALE);
      sceneCSS.add(obj);
      return iframe;
    }

    const iframes = STOPS.map(creaPantalla);

    // --- Capa WebGL: partículas muy sutiles al fondo. SIEMPRE detrás del
    // CSS3D — CSS3D y WebGL no comparten depth buffer, la mezcla es binaria
    // por z-index, no hay forma de intercalarlas (limitación conocida del spike).
    const N_PARTICULAS = 600;
    const Z_MAX = 800;
    const Z_MIN = STOPS[STOPS.length - 1].z - 800;
    const geo = new THREE.BufferGeometry();
    const pos = new Float32Array(N_PARTICULAS * 3);
    for (let i = 0; i < N_PARTICULAS; i++) {
      pos[i * 3] = (Math.random() - 0.5) * 2800;
      pos[i * 3 + 1] = (Math.random() - 0.5) * 1400;
      pos[i * 3 + 2] = Z_MIN + Math.random() * (Z_MAX - Z_MIN);
    }
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const mat = new THREE.PointsMaterial({
      color: 0x5f7f92, // frío, tenue — no el verde chillón del spike
      size: 3,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.35,
    });
    const puntos = new THREE.Points(geo, mat);
    sceneGL.add(puntos);

    addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      cssRenderer.setSize(innerWidth, innerHeight);
      glRenderer.setSize(innerWidth, innerHeight);
      recalculaAlturas();
      scrollTarget = Math.min(totalPx, scrollTarget);
    });

    // --- Scroll de la página → viaje/lectura, con lerp para quitar el nervio ---
    let scrollTarget = 0;
    let scrollSmooth = 0;
    addEventListener(
      'scroll',
      () => { scrollTarget = Math.min(totalPx, Math.max(0, scrollY)); },
      { passive: true }
    );

    recalculaAlturas();

    // --- FPS + bucle de render ---
    window.__fps = 0;
    let frames = 0;
    let ultimoMarcador = performance.now();

    function loop() {
      requestAnimationFrame(loop);
      const ahora = performance.now();
      frames++;
      if (ahora - ultimoMarcador >= 500) {
        window.__fps = Math.round((frames * 1000) / (ahora - ultimoMarcador));
        frames = 0;
        ultimoMarcador = ahora;
      }

      scrollSmooth += (scrollTarget - scrollSmooth) * LERP_SCROLL;
      const { seg, t } = segmentoActivo(scrollSmooth);

      if (seg.tipo === 'viaje') {
        const te = easeInOutCubic(t);
        camera.position.lerpVectors(seg.from.camPos, seg.to.camPos, te);
        currentTarget.lerpVectors(seg.from.target, seg.to.target, te);
        camera.lookAt(currentTarget);
      } else {
        const parada = paradas[seg.stopIndex];
        camera.position.copy(parada.camPos);
        currentTarget.copy(parada.target);
        camera.lookAt(currentTarget);

        const stop = STOPS[seg.stopIndex];
        const sobra = Math.max(0, stop.alto - IFRAME_H);
        try {
          iframes[seg.stopIndex].contentWindow.scrollTo(0, t * sobra);
        } catch { /* cross-origin: no debería pasar */ }
      }

      puntos.rotation.y += 0.0006; // muy sutil

      glRenderer.render(sceneGL, camera);
      cssRenderer.render(sceneCSS, camera);

      if (debug) {
        hud.textContent =
          `FPS: ${window.__fps}\n` +
          `segmento: ${seg.tipo}${seg.stopIndex !== undefined ? ' #' + seg.stopIndex : ''} t=${t.toFixed(2)}\n` +
          `scrollY: ${Math.round(scrollY)}  smooth: ${Math.round(scrollSmooth)} / ${Math.round(totalPx)}\n` +
          `cam: ${camera.position.x.toFixed(0)}, ${camera.position.y.toFixed(0)}, ${camera.position.z.toFixed(0)}\n` +
          `demos cargadas: ${iframes.map((f) => (f.dataset.cargado === 'si' ? '1' : '0')).join(',')}`;
      }
    }
    loop();

    // API para el script de verificación con puppeteer.
    window.__galeria = {
      limites: () => limites.map((l) => ({ tipo: l.tipo, stopIndex: l.stopIndex, start: l.start, end: l.end })),
      paradaMidY: (i) => {
        const seg = limites.find((l) => l.tipo === 'lectura' && l.stopIndex === i);
        return seg ? (seg.start + seg.end) / 2 : null;
      },
      totalPx: () => totalPx,
      getDemoScrollY: (i) => { try { return iframes[i].contentWindow.scrollY; } catch { return null; } },
      demosLoaded: () => iframes.every((f) => f.dataset.cargado === 'si'),
      fps: () => window.__fps,
      setScroll: (y) => scrollTo(0, y),
    };
  </script>
</body>
</html>
