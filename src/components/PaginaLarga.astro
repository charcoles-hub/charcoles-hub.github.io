---
import { contenido, TELEFONO } from '../config/site';
import type { Servicio } from '../config/servicios';

const { s } = Astro.props as { s: Servicio };
const { site } = contenido.es;
const whatsapp = `${TELEFONO.wa}?text=${encodeURIComponent(`Hola Sergio, me gustaría hablar contigo sobre ${s.nombre.toLowerCase()}.`)}`;
---

<div class="detail" id="arriba">
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="masthead wrap">
    <a class="identity" href="/" aria-label="Volver a la página principal de Sergio García"><span class="monogram" aria-hidden="true">sg<span>↗</span></span><span>Sergio García<span class="identity-sub">web design & development</span></span></a>
    <nav aria-label="Navegación principal"><a href="/#trabajo">Trabajos</a><a href="/#servicios">Servicios</a><a href="/#metodo">Cómo trabajo</a></nav>
    <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
  </header>

  <main id="contenido">
    <section class="hero wrap" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{s.nombre} · España</p>
        <h1 id="page-title">{s.h1}</h1>
        <p class="lead">{s.bajada}</p>
        <div class="actions"><a class="button button-dark" href={whatsapp}>Cuéntame tu proyecto <span aria-hidden="true">↗</span></a><a class="text-link" href="#incluye">Ver qué incluye <span aria-hidden="true">↓</span></a></div>
      </div>
      <aside class="hero-note" aria-label="Resumen del servicio"><div class="note-top"><span>ESTUDIO INDEPENDIENTE</span><span aria-hidden="true">01</span></div><p>{s.resumen}</p><div class="note-bottom"><span>Trato directo</span><span>Presupuesto por escrito</span></div></aside>
    </section>

    <div class="promise-bar"><div class="wrap promises"><span><i aria-hidden="true">✳</i>Diseño a medida</span><span><i aria-hidden="true">✳</i>Pensado para móvil</span><span><i aria-hidden="true">✳</i>Una persona de principio a fin</span><span><i aria-hidden="true">✳</i>Para toda España</span></div></div>

    <section class="section wrap overview" id="incluye" aria-labelledby="include-title">
      <div class="section-intro"><p class="eyebrow">El alcance</p><h2 id="include-title">{s.incluyeTitular}</h2><p>Definimos lo necesario antes de empezar. Si el proyecto necesita algo adicional, lo hablamos y queda reflejado en el presupuesto.</p></div>
      <ul class="included">{s.incluye.map((linea, index) => <li><span>0{index + 1}</span><p>{linea}</p></li>)}</ul>
    </section>

    <section class="facts-section"><div class="wrap facts" aria-label="Datos principales">{s.datos.map((d, index) => <article><span>0{index + 1}</span><strong>{d.cifra}</strong><p>{d.texto}</p></article>)}</div></section>

    <section class="section wrap process" aria-labelledby="process-title"><div><p class="eyebrow">Sin sorpresas</p><h2 id="process-title">Claro antes, durante y después.</h2></div><div class="process-copy"><p>Primero hablamos de lo que debe conseguir la web. Como cada negocio necesita algo distinto, preparo el alcance, el calendario y el presupuesto a medida. Lo recibes todo por escrito antes de decidir.</p><a class="text-link" href={whatsapp}>Pide una propuesta a medida <span aria-hidden="true">↗</span></a></div></section>

    <section class="section wrap faq" aria-labelledby="faq-title"><div><p class="eyebrow">Preguntas frecuentes</p><h2 id="faq-title">Las dudas habituales, respondidas.</h2></div><div class="questions">{s.faq.map((f) => <details><summary>{f.pregunta}<span aria-hidden="true">+</span></summary><p>{f.respuesta}</p></details>)}</div></section>

    <section class="contact" id="contacto" aria-labelledby="contact-title"><div class="wrap contact-grid"><div><p class="eyebrow">El siguiente paso</p><h2 id="contact-title">Hablemos de una web<br /><span>a tu altura.</span></h2></div><div class="contact-copy"><p>Cuéntame a qué te dedicas, qué necesitas y si ya tienes una web. Te responderé con una propuesta y un presupuesto por escrito, sin compromiso.</p><a class="button button-lime" href={whatsapp}>Hablemos por WhatsApp <span aria-hidden="true">↗</span></a><a class="contact-email" href={`mailto:${site.email}`}>Prefiero escribir un email <span aria-hidden="true">↗</span></a><p class="phone">O llámame al <a href={TELEFONO.tel}>{TELEFONO.humano}</a></p></div></div></section>
  </main>

  <footer class="footer wrap"><div><a href="/">Sergio García <span aria-hidden="true">↗</span></a><p>Diseño independiente. Trato directo. Toda España.</p></div><a class="text-link" href="#arriba">Volver arriba <span aria-hidden="true">↑</span></a></footer>
</div>

<style>
  .detail { --paper:#f7f7f0; --ink:#1c2c2b; --muted:#596361; --line:#d5dbcf; --lime:#d6f16b; background:var(--paper); color:var(--ink); font-family:'Manrope','Inter',ui-sans-serif,system-ui,sans-serif; font-size:16px; line-height:1.6; }
  .detail * { box-sizing:border-box; } .detail :global(a:focus-visible), .detail :global(summary:focus-visible) { outline:3px solid #698322; outline-offset:5px; border-radius:3px; } .detail :global(::selection) { background:var(--lime); color:var(--ink); } .detail :global([id]) { scroll-margin-top:28px; }
  .wrap { width:min(1280px,calc(100% - 96px)); margin-inline:auto; } .skip { position:absolute; top:-100px; left:20px; z-index:10; background:var(--ink); color:var(--paper); padding:14px 20px; } .skip:focus { top:12px; }
  .masthead { min-height:104px; display:flex; align-items:center; justify-content:space-between; gap:32px; border-bottom:1px solid var(--line); } .identity { display:flex; align-items:center; gap:13px; font-size:16px; line-height:1.3; font-weight:750; letter-spacing:-.035em; } .identity-sub { display:block; margin-top:4px; font-size:9px; font-weight:500; letter-spacing:.045em; } .monogram { position:relative; display:grid; place-items:center; width:44px; height:44px; border:1px solid var(--ink); border-radius:50%; padding-right:3px; font-size:29px; line-height:1; letter-spacing:-.095em; } .monogram span { position:absolute; top:-5px; right:-3px; background:var(--paper); font-size:15px; } .masthead nav { display:flex; gap:25px; font-size:12px; font-weight:650; } .masthead nav a:hover { opacity:.6; } .nav-contact { display:flex; align-items:center; gap:25px; padding:11px 16px; border:1px solid var(--ink); border-radius:6px; font-size:12px; font-weight:700; } .nav-contact:hover { background:var(--ink); color:var(--paper); }
  .hero { display:grid; grid-template-columns:1.08fr .92fr; gap:72px; align-items:center; padding-block:92px; } .eyebrow { display:flex; align-items:center; gap:10px; margin:0 0 24px; font-size:11px; font-weight:750; letter-spacing:.12em; text-transform:uppercase; } .status-dot { display:inline-block; width:7px; height:7px; border-radius:50%; background:#658233; } h1,h2,p { margin:0; } h1 { max-width:780px; font-size:clamp(52px,6.2vw,88px); font-weight:650; letter-spacing:-.07em; line-height:.99; text-wrap:balance; } h2 { max-width:720px; font-size:clamp(36px,4.1vw,58px); font-weight:650; letter-spacing:-.055em; line-height:1.08; text-wrap:balance; } .lead { max-width:570px; margin-top:30px; color:var(--muted); font-size:16px; line-height:1.75; } .actions { display:flex; align-items:center; gap:24px; margin-top:34px; } .button { display:inline-flex; align-items:center; justify-content:space-between; gap:24px; min-height:52px; padding:16px 21px; border-radius:6px; font-size:12px; font-weight:750; transition:transform .2s,background .2s; } .button:hover { transform:translateY(-3px); } .button span { font-size:21px; font-weight:400; line-height:1; } .button-dark { background:var(--ink); color:var(--paper); } .button-dark:hover { background:#33433d; } .button-lime { background:var(--lime); color:var(--ink); } .button-lime:hover { background:#e3ff89; } .text-link { display:inline-flex; align-items:center; gap:18px; padding-block:12px; font-size:12px; font-weight:700; } .text-link:hover { text-decoration:underline; text-underline-offset:5px; } .text-link span { font-size:19px; font-weight:400; }
  .hero-note { display:flex; flex-direction:column; justify-content:space-between; min-height:350px; padding:27px; border-radius:8px; background:#dce2d4; } .note-top,.note-bottom { display:flex; justify-content:space-between; gap:16px; font-size:9px; font-weight:750; letter-spacing:.1em; } .note-bottom { padding-top:19px; border-top:1px solid #b1bbae; color:#536047; font-size:10px; letter-spacing:0; } .hero-note > p { max-width:365px; font-size:clamp(29px,3vw,43px); font-weight:650; letter-spacing:-.045em; line-height:1.1; }
  .promise-bar { background:var(--ink); color:var(--paper); } .promises { display:flex; justify-content:space-between; gap:20px; padding-block:23px; font-size:11px; } .promises span { display:flex; align-items:center; gap:13px; } .promises i { color:var(--lime); font-size:19px; font-style:normal; }
  .section { padding-block:112px; } .overview { display:grid; grid-template-columns:.78fr 1.22fr; gap:92px; } .section-intro > p:last-child { max-width:390px; margin-top:26px; color:var(--muted); font-size:14px; line-height:1.8; } .included { margin:0; padding:0; border-top:1px solid var(--line); list-style:none; } .included li { display:grid; grid-template-columns:48px 1fr; gap:20px; padding:22px 0; border-bottom:1px solid var(--line); } .included li > span,.facts article > span { padding-top:3px; color:#718064; font-size:10px; font-weight:750; } .included p { font-size:16px; line-height:1.65; }
  .facts-section { background:#e6e9de; } .facts { display:grid; grid-template-columns:repeat(3,1fr); } .facts article { min-height:255px; padding:40px 35px; border-right:1px solid #c4cbbd; } .facts article:first-child { border-left:1px solid #c4cbbd; } .facts strong { display:block; margin-top:32px; font-size:clamp(40px,4vw,64px); font-weight:650; letter-spacing:-.065em; line-height:1; } .facts p { max-width:250px; margin-top:17px; color:var(--muted); font-size:13px; line-height:1.7; }
  .process { display:grid; grid-template-columns:1fr 1fr; gap:92px; align-items:start; border-bottom:1px solid var(--line); } .process-copy { max-width:470px; color:var(--muted); font-size:15px; line-height:1.85; } .process-copy .text-link { margin-top:20px; color:var(--ink); }
  .faq { display:grid; grid-template-columns:.8fr 1.2fr; gap:92px; } .questions { border-top:1px solid var(--line); } .questions details { border-bottom:1px solid var(--line); padding:21px 0; } .questions summary { display:flex; align-items:center; justify-content:space-between; gap:20px; cursor:pointer; font-size:16px; font-weight:700; list-style:none; } .questions summary::-webkit-details-marker { display:none; } .questions summary span { color:#6a8038; font-size:24px; font-weight:400; transition:transform .2s; } .questions details[open] summary span { transform:rotate(45deg); } .questions details p { max-width:640px; margin:14px 42px 0 0; color:var(--muted); font-size:14px; line-height:1.8; }
  .contact { padding-block:105px; background:var(--ink); color:var(--paper); } .contact .eyebrow { color:var(--lime); } .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:92px; } .contact h2 span { color:var(--lime); } .contact-copy { max-width:450px; color:#c4ccc4; font-size:15px; line-height:1.8; } .contact-copy .button { margin-top:28px; } .contact-email { display:block; width:max-content; margin-top:19px; padding-bottom:5px; border-bottom:1px solid #718074; color:var(--paper); font-size:12px; font-weight:700; } .contact-email:hover { color:var(--lime); } .phone { margin-top:24px; font-size:12px; } .phone a { color:var(--paper); font-weight:750; }
  .footer { display:flex; align-items:flex-start; justify-content:space-between; gap:40px; padding-block:42px; } .footer div > a { font-size:16px; font-weight:750; letter-spacing:-.035em; } .footer div > a span { font-size:19px; } .footer p { margin-top:6px; color:var(--muted); font-size:11px; }
  @media (max-width:800px) { .wrap { width:min(100% - 40px,1280px); } .masthead { min-height:82px; gap:14px; } .masthead nav { display:none; } .nav-contact { gap:10px; padding:9px 11px; } .identity { font-size:14px; } .monogram { width:38px; height:38px; font-size:25px; } .hero { grid-template-columns:1fr; gap:38px; padding-block:58px; } .hero-note { min-height:250px; } .promises { display:grid; grid-template-columns:1fr 1fr; gap:12px; padding-block:18px; font-size:10px; } .section { padding-block:75px; } .overview,.process,.faq,.contact-grid { grid-template-columns:1fr; gap:42px; } .facts { grid-template-columns:1fr; } .facts article,.facts article:first-child { min-height:auto; padding:28px 0; border:0; border-bottom:1px solid #c4cbbd; } .facts strong { margin-top:14px; } .actions { flex-wrap:wrap; } .footer { flex-direction:column; gap:12px; } }
  @media (max-width:420px) { .identity-sub { display:none; } h1 { font-size:48px; } .lead { font-size:15px; } .button { width:100%; } .actions .text-link { margin-inline:auto; } .hero-note > p { font-size:28px; } .promises { grid-template-columns:1fr; } }
</style>

