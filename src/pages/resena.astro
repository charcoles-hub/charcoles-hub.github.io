---
import Layout from '../layouts/Layout.astro';
import FormResena from '../components/FormResena.astro';
import { contenido } from '../config/site';
const f = contenido.es.formulario;
const paginas = { es: '/resena/', en: '/en/review/' };
---
<Layout lang="es" titulo={f.titulo} descripcion={f.descripcion} paginas={paginas}>
  <FormResena lang="es" />
</Layout>
