---
import { contenido, rutas, RESENA_FORM, RESENAS, type Lang } from '../config/site';

const { lang } = Astro.props as { lang: Lang };
const f = contenido[lang].formulario;
const siguiente = new URL(RESENA_FORM.gracias[lang], Astro.site).href;
const estrellas = [5, 4, 3, 2, 1];
const locale = lang === 'en' ? 'en-US' : lang === 'ca' ? 'ca-ES' : 'es-ES';
const fecha = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' });

const textos = {
  es: {
    back: 'Volver al portfolio',
    control: 'Tú decides',
    controlTitle: 'Solo se publica con tu permiso.',
    controlText: 'La reseña llega primero a mi correo. Compruebo que todo esté correcto y únicamente entonces aparece en la web.',
    after: 'Después de enviar',
    afterTitle: 'Nada aparece sin revisar.',
    steps: [
      ['01', 'La recibo', 'Me llega por correo con los datos que has decidido compartir.'],
      ['02', 'La compruebo', 'Reviso el permiso, el enlace y que no haya ningún error evidente.'],
      ['03', 'La publico', 'Aparece aquí y en el portfolio. Si algún día quieres retirarla, basta con pedirlo.'],
    ],
    published: 'Reseñas publicadas',
    publishedTitle: 'Aquí aparecen las voces reales.',
    publishedIntro: 'Esta página y la portada comparten la misma lista de reseñas aprobadas. No hay ejemplos inventados ni publicaciones automáticas sin control.',
    empty: 'Todavía no hay ninguna publicada. La primera reseña aprobada aparecerá en este espacio y también en la portada.',
  },
  en: {
    back: 'Back to the portfolio',
    control: 'You decide',
    controlTitle: 'It is only published with your permission.',
    controlText: 'The review reaches my inbox first. I check that everything is correct, and only then can it appear on the website.',
    after: 'After you send it',
    afterTitle: 'Nothing goes live without a check.',
    steps: [
      ['01', 'I receive it', 'It reaches me by email with the details you chose to share.'],
      ['02', 'I check it', 'I confirm the permission, the link and that there is no obvious mistake.'],
      ['03', 'I publish it', 'It appears here and on the portfolio. If you ever want it removed, just ask.'],
    ],
    published: 'Published reviews',
    publishedTitle: 'Real voices appear here.',
    publishedIntro: 'This page and the homepage share the same list of approved reviews. There are no invented examples or unmoderated automatic posts.',
    empty: 'There are no published reviews yet. The first approved review will appear here and on the homepage.',
  },
  ca: {
    back: 'Tornar al portfoli',
    control: 'Tu decideixes',
    controlTitle: 'Només es publica amb el teu permís.',
    controlText: 'La ressenya arriba primer al meu correu. Comprovo que tot estigui correcte i només llavors pot aparèixer al web.',
    after: 'Després d’enviar-la',
    afterTitle: 'No apareix res sense revisar.',
    steps: [
      ['01', 'La rebo', 'M’arriba per correu amb les dades que has decidit compartir.'],
      ['02', 'La comprovo', 'Reviso el permís, l’enllaç i que no hi hagi cap error evident.'],
      ['03', 'La publico', 'Apareix aquí i al portfoli. Si algun dia vols retirar-la, només cal demanar-ho.'],
    ],
    published: 'Ressenyes publicades',
    publishedTitle: 'Aquí apareixen les veus reals.',
    publishedIntro: 'Aquesta pàgina i la portada comparteixen la mateixa llista de ressenyes aprovades. No hi ha exemples inventats ni publicacions automàtiques sense control.',
    empty: 'Encara no n’hi ha cap de publicada. La primera ressenya aprovada apareixerà aquí i també a la portada.',
  },
} as const;

const t = textos[lang];
---

<div class="review-page" id="arriba">
  <header class="masthead wrap">
    <a class="identity" href={rutas[lang]} aria-label="Sergio García">
      <span class="monogram" aria-hidden="true">sg<span>↗</span></span>
      <span>Sergio García<span class="identity-sub">web design & development</span></span>
    </a>
    <a class="back" href={rutas[lang]}>← {t.back}</a>
  </header>

  <main>
    <section class="hero wrap" aria-labelledby="review-title">
      <div>
        <p class="eyebrow">{f.eyebrow}</p>
        <h1 id="review-title">{f.titular}</h1>
        <p class="intro">{f.texto}</p>
      </div>
      <aside class="control-card">
        <p>{t.control}</p>
        <strong>{t.controlTitle}</strong>
        <span>{t.controlText}</span>
      </aside>
    </section>

    <section class="form-section">
      <div class="wrap form-layout">
        <form action={RESENA_FORM.destino} method="POST" class="review-form">
          <input type="hidden" name="access_key" value={RESENA_FORM.clave} />
          <input type="hidden" name="subject" value="Nueva reseña desde el portfolio" />
          <input type="hidden" name="from_name" value="Portfolio · Reseñas" />
          <input type="hidden" name="redirect" value={siguiente} />
          <input type="hidden" name="Idioma" value={lang} />
          <p class="honeypot" aria-hidden="true">
            <label>No rellenar<input type="checkbox" name="botcheck" tabindex="-1" /></label>
          </p>

          <fieldset class="rating">
            <legend class="label">{f.puntuacion}</legend>
            <div class="stars">
              {estrellas.map((n) => (
                <>
                  <input type="radio" id={`estrella-${n}`} name="Puntuacion" value={`${n}/5`} checked={n === 5} required />
                  <label for={`estrella-${n}`} title={`${n}/5`}>
                    <span class="sr-only">{`${n}/5`}</span><span aria-hidden="true">★</span>
                  </label>
                </>
              ))}
            </div>
            <span class="hint">{f.puntuacionPista}</span>
          </fieldset>

          <p class="field field-wide">
            <label class="label" for="resena">{f.resena}</label>
            <textarea id="resena" name="Resena" rows="6" maxlength="700" required></textarea>
            <span class="hint">{f.resenaPista}</span>
          </p>

          <div class="field-grid">
            <p class="field">
              <label class="label" for="nombre">{f.nombre}</label>
              <input id="nombre" name="Nombre" type="text" autocomplete="name" maxlength="80" required />
              <span class="hint">{f.nombrePista}</span>
            </p>
            <p class="field">
              <label class="label" for="negocio">{f.negocio}</label>
              <input id="negocio" name="Negocio" type="text" maxlength="120" required />
              <span class="hint">{f.negocioPista}</span>
            </p>
            <p class="field">
              <label class="label" for="enlace">{f.enlace}</label>
              <input id="enlace" name="Enlace" type="url" inputmode="url" placeholder="https://" maxlength="200" />
              <span class="hint">{f.enlacePista}</span>
            </p>
            <p class="field">
              <label class="label" for="email">{f.email}</label>
              <input id="email" name="email" type="email" autocomplete="email" maxlength="120" />
              <span class="hint">{f.emailPista}</span>
            </p>
          </div>

          <label class="permission">
            <input type="checkbox" name="Permiso" value="Si, autoriza a publicarla" required />
            <span>{f.permiso}</span>
          </label>

          <div class="submit-row">
            <p>{f.legal}</p>
            <button type="submit">{f.enviar}<span aria-hidden="true">↗</span></button>
          </div>
        </form>

        <aside class="after-card">
          <p class="eyebrow">{t.after}</p>
          <h2>{t.afterTitle}</h2>
          <ol>
            {t.steps.map(([number, title, text]) => (
              <li><span>{number}</span><div><strong>{title}</strong><p>{text}</p></div></li>
            ))}
          </ol>
        </aside>
      </div>
    </section>

    <section class="published wrap" aria-labelledby="published-title">
      <div class="section-head">
        <div><p class="eyebrow">{t.published}</p><h2 id="published-title">{t.publishedTitle}</h2></div>
        <p>{t.publishedIntro}</p>
      </div>
      {RESENAS.length ? (
        <ul class="review-grid" role="list">
          {RESENAS.map((review) => {
            const text = lang === 'en' && review.textoEn ? review.textoEn : review.texto;
            return (
              <li>
                <p class="review-stars" aria-label={contenido[lang].resenas.deCinco(review.estrellas)}>{'★'.repeat(review.estrellas)}<span aria-hidden="true">{'★'.repeat(5 - review.estrellas)}</span></p>
                <blockquote>“{text}”</blockquote>
                <footer><strong>{review.autor}</strong><span>{review.cargo} · {fecha.format(new Date(review.fecha))}</span></footer>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="empty-reviews"><span aria-hidden="true">★★★★★</span><p>{t.empty}</p></div>
      )}
    </section>
  </main>

  <footer class="footer wrap"><span>© {new Date().getFullYear()} Sergio García Ortiz</span><a href={rutas[lang]}>{t.back} <span aria-hidden="true">↗</span></a></footer>
</div>

<style>
  .review-page { --paper:#f7f7f0; --ink:#1c2c2b; --muted:#596361; --line:#d5dbcf; --lime:#d6f16b; min-height:100vh; background:var(--paper); color:var(--ink); font-family:'Manrope','Inter',ui-sans-serif,system-ui,sans-serif; font-size:16px; line-height:1.6; }
  .review-page * { box-sizing:border-box; }
  .review-page :global(a:focus-visible), .review-page :global(input:focus-visible), .review-page :global(textarea:focus-visible), .review-page :global(button:focus-visible) { outline:3px solid #698322; outline-offset:4px; }
  .wrap { width:min(1180px,calc(100% - 96px)); margin-inline:auto; }
  .masthead { min-height:104px; display:flex; align-items:center; justify-content:space-between; gap:28px; border-bottom:1px solid var(--line); }
  .identity { display:flex; align-items:center; gap:13px; font-weight:750; letter-spacing:-.035em; line-height:1.3; }
  .identity-sub { display:block; margin-top:4px; font-size:9px; font-weight:500; letter-spacing:.045em; }
  .monogram { position:relative; display:grid; place-items:center; width:44px; height:44px; padding-right:3px; border:1px solid var(--ink); border-radius:50%; font-size:29px; line-height:1; letter-spacing:-.095em; }
  .monogram span { position:absolute; top:-5px; right:-3px; background:var(--paper); font-size:15px; }
  .back { font-size:11px; font-weight:700; }
  .back:hover { text-decoration:underline; text-underline-offset:5px; }
  .hero { display:grid; grid-template-columns:1.15fr .85fr; gap:92px; align-items:center; padding-block:88px; }
  .eyebrow { margin:0 0 21px; font-size:10px; font-weight:750; letter-spacing:.13em; text-transform:uppercase; }
  h1,h2,p { margin:0; }
  h1 { max-width:720px; font-size:clamp(52px,6vw,82px); font-weight:650; letter-spacing:-.07em; line-height:.98; text-wrap:balance; }
  h2 { font-size:clamp(31px,3vw,45px); font-weight:650; letter-spacing:-.055em; line-height:1.08; text-wrap:balance; }
  .intro { max-width:620px; margin-top:28px; color:var(--muted); font-size:16px; line-height:1.8; }
  .control-card { min-height:270px; display:flex; flex-direction:column; justify-content:space-between; padding:30px; border-radius:8px; background:var(--ink); color:var(--paper); }
  .control-card > p { color:var(--lime); font-size:10px; font-weight:750; letter-spacing:.12em; text-transform:uppercase; }
  .control-card strong { max-width:330px; font-size:30px; font-weight:650; letter-spacing:-.045em; line-height:1.12; }
  .control-card span { max-width:390px; color:#c4cec8; font-size:12px; line-height:1.75; }
  .form-section { padding-block:96px; background:#e9ece2; }
  .form-layout { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr); gap:72px; align-items:start; }
  .review-form { display:flex; flex-direction:column; gap:30px; padding:40px; border:1px solid #cbd2c5; border-radius:8px; background:var(--paper); }
  .honeypot { position:absolute; left:-9999px; }
  .review-form fieldset { min-width:0; margin:0; padding:0; border:0; }
  .label { display:block; margin-bottom:10px; color:var(--ink); font-size:10px; font-weight:750; letter-spacing:.11em; text-transform:uppercase; }
  .hint { display:block; margin-top:8px; color:#737d79; font-size:11px; line-height:1.5; }
  .stars { display:flex; flex-direction:row-reverse; justify-content:flex-end; width:max-content; }
  .stars input { position:absolute; inline-size:1px; block-size:1px; overflow:hidden; opacity:0; }
  .stars label { cursor:pointer; color:#bec7ba; font-size:30px; line-height:1; transition:color .15s,transform .15s; }
  .stars label:hover { transform:translateY(-2px); }
  .stars label:hover, .stars label:hover ~ label, .stars input:checked ~ label { color:#6c843b; }
  .field-grid { display:grid; grid-template-columns:1fr 1fr; gap:26px; }
  .field { min-width:0; }
  .field input,.field textarea,.field-wide textarea { width:100%; border:1px solid #c7cec2; border-radius:5px; background:#fff; color:var(--ink); font:inherit; }
  .field input { min-height:52px; padding:12px 14px; }
  .field-wide textarea { min-height:180px; padding:14px; resize:vertical; }
  .permission { display:flex; align-items:flex-start; gap:13px; padding:20px 0; border-block:1px solid var(--line); color:var(--muted); font-size:12px; line-height:1.6; }
  .permission input { width:18px; height:18px; margin-top:1px; accent-color:#607b31; flex:0 0 auto; }
  .submit-row { display:flex; align-items:center; justify-content:space-between; gap:28px; }
  .submit-row p { max-width:430px; color:var(--muted); font-size:11px; line-height:1.65; }
  .submit-row button { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-width:210px; min-height:54px; padding:15px 19px; border:0; border-radius:6px; background:var(--ink); color:var(--paper); cursor:pointer; font:inherit; font-size:12px; font-weight:750; }
  .submit-row button:hover { background:#33433d; }
  .submit-row button span { font-size:20px; font-weight:400; }
  .after-card { position:sticky; top:28px; }
  .after-card h2 { max-width:350px; }
  .after-card ol { margin:34px 0 0; padding:0; list-style:none; border-top:1px solid #c5cdbf; }
  .after-card li { display:grid; grid-template-columns:36px 1fr; gap:14px; padding:24px 0; border-bottom:1px solid #c5cdbf; }
  .after-card li > span { padding-top:3px; color:#718064; font-size:9px; font-weight:750; }
  .after-card strong { display:block; font-size:15px; }
  .after-card li p { margin-top:7px; color:var(--muted); font-size:11px; line-height:1.7; }
  .published { padding-block:100px; }
  .section-head { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:end; margin-bottom:45px; }
  .section-head > p { max-width:500px; color:var(--muted); font-size:13px; line-height:1.8; }
  .empty-reviews { display:grid; grid-template-columns:.55fr 1fr; gap:42px; align-items:center; max-width:820px; padding:38px 0; border-block:1px solid var(--line); }
  .empty-reviews span,.review-stars { color:#71893e; font-size:25px; letter-spacing:.13em; }
  .empty-reviews p { color:var(--muted); font-size:13px; line-height:1.8; }
  .review-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin:0; padding:0; list-style:none; }
  .review-grid li { display:flex; min-height:250px; flex-direction:column; padding:27px; border:1px solid var(--line); border-radius:7px; }
  .review-stars { margin:0; font-size:18px; }
  .review-stars span { color:#c2cbb9; }
  .review-grid blockquote { margin:20px 0; font-size:16px; line-height:1.6; }
  .review-grid footer { display:flex; flex-direction:column; margin-top:auto; padding-top:15px; border-top:1px solid var(--line); }
  .review-grid footer strong { font-size:12px; }
  .review-grid footer span { color:var(--muted); font-size:10px; }
  .footer { display:flex; justify-content:space-between; gap:24px; padding-block:30px; border-top:1px solid var(--line); color:var(--muted); font-size:10px; }
  .footer a { color:var(--ink); font-weight:700; }
  @media (max-width:850px) { .wrap { width:min(100% - 48px,1180px); } .hero,.form-layout,.section-head { grid-template-columns:1fr; gap:42px; } .hero { padding-block:62px; } .control-card { min-height:240px; } .after-card { position:static; } .review-grid { grid-template-columns:1fr 1fr; } }
  @media (max-width:560px) { .wrap { width:calc(100% - 40px); } .masthead { min-height:82px; } .identity-sub { display:none; } .monogram { width:38px; height:38px; font-size:25px; } .back { max-width:130px; text-align:right; line-height:1.4; } .hero { padding-block:48px; } h1 { font-size:48px; } .intro { font-size:14px; } .control-card { min-height:220px; padding:25px; } .control-card strong { font-size:27px; } .form-section { padding-block:56px; } .form-layout { gap:55px; } .review-form { padding:25px 20px; } .field-grid,.review-grid,.empty-reviews { grid-template-columns:1fr; } .submit-row { align-items:stretch; flex-direction:column; } .submit-row button { width:100%; } .published { padding-block:70px; } .section-head { gap:24px; margin-bottom:34px; } .empty-reviews { gap:18px; } .footer { flex-direction:column; } }
</style>
